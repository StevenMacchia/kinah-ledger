<Window x:Class="KinahLedger.Ui.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kinah Ledger Options" Width="860" Height="640" MinWidth="760" MinHeight="520" ResizeMode="CanResize"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Ink}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

  <Grid Background="{DynamicResource Bg}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="220"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- side navigation -->
    <Border Grid.RowSpan="2" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
      <DockPanel Margin="12,18,12,14">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,18">
          <Image Source="{StaticResource AppMark}" Width="28" Height="28" Margin="0,0,10,0" VerticalAlignment="Center"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Options" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Text="Kinah Ledger" Foreground="{DynamicResource Faint}" FontSize="11.5"/>
          </StackPanel>
        </StackPanel>
        <TextBlock x:Name="NavVersion" DockPanel.Dock="Bottom" Foreground="{DynamicResource Faint}" FontSize="11.5" Margin="8,0,0,0"/>
        <StackPanel x:Name="Nav"/>
      </DockPanel>
    </Border>

    <!-- pages -->
    <ScrollViewer x:Name="Scroller" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid Margin="32,24,32,28">

        <!-- General: startup, the window, the look -->
        <StackPanel x:Name="PageGeneral">
          <TextBlock Style="{StaticResource PageTitle}" Text="General"/>
          <TextBlock Style="{StaticResource PageLead}" Text="How Kinah Ledger starts, and what it does when Aion 2 starts and closes."/>

          <TextBlock Style="{StaticResource GroupLabel}" Text="STARTUP"/>
          <Border Style="{StaticResource Group}">
            <StackPanel>
              <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Style="{StaticResource RowTitle}" Text="Start with Windows"/>
                  <TextBlock x:Name="StartupHint" Style="{StaticResource RowHint}" Text="Waits in the tray by the clock, using next to nothing, until Aion 2 is running."/>
                </StackPanel>
                <CheckBox x:Name="StartupChk" Grid.Column="1" Style="{StaticResource Switch}"/>
              </Grid>
              <Border Style="{StaticResource Divider}"/>
              <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Style="{StaticResource RowTitle}" Text="When Aion 2 starts"/>
                  <TextBlock Style="{StaticResource RowHint}" Text="While Kinah Ledger waits in the tray. Reading the chat starts on its own either way."/>
                </StackPanel>
                <ComboBox x:Name="GameStartBox" Grid.Column="1" Width="200" VerticalAlignment="Center"/>
              </Grid>
              <Border Style="{StaticResource Divider}"/>
              <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Style="{StaticResource RowTitle}" Text="Hide when Aion 2 closes"/>
                  <TextBlock Style="{StaticResource RowHint}" Text="Back to the tray ten seconds after the game closes. Never during a farming run."/>
                </StackPanel>
                <CheckBox x:Name="HideOnCloseChk" Grid.Column="1" Style="{StaticResource Switch}"/>
              </Grid>
            </StackPanel>
          </Border>
          <TextBlock x:Name="StartupTip" Style="{StaticResource BodyStyle}" FontSize="12" Foreground="{DynamicResource Warn}" Margin="2,8,0,0" Visibility="Collapsed"
                     Text="Tip: also turn on “Close button keeps it running” below, or closing the window stops it waiting for the game."/>

          <TextBlock Style="{StaticResource GroupLabel}" Text="WINDOW"/>
          <Border Style="{StaticResource Group}">
            <StackPanel>
              <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Style="{StaticResource RowTitle}" Text="Close button keeps it running"/>
                  <TextBlock Style="{StaticResource RowHint}" Text="Closing the window sends Kinah Ledger to the tray, so it can open with the game. Quit from the tray icon's menu."/>
                </StackPanel>
                <CheckBox x:Name="CloseToTrayChk" Grid.Column="1" Style="{StaticResource Switch}"/>
              </Grid>
              <Border Style="{StaticResource Divider}"/>
              <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Style="{StaticResource RowTitle}" Text="Minimize to the tray"/>
                  <TextBlock Style="{StaticResource RowHint}" Text="Minimizing hides the window by the clock instead of the taskbar. During a run it always does."/>
                </StackPanel>
                <CheckBox x:Name="MinToTrayChk" Grid.Column="1" Style="{StaticResource Switch}"/>
              </Grid>
            </StackPanel>
          </Border>

          <TextBlock Style="{StaticResource GroupLabel}" Text="LOOK"/>
          <Border Style="{StaticResource Group}">
            <Grid Style="{StaticResource Row}">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Style="{StaticResource RowTitle}" Text="Theme"/>
                <TextBlock x:Name="SkinHint" Style="{StaticResource RowHint}"/>
              </StackPanel>
              <WrapPanel x:Name="SkinHost" Grid.Column="1" VerticalAlignment="Center" Margin="0,8,-8,-8"/>
            </Grid>
          </Border>
        </StackPanel>

        <!-- Server -->
        <StackPanel x:Name="PageServer" Visibility="Collapsed">
          <TextBlock Style="{StaticResource PageTitle}" Text="Server"/>
          <TextBlock Style="{StaticResource PageLead}" Text="Everything shared is filed under your server: Market prices now, drops and rates on the site."/>
          <TextBlock Style="{StaticResource GroupLabel}" Text="YOUR SERVER"/>
          <Border Style="{StaticResource Group}">
            <StackPanel>
              <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Style="{StaticResource RowTitle}" Text="Region"/>
                  <TextBlock Style="{StaticResource RowHint}" Text="The same server names exist in every region, so both parts matter."/>
                </StackPanel>
                <ComboBox x:Name="RegionPick" Grid.Column="1" Width="220" VerticalAlignment="Center"/>
              </Grid>
              <Border Style="{StaticResource Divider}"/>
              <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Style="{StaticResource RowTitle}" Text="Server and faction"/>
                  <TextBlock Style="{StaticResource RowHint}" Text="Your home server, as the game's server list shows it."/>
                </StackPanel>
                <ComboBox x:Name="ServerPick" Grid.Column="1" Width="220" VerticalAlignment="Center"/>
              </Grid>
              <Border Style="{StaticResource Divider}"/>
              <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Style="{StaticResource RowTitle}" Text="Gear score"/>
                  <TextBlock Style="{StaticResource RowHint}" Text="So the run card compares you with players at your gear. Empty: every player."/>
                </StackPanel>
                <TextBox x:Name="GearBox" Grid.Column="1" Width="220" VerticalAlignment="Center" MaxLength="5" AutomationProperties.Name="Gear score"/>
              </Grid>
            </StackPanel>
          </Border>
          <TextBlock x:Name="ServerWarn" Style="{StaticResource BodyStyle}" FontSize="12" Foreground="{DynamicResource Warn}" Margin="2,8,0,0" Visibility="Collapsed"
                     Text="Pick a server: runs and prices aren't shared without one, and Start farming waits for it."/>
          <TextBlock Style="{StaticResource GroupLabel}" Text="PRICE ALERTS"/>
          <Border Style="{StaticResource Group}">
            <StackPanel x:Name="AlertsHost" Margin="0,4,0,4"/>
          </Border>
        </StackPanel>

        <!-- Sharing and profile -->
        <StackPanel x:Name="PageSharing" Visibility="Collapsed">
          <TextBlock Style="{StaticResource PageTitle}" Text="Sharing"/>
          <TextBlock Style="{StaticResource PageLead}" Text="What leaves this PC, your profile on the site, and the data kept here."/>

          <TextBlock Style="{StaticResource GroupLabel}" Text="SHARING"/>
          <Border Style="{StaticResource Group}">
            <StackPanel>
              <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Style="{StaticResource RowTitle}" Text="Share runs and Market prices anonymously"/>
                  <TextBlock Style="{StaticResource RowHint}" Text="Totals of finished runs and the Market listings on your screen, for the site's public tables. Never your character, chat text or screenshots."/>
                  <TextBlock FontSize="12.5" Margin="0,6,0,0"><Hyperlink x:Name="WhatsSentLink" Style="{StaticResource LinkStyle}">What's sent</Hyperlink><Run Text="   "/><Hyperlink x:Name="WhatsReadLink" Style="{StaticResource LinkStyle}">What's read from the Market</Hyperlink></TextBlock>
                </StackPanel>
                <CheckBox x:Name="ShareChk" Grid.Column="1" Style="{StaticResource Switch}"/>
              </Grid>
              <Border Style="{StaticResource Divider}"/>
              <!-- Help improve counting (Session/LabelWriter.cs): on by default, the same sentence as the first-run notice -->
              <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Style="{StaticResource RowTitle}" Text="Help improve counting"/>
                  <TextBlock Style="{StaticResource RowHint}" Text="Sends what it read and small pictures of item names and icons, never your chat or names. Off here any time."/>
                </StackPanel>
                <CheckBox x:Name="HelpCountingChk" Grid.Column="1" Style="{StaticResource Switch}" AutomationProperties.Name="Help improve counting"/>
              </Grid>
            </StackPanel>
          </Border>

          <TextBlock Style="{StaticResource GroupLabel}" Text="YOUR PROFILE ON KINAHLEDGER.COM"/>
          <Border Style="{StaticResource Group}">
            <StackPanel>
              <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Style="{StaticResource RowTitle}" Text="Link this PC to your profile"/>
                  <TextBlock Style="{StaticResource RowHint}" Text="Opens the site with this PC's code. Sign in with Discord and the runs from here show on your profile. Public tables stay anonymous either way."/>
                </StackPanel>
                <Button x:Name="LinkBtn" Grid.Column="1" Content="Link to my profile" VerticalAlignment="Center"/>
              </Grid>
              <Border Style="{StaticResource Divider}"/>
              <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Style="{StaticResource RowTitle}" Text="Link code"/>
                  <TextBlock Style="{StaticResource RowHint}" Text="The same code, for pasting by hand into Profile › Link your tracker."/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock x:Name="LinkCodeText" FontFamily="Consolas" FontSize="14" Foreground="{DynamicResource Gold}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                  <Button x:Name="CopyCodeBtn" Content="Copy" Height="32"/>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <TextBlock Style="{StaticResource GroupLabel}" Text="ON THIS PC"/>
          <Border Style="{StaticResource Group}">
            <StackPanel>
              <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Style="{StaticResource RowTitle}" Text="Install ID"/>
                  <TextBlock Style="{StaticResource RowHint}" Text="A random ID used only to drop duplicate uploads and spam. Replacing it starts fresh; the link code changes with it."/>
                </StackPanel>
                <Button x:Name="ResetIdBtn" Grid.Column="1" Content="Replace" VerticalAlignment="Center"/>
              </Grid>
              <Border Style="{StaticResource Divider}"/>
              <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Style="{StaticResource RowTitle}" Text="Your data"/>
                  <TextBlock Style="{StaticResource RowHint}" Text="Run history, settings, the item list and logs, all in one folder under your Windows profile."/>
                </StackPanel>
                <Button x:Name="DataFolderBtn" Grid.Column="1" Content="Open folder" VerticalAlignment="Center"/>
              </Grid>
              <Border Style="{StaticResource Divider}"/>
              <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Style="{StaticResource RowTitle}" Text="Pictures in miscount reports"/>
                  <TextBlock Style="{StaticResource RowHint}" Text="Keeps the last minute of the chat and the loot list as pictures, so Report a miscount can save what the screen showed. They can show other players' names. They stay on this PC; nothing is sent."/>
                </StackPanel>
                <CheckBox x:Name="ReportFramesChk" Grid.Column="1" Style="{StaticResource Switch}"/>
              </Grid>
              <!-- held until the site takes the pictures (kinahledger.com/v1/frames) and Steven approves the row: 0.8.12 ships it hidden -->
              <Border x:Name="SendFramesDivider" Style="{StaticResource Divider}" Visibility="Collapsed"/>
              <Grid x:Name="SendFramesRow" Style="{StaticResource Row}" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Style="{StaticResource RowTitle}" Text="Send report pictures to fix the reader"/>
                  <TextBlock Style="{StaticResource RowHint}" Text="With each miscount report, the loot list and crafting panel pictures go to kinahledger.com and become tests the tracker must pass before each release. Never the chat, never the whole screen."/>
                </StackPanel>
                <CheckBox x:Name="SendFramesChk" Grid.Column="1" Style="{StaticResource Switch}"/>
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Game reading: chat, zone and Market -->
        <StackPanel x:Name="PageReading" Visibility="Collapsed">
          <TextBlock Style="{StaticResource PageTitle}" Text="Game reading"/>
          <TextBlock Style="{StaticResource PageLead}" Text="Where the chat, the zone and the Market are read from. These buttons act right away."/>

          <TextBlock Style="{StaticResource GroupLabel}" Text="CHAT AND ZONE"/>
          <Border Style="{StaticResource Group}">
            <StackPanel Margin="18,14,18,16">
              <TextBlock x:Name="ChatStatus" Style="{StaticResource BodyStyle}" Foreground="{DynamicResource Ink}" FontSize="12.5" LineHeight="18"/>
              <WrapPanel Margin="0,10,0,0">
                <Button x:Name="CalibrateBtn" Content="Check the setup" Margin="0,0,8,6" ToolTip="A step-by-step check that the chat, the loot list and the HP bar read, with what to change when one doesn't."/>
                <Button x:Name="DetectBtn" Content="Detect now" Margin="0,0,8,6"/>
                <Button x:Name="PickChatBtn" Content="Choose the chat" Margin="0,0,8,6"/>
                <Button x:Name="TestBtn" Content="Test read" Margin="0,0,8,6"/>
                <Button x:Name="AutoChatBtn" Content="Back to automatic" Margin="0,0,8,6"/>
              </WrapPanel>
              <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Height="190" ClipToBounds="True" Margin="0,6,0,0">
                <Grid>
                  <TextBlock x:Name="PreviewHint" Text="The game shows here, with the chat, the zone and the Market outlined, once it has been found." Foreground="{DynamicResource Faint}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="24,0"/>
                  <Image x:Name="Preview" Stretch="Uniform" Margin="3" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Grid>
              </Border>
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Border Width="10" Height="10" CornerRadius="2" Background="{DynamicResource Accent}" VerticalAlignment="Center"/>
                <TextBlock Text="chat" Style="{StaticResource LabelStyle}" Margin="5,0,12,0"/>
                <Border Width="10" Height="10" CornerRadius="2" Background="{DynamicResource Gold}" VerticalAlignment="Center"/>
                <TextBlock Text="zone" Style="{StaticResource LabelStyle}" Margin="5,0,12,0"/>
                <Border Width="10" Height="10" CornerRadius="2" Background="{DynamicResource Mint}" VerticalAlignment="Center"/>
                <TextBlock Text="market" Style="{StaticResource LabelStyle}" Margin="5,0,0,0"/>
              </StackPanel>
              <TextBlock x:Name="ReadingNote" Style="{StaticResource BodyStyle}" FontSize="12.5" Margin="0,10,0,0" Visibility="Collapsed"/>
            </StackPanel>
          </Border>

          <TextBlock Style="{StaticResource GroupLabel}" Text="MARKET PRICES"/>
          <Border Style="{StaticResource Group}">
            <StackPanel Margin="18,14,18,16">
              <TextBlock Style="{StaticResource BodyStyle}" FontSize="12.5" LineHeight="18"
                         Text="Whenever you open the Market, the listings on your screen are shared as anonymous asks, under the Share switch. Nothing to set up; choose the area by hand only if it isn't found."/>
              <TextBlock x:Name="MarketStatus" Style="{StaticResource BodyStyle}" Foreground="{DynamicResource Ink}" FontSize="12.5" Margin="0,8,0,0"/>
              <WrapPanel Margin="0,10,0,0">
                <Button x:Name="PickMarketBtn" Content="Choose the Market" Margin="0,0,8,0"/>
                <Button x:Name="AutoMarketBtn" Content="Back to automatic" Margin="0,0,8,0"/>
                <!-- reads what the Market shows now and sends it at once: the server's current prices on the site -->
                <Button x:Name="ShareMarketBtn" Content="Share prices now" Margin="0,0,8,0" ToolTip="Reads the Market listings on your screen now and sends them at once. They show as your server's current prices on the site."/>
              </WrapPanel>
            </StackPanel>
          </Border>

          <!-- for checking the tracker (0.8.34, Steven 2026-10-25): accuracy figures are off for players; this shows them -->
          <TextBlock Style="{StaticResource GroupLabel}" Text="FOR CHECKING THE TRACKER"/>
          <Border Style="{StaticResource Group}">
            <Grid Style="{StaticResource Row}">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Style="{StaticResource RowTitle}" Text="Show accuracy details"/>
                <TextBlock Style="{StaticResource RowHint}" Text="What a second source confirmed, and the counts behind it. Off, you only see things to look at."/>
              </StackPanel>
              <CheckBox x:Name="ShowAccuracyChk" Grid.Column="1" Style="{StaticResource Switch}" AutomationProperties.Name="Show accuracy details"/>
            </Grid>
          </Border>
        </StackPanel>

        <!-- In game: the shortcut and the panel over the game -->
        <StackPanel x:Name="PageInGame" Visibility="Collapsed">
          <TextBlock Style="{StaticResource PageTitle}" Text="In game"/>
          <TextBlock Style="{StaticResource PageLead}" Text="The keyboard shortcut, and the panel: a small strip over the game that shows whenever the chat is being read, run or no run. It shows while the game is in front, in borderless or windowed mode: Windows can't draw over exclusive fullscreen."/>

          <TextBlock Style="{StaticResource GroupLabel}" Text="SHORTCUT"/>
          <Border Style="{StaticResource Group}">
            <StackPanel>
              <StackPanel Margin="18,13,18,15">
                <TextBlock Style="{StaticResource RowTitle}" Text="Start and stop a run"/>
                <TextBlock x:Name="HotkeyHint" Style="{StaticResource RowHint}" Text="Works while the game has focus. Click Change, then press the keys."/>
                <WrapPanel Margin="0,12,0,0">
                  <TextBox x:Name="HotkeyBox" Width="190" IsReadOnly="True" HorizontalContentAlignment="Center" FontFamily="Consolas" FontSize="14" Cursor="Arrow" Margin="0,0,8,0"/>
                  <Button x:Name="HotkeyChangeBtn" Content="Change" Margin="0,0,8,0"/>
                  <Button x:Name="HotkeyOffBtn" Content="Turn off" Margin="0,0,8,0"/>
                  <Button x:Name="HotkeyResetBtn" Content="Default"/>
                </WrapPanel>
              </StackPanel>
            </StackPanel>
          </Border>

          <TextBlock Style="{StaticResource GroupLabel}" Text="THE PANEL"/>
          <Border Style="{StaticResource Group}">
            <StackPanel>
              <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Style="{StaticResource RowTitle}" Text="Show the panel"/>
                  <TextBlock Style="{StaticResource RowHint}" Text="An always-on-top panel with your run and pickups, shown while the game is in front."/>
                </StackPanel>
                <CheckBox x:Name="HudChk" Grid.Column="1" Style="{StaticResource Switch}"/>
              </Grid>
              <Border Style="{StaticResource Divider}"/>
              <!-- the panel's look: the Strip, the Card or the Ticker, each drawn below at its real size from sample figures -->
              <StackPanel Margin="18,13,18,15">
                <TextBlock Style="{StaticResource RowTitle}" Text="Panel look"/>
                <TextBlock Style="{StaticResource RowHint}" Text="Each one is drawn below at its real size, with sample figures."/>
                <WrapPanel x:Name="HudLookHost" Margin="0,10,0,0"/>
                <StackPanel x:Name="HudLookPreview" Margin="0,6,0,0"/>
              </StackPanel>
              <Border Style="{StaticResource Divider}"/>
              <!-- locked: click-through and never focused, like a game overlay; Move the panel in the tray unlocks it for 20 s -->
              <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Style="{StaticResource RowTitle}" Text="Lock the panel in place"/>
                  <TextBlock Style="{StaticResource RowHint}" Text="Clicks go through it to the game. To move it, use Move the panel in the tray menu, or turn this off and drag it."/>
                </StackPanel>
                <CheckBox x:Name="HudLockChk" Grid.Column="1" Style="{StaticResource Switch}" AutomationProperties.Name="Lock the panel in place"/>
              </Grid>
              <Border Style="{StaticResource Divider}"/>
              <!-- which figures the panel shows: any mix, in a fixed order; the window works them all out the same way -->
              <StackPanel Margin="18,13,18,15">
                <TextBlock Style="{StaticResource RowTitle}" Text="What the panel shows"/>
                <TextBlock Style="{StaticResource RowHint}" Text="Pick any. The figures match the window's."/>
                <WrapPanel x:Name="HudFieldHost" Margin="0,10,0,0"/>
                <TextBlock x:Name="HudFieldsNote" Style="{StaticResource RowHint}" Margin="0,8,0,0" Visibility="Collapsed" Text="For the Strip. The Card and the Ticker show a set of their own."/>
              </StackPanel>
              <Border Style="{StaticResource Divider}"/>
              <!-- how solid the panel's background is, and its size: shown on the panel as the sliders move, kept on Save -->
              <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Style="{StaticResource RowTitle}" Text="Panel opacity"/>
                  <TextBlock Style="{StaticResource RowHint}" Text="How solid the panel's background is. The figures stay sharp."/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <Slider x:Name="HudOpacity" Width="140" Minimum="0.3" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center" AutomationProperties.Name="Panel opacity"/>
                  <TextBlock x:Name="HudOpacityLbl" FontSize="12.5" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="8,0,0,0" Width="40"/>
                </StackPanel>
              </Grid>
              <Border Style="{StaticResource Divider}"/>
              <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Style="{StaticResource RowTitle}" Text="Panel size"/>
                  <TextBlock Style="{StaticResource RowHint}" Text="Bigger for a large or high-resolution screen."/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <Slider x:Name="HudScale" Width="140" Minimum="0.7" Maximum="2" TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center" AutomationProperties.Name="Panel size"/>
                  <TextBlock x:Name="HudScaleLbl" FontSize="12.5" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="8,0,0,0" Width="40"/>
                </StackPanel>
              </Grid>
              <Border Style="{StaticResource Divider}"/>
              <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Style="{StaticResource RowTitle}" Text="Panel position"/>
                  <TextBlock x:Name="HudPositionHint" Style="{StaticResource RowHint}" Text="Drag it over the game, or snap it to a spot. Reset puts it back at the top centre."/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button x:Name="HudPlaceBtn" Content="Place the panel…" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="Drag it over the game, or snap it to the top centre, under the minimap or left of the target bar"/>
                  <Button x:Name="HudResetBtn" Content="Reset position" VerticalAlignment="Center"/>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Updates -->
        <StackPanel x:Name="PageUpdates" Visibility="Collapsed">
          <TextBlock Style="{StaticResource PageTitle}" Text="Updates"/>
          <TextBlock Style="{StaticResource PageLead}" Text="New versions come from the GitHub releases and are checked against the checksum in their notes before they're installed."/>
          <TextBlock Style="{StaticResource GroupLabel}" Text="UPDATES"/>
          <Border Style="{StaticResource Group}">
            <StackPanel>
              <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Style="{StaticResource RowTitle}" Text="Install new versions automatically"/>
                  <TextBlock Style="{StaticResource RowHint}" Text="Downloads in the background and installs when you close Kinah Ledger. Off: you're asked first."/>
                </StackPanel>
                <CheckBox x:Name="AutoUpdateChk" Grid.Column="1" Style="{StaticResource Switch}"/>
              </Grid>
              <Border Style="{StaticResource Divider}"/>
              <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock x:Name="VersionTitle" Style="{StaticResource RowTitle}"/>
                  <TextBlock x:Name="UpdateLine" Style="{StaticResource RowHint}"/>
                  <TextBlock FontSize="12.5" Margin="0,6,0,0"><Hyperlink x:Name="ReleasesLink" Style="{StaticResource LinkStyle}">All releases and their notes</Hyperlink><Run Text="   "/><Hyperlink x:Name="ReleasesDiscordLink" Style="{StaticResource LinkStyle}">New releases on Discord</Hyperlink></TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <!-- shown once an update has downloaded: installs it now, as the banner's Restart now does -->
                  <Button x:Name="RestartUpdateBtn" Style="{StaticResource PrimaryButton}" Content="Restart now" Margin="0,0,8,0" Visibility="Collapsed"/>
                  <Button x:Name="CheckNowBtn" Content="Check now"/>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- About -->
        <StackPanel x:Name="PageAbout" Visibility="Collapsed">
          <StackPanel Orientation="Horizontal">
            <Image Source="{StaticResource AppMark}" Width="52" Height="52" Margin="0,0,16,0" VerticalAlignment="Center"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Style="{StaticResource PageTitle}" Text="Kinah Ledger"/>
              <TextBlock x:Name="AboutVersion" Foreground="{DynamicResource Muted}" FontSize="13" Margin="0,2,0,0"/>
            </StackPanel>
          </StackPanel>
          <TextBlock Style="{StaticResource BodyStyle}" Margin="0,18,0,0"
                     Text="Kinah per hour, drop rates and Market prices for Aion 2, read from the chat on your screen and shared, anonymously, into tables everyone can use. Made by players for players. Free, with no ads; if it helps you, you can support development on Ko-fi."/>
          <Border Style="{StaticResource Group}" Margin="0,18,0,0">
            <StackPanel Margin="18,14,18,16">
              <TextBlock Style="{StaticResource RowTitle}" Text="Screen reading only"/>
              <TextBlock Style="{StaticResource RowHint}" Text="The tracker only reads what the game shows on screen. It never reads game memory or files, never captures network traffic, and never sends input to the game."/>
            </StackPanel>
          </Border>
          <WrapPanel Margin="0,18,0,0">
            <Button x:Name="AboutSupportBtn" Content="♥  Support on Ko-fi" Margin="0,0,8,8" ToolTip="ko-fi.com/swoly: help keep Kinah Ledger free and updated"/>
            <Button x:Name="AboutSiteBtn" Content="kinahledger.com" Margin="0,0,8,8"/>
            <Button x:Name="AboutDiscordBtn" Content="Discord" Margin="0,0,8,8" ToolTip="Help in #tracker-help, bugs in #bugs-and-feedback, every new release in #announcements"/>
            <Button x:Name="AboutSourceBtn" Content="Source code" Margin="0,0,8,8"/>
            <Button x:Name="AboutSentBtn" Content="What's shared" Margin="0,0,8,8"/>
            <Button x:Name="AboutLogsBtn" Content="Open logs" Margin="0,0,8,8"/>
          </WrapPanel>
          <TextBlock Style="{StaticResource BodyStyle}" FontSize="12" Foreground="{DynamicResource Faint}" Margin="0,16,0,0"
                     Text="Unofficial fan project, free and open source (MIT licence). Not affiliated with or endorsed by NCSOFT. AION is a trademark of NCSOFT Corporation."/>
        </StackPanel>

      </Grid>
    </ScrollViewer>

    <!-- footer: notes on the left, Cancel and Save on the right -->
    <Border Grid.Row="1" Grid.Column="1" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Background="{DynamicResource Bg}" Padding="32,12,24,14">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="FooterNote" Style="{StaticResource BodyStyle}" FontSize="12" LineHeight="16" VerticalAlignment="Center" Margin="0,0,16,0"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button x:Name="CancelBtn" Content="Cancel" Width="100" Margin="0,0,10,0" IsCancel="True"/>
          <Button x:Name="SaveBtn" Style="{StaticResource PrimaryButton}" Content="Save" Width="112" Height="36" FontSize="13.5" IsDefault="True"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
