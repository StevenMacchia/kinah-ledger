  <!-- the run card, its stat box, the slot frames and the item names: these used to be written into the window, so
       Daylight left them dark. Each look sets them now -->
  <RadialGradientBrush x:Key="HeroBg" Center="1,0" GradientOrigin="1,0" RadiusX="0.95" RadiusY="1.35">
    <GradientStop Color="#171A23" Offset="0"/><GradientStop Color="#111319" Offset="0.62"/><GradientStop Color="#111319" Offset="1"/>
  </RadialGradientBrush>
  <SolidColorBrush x:Key="HeroLine" Color="#2E3346"/>
  <SolidColorBrush x:Key="Inset" Color="#38000000"/>
  <Color x:Key="SlotColor">#0D0F14</Color>
  <SolidColorBrush x:Key="CommonInk" Color="#D9DDE8"/>
  <SolidColorBrush x:Key="GradeRare" Color="#62D98B"/>
  <SolidColorBrush x:Key="GradeLegend" Color="#5AA6FF"/>
  <SolidColorBrush x:Key="GradeUnique" Color="#F3D35E"/>
  <SolidColorBrush x:Key="GradeEpic" Color="#B48BFF"/>
  <SolidColorBrush x:Key="BtnPrimaryInk" Color="#1D1300"/>
  <LinearGradientBrush x:Key="BtnPrimary" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#F7C257" Offset="0"/><GradientStop Color="#F2B23A" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="BtnPrimaryHover" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#FFD27A" Offset="0"/><GradientStop Color="#FBC966" Offset="1"/>
  </LinearGradientBrush>
  <!-- control states, section headings, slot frames and chips: written into the templates before 0.8.31, so Daylight got
       navy button hovers, invisible dropdown rows, pale headings and white badges on a light slot. Each look sets them -->
  <SolidColorBrush x:Key="BtnHover" Color="#1E2230"/>
  <SolidColorBrush x:Key="BtnHoverLine" Color="#3A4058"/>
  <SolidColorBrush x:Key="ItemHover" Color="#1E2230"/>
  <SolidColorBrush x:Key="ItemSel" Color="#262A38"/>
  <SolidColorBrush x:Key="SegGroup" Color="#111319"/>
  <SolidColorBrush x:Key="SegOnBg" Color="#EDEFF5"/>
  <SolidColorBrush x:Key="SecGold" Color="#F5B942"/>
  <SolidColorBrush x:Key="ChipBg" Color="#14BEC6DC"/>
  <SolidColorBrush x:Key="ChipLine" Color="#2E3346"/>
  <SolidColorBrush x:Key="ChipOff" Color="#0D0F14"/>
  <SolidColorBrush x:Key="ChipOffLine" Color="#232736"/>
  <SolidColorBrush x:Key="OnSlot" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="SlotFrame" Color="#2E3346"/>
  <SolidColorBrush x:Key="SlotBadgeLine" Color="#2E3346"/>
  <SolidColorBrush x:Key="HoverTint" Color="#0DFFFFFF"/>
  <SolidColorBrush x:Key="GoldTint" Color="#14F5B942"/>
  <SolidColorBrush x:Key="GoldLine" Color="#80F5B942"/>
  <!-- the Events cards (0.8.31): a place's band, its flags -->
  <LinearGradientBrush x:Key="PlaceBand" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#1FF5B942" Offset="0"/><GradientStop Color="#0AF5B942" Offset="0.6"/><GradientStop Color="#00F5B942" Offset="1"/>
  </LinearGradientBrush>
  <SolidColorBrush x:Key="PlaceBandLine" Color="#3DF5B942"/>
  <SolidColorBrush x:Key="FlagBg" Color="#14F5B942"/>
  <SolidColorBrush x:Key="FlagInk" Color="#FFD27A"/>
  <SolidColorBrush x:Key="FlagLine" Color="#4DF5B942"/>
  <!-- rows and marks that used to be hard-coded; a skin overrides these too -->
  <SolidColorBrush x:Key="RowHead" Color="#0F1117"/>
  <SolidColorBrush x:Key="RowHover" Color="#171A22"/>
  <SolidColorBrush x:Key="Mark" Color="#1A1D27"/>
  <LinearGradientBrush x:Key="BtnStop" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#F26D6D" Offset="0"/><GradientStop Color="#E35D5D" Offset="1"/>
  </LinearGradientBrush>
  <!-- the v2 type (2026-11-10, as the site): Inter 400 to 700, shipped in the exe (Fonts/, OFL); Segoe UI stands in for any
       glyph it lacks. Nunito was asked for at 600 to 900; each of those asks moved one step lighter (600 to 400, 700 to 500,
       800 to 600, 900 to 700), as the site's font faces map them: text 400, labels 500, headings 600, big figures 700 -->
  <FontFamily x:Key="DisplayFont">pack://application:,,,/Fonts/#Inter, Segoe UI Variable Display, Segoe UI</FontFamily>
  <FontFamily x:Key="BodyFont">pack://application:,,,/Fonts/#Inter, Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

  <Style x:Key="CardStyle" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Card}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="12"/>
  </Style>

  <Style x:Key="LabelStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Foreground" Value="{DynamicResource Faint}"/>
  </Style>

  <Style x:Key="BodyStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="LineHeight" Value="19"/>
  </Style>

  <Style x:Key="StepTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Margin" Value="12,0,0,0"/>
  </Style>

  <Style x:Key="Badge" TargetType="Border">
    <Setter Property="Width" Value="24"/>
    <Setter Property="Height" Value="24"/>
    <Setter Property="CornerRadius" Value="12"/>
    <Setter Property="Background" Value="{DynamicResource AccentDim}"/>
  </Style>
  <Style x:Key="BadgeText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style x:Key="TileValue" TargetType="TextBlock">
    <Setter Property="FontSize" Value="26"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}"/>
    <Setter Property="Margin" Value="0,6,0,0"/>
  </Style>

  <Style x:Key="LinkStyle" TargetType="Hyperlink">
    <Setter Property="Foreground" Value="{DynamicResource Gold}"/>
    <Setter Property="TextDecorations" Value="{x:Null}"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Trigger>
    </Style.Triggers>
  </Style>

  <!-- buttons -->
  <!-- keyboard focus (0.10.11): a gold ring just outside the control, in place of Windows's dotted rectangle. Drawn only when
       focus moved by keyboard (Tab, the arrows), as the dotted one was: a click never shows it. Two corner radii, for the
       pills and buttons and for the small boxes. -->
  <Style x:Key="FocusRing">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Rectangle Margin="-3" RadiusX="11" RadiusY="11" Stroke="{DynamicResource Accent}" StrokeThickness="1.5" SnapsToDevicePixels="True"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="FocusRingSmall">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Rectangle Margin="-3" RadiusX="7" RadiusY="7" Stroke="{DynamicResource Accent}" StrokeThickness="1.5" SnapsToDevicePixels="True"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="Button">
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    <Setter Property="Background" Value="{DynamicResource Card2}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
    <Setter Property="Padding" Value="16,0"/>
    <Setter Property="Height" Value="36"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="b" Property="Background" Value="{DynamicResource BtnHover}"/>
              <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource BtnHoverLine}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.85"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{DynamicResource BtnPrimary}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Gold}"/>
    <Setter Property="Foreground" Value="{DynamicResource BtnPrimaryInk}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.92"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.8"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- the page pills (Quest, 2026-11-07): Farm / Craft / Runs in one rounded group, the lit one a gold pill with dark ink;
       the same two styles switch LOOT's sides and the Today strip's scope -->
  <Style x:Key="SegOff" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
    <Setter Property="Height" Value="28"/>
    <Setter Property="Padding" Value="11,0"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource HoverTint}"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.85"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SegOn" TargetType="Button" BasedOn="{StaticResource SegOff}">
    <Setter Property="Background" Value="{DynamicResource SegOnBg}"/>
    <Setter Property="Foreground" Value="{DynamicResource SegOnInk}"/>
  </Style>
  <!-- a quiet button: Start run under the ring (coral while a run is on). Rounded rectangles everywhere, no ovals (Steven, 2026-11-07) -->
  <Style x:Key="PillBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{DynamicResource Inset}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource CardLineHover}"/>
    <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Height" Value="30"/>
    <Setter Property="Padding" Value="14,0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource Card2}"/><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Gold}"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.85"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- a round icon button: the site, Share, Options, Compact/Full and the card's three dots -->
  <Style x:Key="RoundBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Width" Value="32"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Background" Value="{DynamicResource Card}"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource Card2}"/><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource CardLineHover}"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.85"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- a Quest card: a rounded plum surface with a one-pixel edge; a chip is the small one that opens on a click -->
  <Style x:Key="QCard" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Card}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource CardLine}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="12"/>
    <Setter Property="Padding" Value="14,12,14,12"/>
  </Style>
  <Style x:Key="QChip" TargetType="Border" BasedOn="{StaticResource QCard}">
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Padding" Value="11,8,11,8"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource CardLineHover}"/></Trigger>
    </Style.Triggers>
  </Style>
  <!-- a line icon at 16 px, the stroke in the text's muted tone; the chevron that turns when a card opens; a pill's icon in the pill's own ink -->
  <Style x:Key="QIconStyle" TargetType="Path">
    <Setter Property="Width" Value="16"/>
    <Setter Property="Height" Value="16"/>
    <Setter Property="Stretch" Value="Uniform"/>
    <Setter Property="Stroke" Value="{DynamicResource Muted}"/>
    <Setter Property="StrokeThickness" Value="1.7"/>
    <Setter Property="StrokeLineJoin" Value="Round"/>
    <Setter Property="StrokeStartLineCap" Value="Round"/>
    <Setter Property="StrokeEndLineCap" Value="Round"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="QChev" TargetType="Path" BasedOn="{StaticResource QIconStyle}">
    <Setter Property="Data" Value="{StaticResource IcChev}"/>
    <Setter Property="Width" Value="13"/>
    <Setter Property="Height" Value="13"/>
    <Setter Property="Stroke" Value="{DynamicResource Faint}"/>
    <Setter Property="StrokeThickness" Value="2"/>
    <Setter Property="Margin" Value="6,0,0,0"/>
    <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
  </Style>
  <Style x:Key="NavIcon" TargetType="Path" BasedOn="{StaticResource QIconStyle}">
    <Setter Property="Width" Value="14"/>
    <Setter Property="Height" Value="14"/>
    <Setter Property="StrokeThickness" Value="2"/>
    <Setter Property="Margin" Value="0,0,6,0"/>
    <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
  </Style>
  <!-- a small rounded label: "this run · this zone", "best guess" -->
  <Style x:Key="Chip" TargetType="Border">
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Padding" Value="10,3"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Background" Value="{DynamicResource ChipBg}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource ChipLine}"/>
  </Style>

  <!-- check boxes -->
  <Style TargetType="CheckBox">
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingSmall}"/>
    <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Border x:Name="box" Width="18" Height="18" CornerRadius="5" BorderThickness="1" BorderBrush="{DynamicResource LineStrong}" Background="{DynamicResource Card2}" VerticalAlignment="Center">
              <Path x:Name="tick" Data="M4,9.5 L7.5,13 L14,5.5" Stroke="{DynamicResource BtnPrimaryInk}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
            </Border>
            <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="box" Property="Background" Value="{DynamicResource Gold}"/>
              <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Gold}"/>
              <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Gold}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- text box with a placeholder in Tag -->
  <Style TargetType="TextBox">
    <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    <Setter Property="Background" Value="{DynamicResource Card2}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource Ink}"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource Gold}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Padding" Value="11,0"/>
    <Setter Property="Height" Value="38"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8">
            <Grid>
              <TextBlock x:Name="ph" Text="{TemplateBinding Tag}" Foreground="{DynamicResource Faint}" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False"/>
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" Focusable="False"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Text" Value=""><Setter TargetName="ph" Property="Visibility" Value="Visible"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- combo box -->
  <Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    <Setter Property="FontSize" Value="13.5"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="b" Padding="11,7" CornerRadius="6" Background="Transparent" Margin="0,1">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource ItemHover}"/></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource ItemSel}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBox">
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Height" Value="38"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton x:Name="tb" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Focusable="False" ClickMode="Press" Cursor="Hand">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border x:Name="b" Background="{DynamicResource Card2}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1" CornerRadius="8">
                    <Path Data="M0,0 L4.5,4.5 L9,0" Stroke="{DynamicResource Muted}" StrokeThickness="1.6" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource BtnHoverLine}"/></Trigger>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" Margin="12,0,32,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade" StaysOpen="False">
              <Border Background="{DynamicResource Card2}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1" CornerRadius="8" MinWidth="{TemplateBinding ActualWidth}" Margin="0,4,0,8" Padding="4">
                <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.5"/></Border.Effect>
                <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- a slider in the window's look (0.10.11): a thin track, the part before the thumb in the accent, a round thumb -->
  <Style TargetType="Slider">
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Height" Value="22"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Grid Background="Transparent">
            <Border Height="4" CornerRadius="2" Background="{DynamicResource LineStrong}" VerticalAlignment="Center"/>
            <Track x:Name="PART_Track" VerticalAlignment="Center">
              <Track.DecreaseRepeatButton>
                <RepeatButton Focusable="False" IsTabStop="False" Cursor="Hand">
                  <RepeatButton.Template>
                    <ControlTemplate TargetType="RepeatButton">
                      <Border Height="22" Background="Transparent"><Border Height="4" CornerRadius="2,0,0,2" Background="{DynamicResource Accent}" VerticalAlignment="Center"/></Border>
                    </ControlTemplate>
                  </RepeatButton.Template>
                </RepeatButton>
              </Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton>
                <RepeatButton Focusable="False" IsTabStop="False" Cursor="Hand">
                  <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="22" Background="Transparent"/></ControlTemplate></RepeatButton.Template>
                </RepeatButton>
              </Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb Width="16" Height="16" Cursor="Hand" Focusable="False">
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Ellipse x:Name="knob" Fill="{DynamicResource Ink}" Stroke="{DynamicResource Accent}" StrokeThickness="1.5"/>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="knob" Property="Fill" Value="{DynamicResource Accent}"/></Trigger>
                        <Trigger Property="IsDragging" Value="True"><Setter TargetName="knob" Property="Fill" Value="{DynamicResource Accent}"/></Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- thin scroll bar -->
  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="8"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{DynamicResource LineStrong}" CornerRadius="4" Margin="2,0"/></ControlTemplate></Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Options window: pages, groups of rows, switches and the side navigation -->
  <Style x:Key="PageTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}"/>
    <Setter Property="FontSize" Value="22"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
  </Style>
  <Style x:Key="PageLead" TargetType="TextBlock" BasedOn="{StaticResource BodyStyle}">
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Margin" Value="0,4,0,0"/>
  </Style>
  <Style x:Key="GroupLabel" TargetType="TextBlock" BasedOn="{StaticResource LabelStyle}">
    <Setter Property="Margin" Value="2,22,0,8"/>
  </Style>
  <Style x:Key="Group" TargetType="Border" BasedOn="{StaticResource CardStyle}">
    <Setter Property="Padding" Value="0"/>
  </Style>
  <Style x:Key="Row" TargetType="Grid">
    <Setter Property="Margin" Value="18,13,18,13"/>
    <Setter Property="MinHeight" Value="36"/>
  </Style>
  <Style x:Key="RowTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13.5"/>
    <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="RowHint" TargetType="TextBlock" BasedOn="{StaticResource BodyStyle}">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="LineHeight" Value="17"/>
    <Setter Property="Margin" Value="0,3,16,0"/>
  </Style>
  <Style x:Key="Divider" TargetType="Border">
    <Setter Property="Height" Value="1"/>
    <Setter Property="Background" Value="{DynamicResource Line}"/>
  </Style>

  <!-- an on/off switch, for settings rows -->
  <Style x:Key="Switch" TargetType="CheckBox">
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Background="Transparent">
            <Border x:Name="track" Width="42" Height="22" CornerRadius="11" BorderThickness="1" BorderBrush="{DynamicResource LineStrong}" Background="{DynamicResource Card2}"/>
            <Ellipse x:Name="knob" Width="14" Height="14" Fill="{DynamicResource Muted}" HorizontalAlignment="Left" Margin="5,0,0,0"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="track" Property="Background" Value="{DynamicResource Gold}"/>
              <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource Gold}"/>
              <Setter TargetName="knob" Property="Fill" Value="{DynamicResource BtnPrimaryInk}"/>
              <Setter TargetName="knob" Property="Margin" Value="23,0,0,0"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource Gold}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- a side-navigation entry; Tag="True" marks the page on show -->
  <Style x:Key="NavItem" TargetType="Button">
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
    <Setter Property="FontSize" Value="13.5"/>
    <Setter Property="Height" Value="38"/>
    <Setter Property="Margin" Value="0,0,0,2"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="b" Background="Transparent" CornerRadius="8" Padding="14,0">
              <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
            </Border>
            <Border x:Name="bar" Width="3" Height="16" CornerRadius="1.5" Background="{DynamicResource Accent}" HorizontalAlignment="Left" Visibility="Collapsed"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource RowHover}"/></Trigger>
            <Trigger Property="Tag" Value="True">
              <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentDim}"/>
              <Setter TargetName="bar" Property="Visibility" Value="Visible"/>
              <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
              <Setter Property="FontWeight" Value="SemiBold"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ToolTip">
    <Setter Property="Background" Value="{DynamicResource Card2}"/>
    <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
    <Setter Property="Padding" Value="10,6"/>
  </Style>


  <!-- the app mark: tools/brand/logo.svg as a vector, so it is sharp at any size and DPI (the drop shadow is left out) -->
  <DrawingImage x:Key="AppMark">
    <DrawingImage.Drawing>
      <DrawingGroup ClipGeometry="M0,0 H100 V100 H0 Z">
        <GeometryDrawing Geometry="M25,2 H75 A23,23 0 0 1 98,25 V75 A23,23 0 0 1 75,98 H25 A23,23 0 0 1 2,75 V25 A23,23 0 0 1 25,2 Z">
          <GeometryDrawing.Brush><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#252C5C" Offset="0"/><GradientStop Color="#131834" Offset="0.6"/><GradientStop Color="#0A0D1D" Offset="1"/></LinearGradientBrush></GeometryDrawing.Brush>
        </GeometryDrawing>
        <GeometryDrawing>
          <GeometryDrawing.Geometry><EllipseGeometry Center="51,50" RadiusX="40" RadiusY="40"/></GeometryDrawing.Geometry>
          <GeometryDrawing.Brush><RadialGradientBrush><GradientStop Color="#42EBAE4C" Offset="0"/><GradientStop Color="#00EBAE4C" Offset="1"/></RadialGradientBrush></GeometryDrawing.Brush>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M25,2.8 H75 A22.2,22.2 0 0 1 97.2,25 V75 A22.2,22.2 0 0 1 75,97.2 H25 A22.2,22.2 0 0 1 2.8,75 V25 A22.2,22.2 0 0 1 25,2.8 Z">
          <GeometryDrawing.Pen><Pen Thickness="1.6"><Pen.Brush><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#3DFFFFFF" Offset="0"/><GradientStop Color="#0DFFFFFF" Offset="0.35"/><GradientStop Color="#08FFFFFF" Offset="1"/></LinearGradientBrush></Pen.Brush></Pen></GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M31.7,24 H44.2 V73 H31.7 Z M44.2,47.03 L59.2,24 H73.7 L44.2,69.29 Z M54.23,53.89 L73.7,73 H58.7 L44.2,58.77 Z">
          <GeometryDrawing.Brush><LinearGradientBrush StartPoint="0,22" EndPoint="0,71" MappingMode="Absolute"><GradientStop Color="#B9781F" Offset="0"/><GradientStop Color="#7A4C10" Offset="1"/></LinearGradientBrush></GeometryDrawing.Brush>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M30,22 H42.5 V71 H30 Z M42.5,45.03 L57.5,22 H72 L42.5,67.29 Z M52.53,51.89 L72,71 H57 L42.5,56.77 Z">
          <GeometryDrawing.Brush><LinearGradientBrush StartPoint="0,22" EndPoint="0,71" MappingMode="Absolute"><GradientStop Color="#FFEDC4" Offset="0"/><GradientStop Color="#F4C46A" Offset="0.42"/><GradientStop Color="#D38C27" Offset="1"/></LinearGradientBrush></GeometryDrawing.Brush>
        </GeometryDrawing>
        <GeometryDrawing>
          <GeometryDrawing.Geometry><RectangleGeometry Rect="30,79,42,5.5" RadiusX="2.75" RadiusY="2.75"/></GeometryDrawing.Geometry>
          <GeometryDrawing.Brush><LinearGradientBrush StartPoint="30,0" EndPoint="72,0" MappingMode="Absolute"><GradientStop Color="#7EE6DA" Offset="0"/><GradientStop Color="#3FB4C6" Offset="1"/></LinearGradientBrush></GeometryDrawing.Brush>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>

</ResourceDictionary>
