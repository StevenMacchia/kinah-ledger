  <SolidColorBrush x:Key="LilacTint" Color="#29B692FF"/>
  <SolidColorBrush x:Key="CoralTint" Color="#29FF7D6E"/>
  <SolidColorBrush x:Key="LimeTint" Color="#29C6F26B"/>
  <SolidColorBrush x:Key="MintTint" Color="#295CE1B5"/>
  <SolidColorBrush x:Key="GoldIcTint" Color="#29FFC857"/>
