<Window x:Class="KinahLedger.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kinah Ledger" Width="800" SizeToContent="Height" ResizeMode="CanMinimize"
        Background="{StaticResource Bg}" Foreground="{StaticResource Ink}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        WindowStartupLocation="CenterScreen">

  <Window.Resources>
    <DataTemplate x:Key="RowTemplate">
      <Border x:Name="RowBorder" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Height="34">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="120"/><ColumnDefinition Width="120"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="NameText" Text="{Binding Name}" Foreground="{StaticResource Ink}" VerticalAlignment="Center" Margin="12,0,8,0" TextTrimming="CharacterEllipsis" FontSize="13.5"/>
          <TextBlock Grid.Column="1" Text="{Binding Drops}" Foreground="{StaticResource Ink}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0" FontSize="13.5"/>
          <TextBlock Grid.Column="2" Text="{Binding DropPct}" Foreground="{StaticResource Mint}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0" FontSize="13.5"/>
          <TextBlock Grid.Column="3" Text="{Binding PerHour}" Foreground="{StaticResource Violet}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0" FontSize="13.5"/>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <!-- item grades in the game's own colours -->
        <DataTrigger Binding="{Binding Grade}" Value="Rare"><Setter TargetName="NameText" Property="Foreground" Value="#5FE08A"/></DataTrigger>
        <DataTrigger Binding="{Binding Grade}" Value="Epic"><Setter TargetName="NameText" Property="Foreground" Value="#5FA8FF"/></DataTrigger>
        <DataTrigger Binding="{Binding Grade}" Value="Unique"><Setter TargetName="NameText" Property="Foreground" Value="#F5D05A"/></DataTrigger>
        <DataTrigger Binding="{Binding Grade}" Value="Legend"><Setter TargetName="NameText" Property="Foreground" Value="#C88CFF"/></DataTrigger>
        <!-- a skill header row inside the gathered table: its own node count, failures and Plentiful rate -->
        <DataTrigger Binding="{Binding Header}" Value="True">
          <Setter TargetName="RowBorder" Property="Background" Value="#101826"/>
          <Setter TargetName="RowBorder" Property="Height" Value="30"/>
          <Setter TargetName="NameText" Property="Foreground" Value="{StaticResource Gold}"/>
          <Setter TargetName="NameText" Property="FontWeight" Value="SemiBold"/>
          <Setter TargetName="NameText" Property="FontSize" Value="12"/>
          <Setter TargetName="NameText" Property="Grid.ColumnSpan" Value="4"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- pets: name, drops, per hour. No drop % column: Soul Crystals are rated by time in the zone, never by kill. -->
    <DataTemplate x:Key="PetRowTemplate">
      <Border x:Name="RowBorder" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Height="34">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="130"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="NameText" Text="{Binding Name}" Foreground="{StaticResource Ink}" VerticalAlignment="Center" Margin="12,0,8,0" TextTrimming="CharacterEllipsis" FontSize="13.5"/>
          <TextBlock Grid.Column="1" Text="{Binding Drops}" Foreground="{StaticResource Ink}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0" FontSize="13.5"/>
          <TextBlock Grid.Column="2" Text="{Binding PerHour}" Foreground="{StaticResource Violet}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0" FontSize="13.5"/>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <!-- a zone header row: time spent there, kills and the crystal rate, so the best spot stands out -->
        <DataTrigger Binding="{Binding Header}" Value="True">
          <Setter TargetName="RowBorder" Property="Background" Value="#101826"/>
          <Setter TargetName="RowBorder" Property="Height" Value="30"/>
          <Setter TargetName="NameText" Property="Foreground" Value="{StaticResource Gold}"/>
          <Setter TargetName="NameText" Property="FontWeight" Value="SemiBold"/>
          <Setter TargetName="NameText" Property="FontSize" Value="12"/>
          <Setter TargetName="NameText" Property="Grid.ColumnSpan" Value="3"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>

  <Border x:Name="Root" Background="{StaticResource Bg}" Padding="26,20,26,18">
    <StackPanel>

      <!-- header -->
      <Grid>
        <StackPanel>
          <TextBlock Text="KINAH LEDGER" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="21" FontWeight="Bold"/>
          <TextBlock x:Name="Tagline" Style="{StaticResource BodyStyle}" Margin="0,4,0,0" MaxWidth="540" HorizontalAlignment="Left"
                     Text="Unofficial Aion 2 farming tracker. Reads the loot lines from the chat on your screen. Nothing touches the game."/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
          <StackPanel Margin="0,0,14,0">
            <TextBlock HorizontalAlignment="Right" FontSize="13"><Hyperlink x:Name="SiteLink" Style="{StaticResource LinkStyle}">Project page</Hyperlink></TextBlock>
            <TextBlock x:Name="Version" Text="v0.6.0" Foreground="{StaticResource Faint}" HorizontalAlignment="Right" Margin="0,3,0,0" FontSize="12"/>
          </StackPanel>
          <!-- once the chat and zone have been found, steps 1 and 2 live behind this button -->
          <Button x:Name="SettingsBtn" Content="Settings" Height="32" Padding="12,0" FontSize="12.5" VerticalAlignment="Top"/>
        </StackPanel>
      </Grid>

      <!-- setup: steps 1 and 2. Hidden in the compact layout; Settings brings it back. -->
      <Border x:Name="SetupCard" Style="{StaticResource CardStyle}" Margin="0,18,0,0" Padding="20,18,20,18">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="248"/>
          </Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,20,0">
            <StackPanel Orientation="Horizontal">
              <Border Style="{StaticResource Badge}"><TextBlock Style="{StaticResource BadgeText}" Text="1"/></Border>
              <TextBlock Style="{StaticResource StepTitle}" Text="In the game"/>
            </StackPanel>
            <TextBlock Style="{StaticResource BodyStyle}" Margin="36,7,0,0"
                       Text="Play in borderless or windowed mode with the chat open at the bottom-left. A chat tab showing only System Notifications reads best, but the normal tab works too."/>
            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
              <Border Style="{StaticResource Badge}"><TextBlock Style="{StaticResource BadgeText}" Text="2"/></Border>
              <TextBlock Style="{StaticResource StepTitle}" Text="Chat area and zone"/>
            </StackPanel>
            <TextBlock x:Name="Step2Status" Style="{StaticResource BodyStyle}" Margin="36,7,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="36,12,0,0">
              <Button x:Name="DetectBtn" Content="Detect now" Width="112"/>
              <Button x:Name="PickBtn" Content="Choose the chat" Width="136" Margin="10,0,0,0"/>
              <Button x:Name="TestBtn" Content="Test read" Width="104" Margin="10,0,0,0"/>
            </StackPanel>
          </StackPanel>
          <StackPanel Grid.Column="1" VerticalAlignment="Top">
            <Border Background="{StaticResource Bg}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Height="112" ClipToBounds="True">
              <Grid>
                <TextBlock x:Name="PreviewHint" Text="the game, with the chat and map outlined" Foreground="{StaticResource Faint}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="12,0"/>
                <Image x:Name="Preview" Stretch="Uniform" Margin="3" RenderOptions.BitmapScalingMode="HighQuality"/>
              </Grid>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
              <Border Width="10" Height="10" CornerRadius="2" Background="{StaticResource Accent}" VerticalAlignment="Center"/>
              <TextBlock Text="chat" Style="{StaticResource LabelStyle}" Margin="5,0,12,0"/>
              <Border Width="10" Height="10" CornerRadius="2" Background="{StaticResource Gold}" VerticalAlignment="Center"/>
              <TextBlock Text="zone" Style="{StaticResource LabelStyle}" Margin="5,0,12,0"/>
              <Border Width="10" Height="10" CornerRadius="2" Background="{StaticResource Mint}" VerticalAlignment="Center"/>
              <TextBlock Text="market" Style="{StaticResource LabelStyle}" Margin="5,0,0,0"/>
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>

      <!-- session -->
      <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0" Padding="20,18,20,18">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Border x:Name="Badge3" Style="{StaticResource Badge}"><TextBlock Style="{StaticResource BadgeText}" Text="3"/></Border>
              <TextBlock x:Name="Step3Title" Style="{StaticResource StepTitle}" Text="What you're farming"/>
            </StackPanel>
            <Grid x:Name="KindGrid" Margin="36,12,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <ComboBox x:Name="Kind" Width="200" VerticalAlignment="Top"/>
              <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="ZoneLbl" Foreground="{StaticResource Ink}" FontSize="13.5" FontWeight="SemiBold" Text="Zone: detected when you start" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="40"/>
                <TextBlock x:Name="KindHint" Style="{StaticResource BodyStyle}" FontSize="12" LineHeight="16"/>
              </StackPanel>
            </Grid>
            <!-- wraps instead of clipping when the column is narrow -->
            <WrapPanel x:Name="OptsRow" Margin="36,14,0,0">
              <CheckBox x:Name="HudChk" Content="Show panel over the game" Margin="0,0,18,4"/>
              <CheckBox x:Name="ShareChk" Content="Share runs anonymously" Margin="0,0,6,4"/>
              <TextBlock Margin="0,0,0,4" VerticalAlignment="Center" FontSize="13"><Hyperlink x:Name="SentLink" Style="{StaticResource LinkStyle}">what's sent?</Hyperlink></TextBlock>
            </WrapPanel>
            <!-- optional: ties this PC's runs to a profile on the site; runs stay anonymous without it -->
            <TextBlock x:Name="LinkRow" Margin="36,8,0,0" FontSize="12.5" Foreground="{StaticResource Muted}"
                       ToolTip="Paste this into your profile on the site to see your own runs there. It only ties runs from this PC to your profile; it says nothing about who you are."><Run Text="Profile link code "/><Run x:Name="LinkCodeRun" FontFamily="Consolas" FontSize="13" Foreground="{StaticResource Gold}"/><Run Text="   "/><Hyperlink x:Name="CopyCodeLink" Style="{StaticResource LinkStyle}">copy</Hyperlink></TextBlock>
          </StackPanel>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0">
            <Button x:Name="StartBtn" Style="{StaticResource PrimaryButton}" Content="Start tracking" Width="196" Height="50"/>
            <TextBlock Text="Ctrl+Shift+K works from inside the game" Foreground="{StaticResource Faint}" FontSize="11.5" HorizontalAlignment="Center" Margin="0,9,0,0"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- market prices: the listings are read off the Market window while it's open and shared as asks. Its own switch; off keeps everything else working. -->
      <Border x:Name="MarketCard" Style="{StaticResource CardStyle}" Margin="0,12,0,0" Padding="20,16,20,16">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Border x:Name="Badge4" Style="{StaticResource Badge}"><TextBlock Style="{StaticResource BadgeText}" Text="4"/></Border>
            <TextBlock x:Name="Step4Title" Style="{StaticResource StepTitle}" Text="Market prices"/>
          </StackPanel>
          <WrapPanel x:Name="MarketRow" Margin="36,12,0,0">
            <CheckBox x:Name="MarketChk" Content="Share market prices while the Market is open" Margin="0,0,8,6" VerticalAlignment="Center"/>
            <TextBlock Margin="0,0,0,6" VerticalAlignment="Center" FontSize="13"><Hyperlink x:Name="MarketSentLink" Style="{StaticResource LinkStyle}">what's read?</Hyperlink></TextBlock>
          </WrapPanel>
          <WrapPanel x:Name="MarketRow2" Margin="36,4,0,0">
            <TextBlock Text="Server" Foreground="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,6"/>
            <TextBox x:Name="ServerBox" Width="190" Height="36" FontSize="13" Tag="e.g. Siel (Elyos)" Margin="0,0,10,6" VerticalAlignment="Center"
                     ToolTip="Your server and faction, as the game shows them. Sent with the prices so they land on the right board; nothing is sent without it."/>
            <Button x:Name="MarketPickBtn" Content="Choose the Market" Width="150" FontSize="12.5" Margin="0,0,10,6" VerticalAlignment="Center"/>
            <TextBlock x:Name="MarketResetText" Margin="0,0,0,6" VerticalAlignment="Center" FontSize="12.5" Visibility="Collapsed"><Hyperlink x:Name="MarketResetLink" Style="{StaticResource LinkStyle}">back to automatic</Hyperlink></TextBlock>
          </WrapPanel>
          <TextBlock x:Name="MarketStatus" Style="{StaticResource BodyStyle}" FontSize="12" LineHeight="16" Margin="36,4,0,0"
                     Text="Finds the Market window by its title and column headers while you track. Only the listings on your screen are read: item, quantity, unit price. Seller names are never captured."/>
        </StackPanel>
      </Border>

      <!-- tiles -->
      <UniformGrid Columns="4" Margin="-6,12,-6,0">
        <Border Style="{StaticResource CardStyle}" Margin="6,0" Padding="16,12,16,14">
          <StackPanel><TextBlock x:Name="Tile1Label" Style="{StaticResource LabelStyle}" Text="KINAH / HR"/><TextBlock x:Name="KinahHr" Style="{StaticResource TileValue}" Foreground="{StaticResource Gold}" Text="0"/></StackPanel>
        </Border>
        <Border Style="{StaticResource CardStyle}" Margin="6,0" Padding="16,12,16,14">
          <StackPanel><TextBlock x:Name="Tile2Label" Style="{StaticResource LabelStyle}" Text="KINAH / KILL"/><TextBlock x:Name="KinahKill" Style="{StaticResource TileValue}" Foreground="{StaticResource Gold}" Text="—"/></StackPanel>
        </Border>
        <Border Style="{StaticResource CardStyle}" Margin="6,0" Padding="16,12,16,14">
          <StackPanel><TextBlock x:Name="Tile3Label" Style="{StaticResource LabelStyle}" Text="KILLS / HR"/><TextBlock x:Name="KillsHr" Style="{StaticResource TileValue}" Foreground="{StaticResource Mint}" Text="0"/></StackPanel>
        </Border>
        <Border Style="{StaticResource CardStyle}" Margin="6,0" Padding="16,12,16,14">
          <StackPanel><TextBlock x:Name="Tile4Label" Style="{StaticResource LabelStyle}" Text="DROPS / HR"/><TextBlock x:Name="DropsHr" Style="{StaticResource TileValue}" Foreground="{StaticResource Violet}" Text="0"/></StackPanel>
        </Border>
      </UniformGrid>

      <!-- drops and gathered, two separate tables -->
      <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0" Padding="20,14,20,12">
        <StackPanel x:Name="TableStack">
          <Grid Margin="0,0,0,10">
            <TextBlock x:Name="TableTitle" Style="{StaticResource LabelStyle}" Text="THIS SESSION" VerticalAlignment="Center"/>
            <TextBlock x:Name="Summary" Foreground="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" Text="no run yet"/>
          </Grid>

          <StackPanel x:Name="DropsSection">
            <Border Background="{StaticResource Card2}" CornerRadius="6" Height="30">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="120"/><ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource LabelStyle}" Text="DROPS FROM KILLS" VerticalAlignment="Center" Margin="12,0,0,0"/>
                <TextBlock Grid.Column="1" Style="{StaticResource LabelStyle}" Text="DROPS" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0"/>
                <TextBlock x:Name="PctHeader" Grid.Column="2" Style="{StaticResource LabelStyle}" Text="DROP %" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0" ToolTip="Drops divided by kills. Kills are counted from Kinah or Soul Point pickups (one per mob), or from kill lines when the chat shows them."/>
                <TextBlock Grid.Column="3" Style="{StaticResource LabelStyle}" Text="PER HOUR" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0"/>
              </Grid>
            </Border>
            <Grid MinHeight="72">
              <ScrollViewer MaxHeight="206" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="Rows" ItemTemplate="{StaticResource RowTemplate}"/>
              </ScrollViewer>
              <TextBlock x:Name="TableEmpty" Style="{StaticResource BodyStyle}" Foreground="{StaticResource Faint}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" MaxWidth="460"
                         Text="Drops show here as they're read, with the drop rate per kill and per hour."/>
            </Grid>
          </StackPanel>

          <StackPanel x:Name="GatherSection" Margin="0,12,0,0">
            <Border Background="{StaticResource Card2}" CornerRadius="6" Height="30">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="120"/><ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource LabelStyle}" Text="GATHERED" VerticalAlignment="Center" Margin="12,0,0,0"/>
                <TextBlock Grid.Column="1" Style="{StaticResource LabelStyle}" Text="COUNT" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0"/>
                <TextBlock Grid.Column="2" Style="{StaticResource LabelStyle}" Text="PER NODE" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0" ToolTip="Count divided by nodes. Any ore, log, Odyle, herb or food line counts as one node; gemstones and higher tiers are the finds."/>
                <TextBlock Grid.Column="3" Style="{StaticResource LabelStyle}" Text="PER HOUR" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0"/>
              </Grid>
            </Border>
            <Grid MinHeight="72">
              <ScrollViewer MaxHeight="206" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="GatherRows" ItemTemplate="{StaticResource RowTemplate}"/>
              </ScrollViewer>
              <TextBlock x:Name="GatherEmpty" Style="{StaticResource BodyStyle}" Foreground="{StaticResource Faint}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" MaxWidth="460"
                         Text="Gathered materials show here, with how often each comes per node and per hour."/>
            </Grid>
          </StackPanel>

          <StackPanel x:Name="PetSection" Margin="0,12,0,0">
            <Border Background="{StaticResource Card2}" CornerRadius="6" Height="30">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="130"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource LabelStyle}" Text="PETS · SOUL CRYSTALS BY ZONE" VerticalAlignment="Center" Margin="12,0,0,0"/>
                <TextBlock Grid.Column="1" Style="{StaticResource LabelStyle}" Text="DROPS" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0"/>
                <TextBlock Grid.Column="2" Style="{StaticResource LabelStyle}" Text="PER HOUR" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0" ToolTip="Crystals divided by the time spent in that zone. There is no drop %: Soul Crystals are rated by time in the zone, not by kill."/>
              </Grid>
            </Border>
            <Grid MinHeight="72">
              <ScrollViewer MaxHeight="206" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="PetRows" ItemTemplate="{StaticResource PetRowTemplate}"/>
              </ScrollViewer>
              <TextBlock x:Name="PetEmpty" Style="{StaticResource BodyStyle}" Foreground="{StaticResource Faint}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" MaxWidth="460"
                         Text="Soul Crystals show here by zone, with drops and per hour, so the best pet-farming spot stands out."/>
            </Grid>
          </StackPanel>

          <TextBlock x:Name="TableNote" Style="{StaticResource BodyStyle}" Foreground="{StaticResource Faint}" FontSize="12" Margin="0,8,0,0" Visibility="Collapsed"/>
        </StackPanel>
      </Border>

      <!-- status -->
      <Grid Margin="0,14,0,0">
        <TextBlock x:Name="Status" Foreground="{StaticResource Faint}" FontSize="12.5" TextTrimming="CharacterEllipsis" Margin="0,0,196,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <TextBlock FontSize="12.5"><Hyperlink x:Name="LogsLink" Style="{StaticResource LinkStyle}">Open logs</Hyperlink></TextBlock>
          <TextBlock FontSize="12.5" Margin="16,0,0,0"><Hyperlink x:Name="ResetLink" Style="{StaticResource LinkStyle}">Reset chat area</Hyperlink></TextBlock>
        </StackPanel>
      </Grid>

    </StackPanel>
  </Border>
</Window>
