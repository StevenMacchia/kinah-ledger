<Window x:Class="KinahLedger.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kinah Ledger" Width="720" SizeToContent="Height" ResizeMode="CanMinimize"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Ink}"
        FontFamily="{DynamicResource BodyFont}" FontSize="13.5"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        WindowStartupLocation="CenterScreen">

  <Window.Resources>
    <!-- the run card's stats: the figure in the display face, its label under it -->
    <Style x:Key="TileLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="Margin" Value="0,2,0,0"/>
    </Style>
    <Style x:Key="TileNumber" TargetType="TextBlock">
      <Setter Property="FontSize" Value="20"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}"/>
    </Style>
    <!-- table column headings, as the redesign's: small, bold, spaced out by size alone -->
    <Style x:Key="Th" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="{DynamicResource Faint}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="HorizontalAlignment" Value="Right"/>
      <Setter Property="Margin" Value="0,0,12,0"/>
    </Style>
    <Style x:Key="Td" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="FontFamily" Value="{DynamicResource MonoFont}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="HorizontalAlignment" Value="Right"/>
      <Setter Property="Margin" Value="0,0,12,0"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    </Style>
    <Style x:Key="FootRow" TargetType="Border">
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="Padding" Value="20,11,20,11"/>
    </Style>

    <!-- drops and gathered rows: icon, name, count, rate, per hour -->
    <DataTemplate x:Key="RowTemplate">
      <Border x:Name="RowBorder" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" MinHeight="54" Padding="0,7">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="46"/><ColumnDefinition Width="84"/><ColumnDefinition Width="58"/><ColumnDefinition Width="72"/><ColumnDefinition Width="86"/>
          </Grid.ColumnDefinitions>
          <Grid x:Name="NameCell" Margin="20,0,6,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <!-- the item's icon once it is cached; its initial until then, or when none is known -->
            <Border x:Name="IconTile" Width="40" Height="40" CornerRadius="8" BorderBrush="#6BCDD3E2" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
              <Border.Background>
                <RadialGradientBrush Center="0.5,0.4" GradientOrigin="0.5,0.4" RadiusX="0.72" RadiusY="0.72"><GradientStop Color="#38CDD3E2" Offset="0"/><GradientStop Color="#0B0E1E" Offset="1"/></RadialGradientBrush>
              </Border.Background>
              <Grid>
                <TextBlock x:Name="IconInitial" Text="{Binding Initial}" FontFamily="{DynamicResource DisplayFont}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                <Image Source="{Binding Icon.Image}" Stretch="Uniform" Margin="3" RenderOptions.BitmapScalingMode="HighQuality"/>
              </Grid>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock x:Name="NameText" Text="{Binding Name}" Foreground="#CDD3E2" FontWeight="SemiBold" FontSize="14.5" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="SubText" Text="{Binding Sub}" Foreground="{DynamicResource Faint}" FontSize="12.5" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </Grid>
          <TextBlock Grid.Column="1" Style="{StaticResource Td}" Text="{Binding Drops}"/>
          <TextBlock Grid.Column="2" Style="{StaticResource Td}" Text="{Binding DropPct}" FontFamily="{DynamicResource BodyFont}"/>
          <TextBlock Grid.Column="3" Style="{StaticResource Td}" Text="{Binding PerHour}" Foreground="{DynamicResource Muted}"/>
          <TextBlock Grid.Column="4" Style="{StaticResource Td}" Text="{Binding Price}" Foreground="{DynamicResource Gold}"/>
          <TextBlock x:Name="ValueText" Grid.Column="5" Style="{StaticResource Td}" Text="{Binding Value}" FontWeight="SemiBold" Margin="0,0,20,0"/>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Icon.Image}" Value="{x:Null}"><Setter TargetName="IconInitial" Property="Visibility" Value="Visible"/></DataTrigger>
        <DataTrigger Binding="{Binding Sub}" Value=""><Setter TargetName="SubText" Property="Visibility" Value="Collapsed"/></DataTrigger>
        <!-- a craft's profit: green when it made Kinah, red when it lost some -->
        <DataTrigger Binding="{Binding Tone}" Value="Good"><Setter TargetName="ValueText" Property="Foreground" Value="{DynamicResource Good}"/></DataTrigger>
        <DataTrigger Binding="{Binding Tone}" Value="Bad"><Setter TargetName="ValueText" Property="Foreground" Value="{DynamicResource Bad}"/></DataTrigger>
        <Trigger SourceName="RowBorder" Property="IsMouseOver" Value="True"><Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource RowHover}"/></Trigger>
        <!-- item grades in the game's own colours, in the dictionary's order: Common, Rare (green), Legend (blue), Unique (yellow), Epic (violet) -->
        <DataTrigger Binding="{Binding Grade}" Value="Rare"><Setter TargetName="NameText" Property="Foreground" Value="#62D98B"/><Setter TargetName="IconTile" Property="BorderBrush" Value="#8062D98B"/><Setter TargetName="IconTile" Property="Background"><Setter.Value><RadialGradientBrush Center="0.5,0.4" GradientOrigin="0.5,0.4" RadiusX="0.72" RadiusY="0.72"><GradientStop Color="#4262D98B" Offset="0"/><GradientStop Color="#0B0E1E" Offset="1"/></RadialGradientBrush></Setter.Value></Setter></DataTrigger>
        <DataTrigger Binding="{Binding Grade}" Value="Legend"><Setter TargetName="NameText" Property="Foreground" Value="#5AA6FF"/><Setter TargetName="IconTile" Property="BorderBrush" Value="#805AA6FF"/><Setter TargetName="IconTile" Property="Background"><Setter.Value><RadialGradientBrush Center="0.5,0.4" GradientOrigin="0.5,0.4" RadiusX="0.72" RadiusY="0.72"><GradientStop Color="#425AA6FF" Offset="0"/><GradientStop Color="#0B0E1E" Offset="1"/></RadialGradientBrush></Setter.Value></Setter></DataTrigger>
        <DataTrigger Binding="{Binding Grade}" Value="Unique"><Setter TargetName="NameText" Property="Foreground" Value="#F3D35E"/><Setter TargetName="IconTile" Property="BorderBrush" Value="#80F3D35E"/><Setter TargetName="IconTile" Property="Background"><Setter.Value><RadialGradientBrush Center="0.5,0.4" GradientOrigin="0.5,0.4" RadiusX="0.72" RadiusY="0.72"><GradientStop Color="#42F3D35E" Offset="0"/><GradientStop Color="#0B0E1E" Offset="1"/></RadialGradientBrush></Setter.Value></Setter></DataTrigger>
        <DataTrigger Binding="{Binding Grade}" Value="Epic"><Setter TargetName="NameText" Property="Foreground" Value="#B48BFF"/><Setter TargetName="IconTile" Property="BorderBrush" Value="#80B48BFF"/><Setter TargetName="IconTile" Property="Background"><Setter.Value><RadialGradientBrush Center="0.5,0.4" GradientOrigin="0.5,0.4" RadiusX="0.72" RadiusY="0.72"><GradientStop Color="#42B48BFF" Offset="0"/><GradientStop Color="#0B0E1E" Offset="1"/></RadialGradientBrush></Setter.Value></Setter></DataTrigger>
        <!-- a group row inside a table (a gathering skill, the Soul Crystals): its own line across the whole row -->
        <DataTrigger Binding="{Binding Header}" Value="True">
          <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource RowHead}"/>
          <Setter TargetName="RowBorder" Property="MinHeight" Value="32"/>
          <Setter TargetName="RowBorder" Property="Padding" Value="0,4"/>
          <Setter TargetName="IconTile" Property="Visibility" Value="Collapsed"/>
          <Setter TargetName="SubText" Property="Visibility" Value="Collapsed"/>
          <Setter TargetName="NameCell" Property="Grid.ColumnSpan" Value="6"/>
          <Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource Gold}"/>
          <Setter TargetName="NameText" Property="FontSize" Value="11.5"/>
          <Setter TargetName="NameText" Property="FontWeight" Value="Bold"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

  </Window.Resources>

  <Border x:Name="Root" Background="{DynamicResource Bg}" Padding="22,16,22,14">
    <StackPanel>

      <!-- header: the gold mark and the name, the Farming / Crafting switch, the project page and Settings -->
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <!-- the app mark, as the site draws it: a gold tile with the coin -->
          <Border Width="30" Height="30" CornerRadius="9" Margin="0,0,10,0" VerticalAlignment="Center">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#F8D598" Offset="0"/><GradientStop Color="#EBAE4C" Offset="0.45"/><GradientStop Color="#B9781F" Offset="1"/></LinearGradientBrush>
            </Border.Background>
            <Path Data="M12,3 L20,8 L20,16 L12,21 L4,16 L4,8 Z M12,8 L12,16 M8.5,10 L12,12 L15.5,10" Stroke="#2A1A04" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="17" Height="17" Stretch="Uniform"/>
          </Border>
          <TextBlock Text="Kinah Ledger" FontFamily="{DynamicResource DisplayFont}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
          <TextBlock x:Name="Version" Text="v0.7.1" Foreground="{DynamicResource Faint}" VerticalAlignment="Center" Margin="10,2,0,0" FontSize="11.5"/>
        </StackPanel>
        <!-- two parts that never mix: Farming (the run, the stats, the loot) and Crafting (recipes, cost, success, profit) -->
        <Border x:Name="PartTabs" Grid.Column="1" HorizontalAlignment="Right" Margin="0,0,10,0" Padding="3" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource LineStrong}" Background="#08FFFFFF" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <Button x:Name="FarmTab" Style="{StaticResource SegOn}" Content="Farming"/>
            <Button x:Name="CraftTab" Style="{StaticResource SegOff}" Content="Crafting" Margin="2,0,0,0"/>
          </StackPanel>
        </Border>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"><Hyperlink x:Name="SiteLink" Style="{StaticResource LinkStyle}">Project page</Hyperlink></TextBlock>
          <!-- everything that needs setting lives behind this button; the main window is the live count -->
          <Button x:Name="SettingsBtn" Content="Settings" Height="36" Padding="14,0" FontSize="13.5"/>
        </StackPanel>
      </Grid>
      <TextBlock x:Name="Tagline" Style="{StaticResource BodyStyle}" FontSize="12.5" Margin="0,6,0,0"
                 Text="Unofficial Aion 2 farming tracker. Reads the loot lines from the chat on your screen while the game is open. Nothing touches the game."/>

      <!-- first run: region, faction, server and a look, before anything else. Everything shared is filed per server. -->
      <Border x:Name="WelcomeCard" Style="{StaticResource CardStyle}" Margin="0,14,0,0" Padding="22,20,22,20" Visibility="Collapsed">
        <StackPanel>
          <TextBlock Text="Welcome. Where do you play?" FontFamily="{DynamicResource DisplayFont}" FontSize="18" FontWeight="Bold"/>
          <TextBlock Style="{StaticResource BodyStyle}" Margin="0,6,0,0" Text="Everything the tracker shares is filed per server, so this comes first. Three taps and you are in; change any of it later under Settings."/>
          <TextBlock Style="{StaticResource LabelStyle}" Text="REGION" Margin="0,16,0,8"/>
          <WrapPanel x:Name="RegionChips"/>
          <TextBlock Style="{StaticResource LabelStyle}" Text="FACTION" Margin="0,8,0,8"/>
          <WrapPanel x:Name="FactionChips"/>
          <TextBlock Style="{StaticResource LabelStyle}" Text="SERVER" Margin="0,8,0,8"/>
          <WrapPanel x:Name="ServerChips"/>
          <TextBlock x:Name="WelcomeHint" Style="{StaticResource BodyStyle}" FontSize="12.5" Margin="0,2,0,0"/>
          <TextBlock Style="{StaticResource LabelStyle}" Text="LOOK" Margin="0,12,0,8"/>
          <WrapPanel x:Name="SkinChips"/>
          <Grid Margin="0,14,0,0">
            <TextBlock Style="{StaticResource BodyStyle}" FontSize="12" VerticalAlignment="Center" MaxWidth="300" HorizontalAlignment="Left" Text="Nothing is read or shared until you continue. The chat and the zone are found on their own."/>
            <Button x:Name="WelcomeGo" Style="{StaticResource PrimaryButton}" Content="Continue" Width="160" Height="44" HorizontalAlignment="Right" VerticalAlignment="Center"/>
          </Grid>
        </StackPanel>
      </Border>

      <!-- settings: server, sharing, chat and zone, Market, look. Hidden once set up; the Settings button brings it back. -->
      <Border x:Name="SetupCard" Style="{StaticResource CardStyle}" Margin="0,14,0,0" Padding="18,14,18,16">
        <StackPanel>
          <TextBlock Style="{StaticResource LabelStyle}" Text="SERVER"/>
          <WrapPanel x:Name="ServerRow" Margin="0,8,0,0">
            <TextBlock x:Name="ServerLabel" Text="Your server" Foreground="{DynamicResource Muted}" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,6" Visibility="Collapsed"/>
            <ComboBox x:Name="RegionBox" Width="138" FontSize="13" Margin="0,0,8,6" VerticalAlignment="Center" ToolTip="The region you play in. The same server names exist in every region, so both parts matter."/>
            <ComboBox x:Name="ServerPick" Width="190" FontSize="13" Margin="0,0,12,6" VerticalAlignment="Center" ToolTip="Your home server and faction, as the game's server list shows them."/>
            <TextBlock x:Name="ServerHint" Style="{StaticResource BodyStyle}" FontSize="12" LineHeight="16" VerticalAlignment="Center" Margin="0,0,0,6" MaxWidth="500"/>
          </WrapPanel>

          <TextBlock Style="{StaticResource LabelStyle}" Text="SHARING" Margin="0,12,0,0"/>
          <WrapPanel x:Name="OptsRow" Margin="0,8,0,0">
            <CheckBox x:Name="ShareChk" Content="Share runs and Market prices anonymously" Margin="0,0,6,4"/>
            <TextBlock Margin="0,0,16,4" VerticalAlignment="Center" FontSize="13"><Hyperlink x:Name="SentLink" Style="{StaticResource LinkStyle}">what's sent?</Hyperlink></TextBlock>
            <CheckBox x:Name="HudChk" Content="Panel over the game (drag it anywhere)" Margin="0,0,12,4"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4" VerticalAlignment="Center">
              <TextBlock Text="Panel opacity" FontSize="12.5" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <Slider x:Name="HudOpacity" Width="120" Minimum="0.3" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center" ToolTip="How solid the panel over the game is"/>
              <TextBlock x:Name="HudOpacityLbl" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="8,0,0,0" Width="34"/>
            </StackPanel>
          </WrapPanel>
          <!-- optional: ties this PC's runs to a profile on the site; runs stay anonymous without it -->
          <WrapPanel x:Name="LinkRow" Margin="0,8,0,0">
            <Button x:Name="LinkBtn" Content="Link to my profile on the site" Width="232" Margin="0,0,12,4"
                    ToolTip="Opens kinahledger.com with this PC's link code. Sign in with Discord if asked, and the runs this PC shares show on your profile. Runs stay anonymous in the public tables either way."/>
            <TextBlock VerticalAlignment="Center" Margin="0,0,0,4" FontSize="12.5" Foreground="{DynamicResource Muted}"
                       ToolTip="The same code, for pasting by hand into Profile › Link your tracker."><Run Text="code "/><Run x:Name="LinkCodeRun" FontFamily="Consolas" FontSize="13" Foreground="{DynamicResource Gold}"/><Run Text="   "/><Hyperlink x:Name="CopyCodeLink" Style="{StaticResource LinkStyle}">copy</Hyperlink></TextBlock>
          </WrapPanel>

          <TextBlock Style="{StaticResource LabelStyle}" Text="CHAT AND ZONE" Margin="0,14,0,0"/>
          <TextBlock x:Name="Step2Status" Style="{StaticResource BodyStyle}" FontSize="12.5" LineHeight="17" Margin="0,6,0,0"/>
          <WrapPanel Margin="0,10,0,0">
            <Button x:Name="DetectBtn" Content="Detect now" Width="104" Margin="0,0,8,6"/>
            <Button x:Name="PickBtn" Content="Choose the chat" Width="124" Margin="0,0,8,6"/>
            <Button x:Name="TestBtn" Content="Test read" Width="96" Margin="0,0,8,6"/>
            <TextBlock FontSize="12.5" VerticalAlignment="Center" Margin="4,0,0,6"><Hyperlink x:Name="ResetLink" Style="{StaticResource LinkStyle}">back to automatic</Hyperlink></TextBlock>
          </WrapPanel>
          <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Height="118" ClipToBounds="True" Margin="0,6,0,0">
            <Grid>
              <TextBlock x:Name="PreviewHint" Text="the game, with the chat, the map and the Market outlined" Foreground="{DynamicResource Faint}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="12,0"/>
              <Image x:Name="Preview" Stretch="Uniform" Margin="3" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Grid>
          </Border>
          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <Border Width="10" Height="10" CornerRadius="2" Background="{DynamicResource Accent}" VerticalAlignment="Center"/>
            <TextBlock Text="chat" Style="{StaticResource LabelStyle}" Margin="5,0,12,0"/>
            <Border Width="10" Height="10" CornerRadius="2" Background="{DynamicResource Gold}" VerticalAlignment="Center"/>
            <TextBlock Text="zone" Style="{StaticResource LabelStyle}" Margin="5,0,12,0"/>
            <Border Width="10" Height="10" CornerRadius="2" Background="{DynamicResource Mint}" VerticalAlignment="Center"/>
            <TextBlock Text="market" Style="{StaticResource LabelStyle}" Margin="5,0,0,0"/>
          </StackPanel>

          <TextBlock Style="{StaticResource LabelStyle}" Text="MARKET PRICES" Margin="0,14,0,0"/>
          <WrapPanel x:Name="MarketRow" Margin="0,6,0,0">
            <TextBlock Style="{StaticResource BodyStyle}" FontSize="12.5" LineHeight="17" Margin="0,0,6,4" VerticalAlignment="Center" MaxWidth="500" Text="Whenever you open the Market, the listings on your screen are shared as anonymous asks, under the Share switch above. Nothing to set up."/>
            <TextBlock Margin="0,0,0,4" VerticalAlignment="Center" FontSize="13"><Hyperlink x:Name="MarketSentLink" Style="{StaticResource LinkStyle}">what's read?</Hyperlink></TextBlock>
          </WrapPanel>
          <WrapPanel x:Name="MarketRow2" Margin="0,4,0,0">
            <Button x:Name="MarketPickBtn" Content="Choose the Market" Width="140" FontSize="12.5" Margin="0,0,10,4" VerticalAlignment="Center"/>
            <TextBlock x:Name="MarketResetText" Margin="0,0,0,4" VerticalAlignment="Center" FontSize="12.5" Visibility="Collapsed"><Hyperlink x:Name="MarketResetLink" Style="{StaticResource LinkStyle}">back to automatic</Hyperlink></TextBlock>
          </WrapPanel>
          <TextBlock x:Name="MarketStatus" Style="{StaticResource BodyStyle}" FontSize="12" LineHeight="16" Margin="0,4,0,0"
                     Text="Waiting for the game. While the game and this window are open, the Market is read whenever you open it."/>

          <TextBlock Style="{StaticResource LabelStyle}" Text="LOOK" Margin="0,14,0,8"/>
          <WrapPanel x:Name="SkinRow"/>
        </StackPanel>
      </Border>

      <!-- the run, as the site's "best place to farm it" card: where you are, how long, what the hour is worth, the stats,
           then the actions. Everything is counted all the time; Start farming times a run on top and shows it -->
      <Border x:Name="SessionCard" CornerRadius="22" Margin="0,16,0,0" Padding="24,22,24,22" BorderThickness="1" BorderBrush="#52EBAE4C">
        <Border.Background>
          <RadialGradientBrush Center="1,0" GradientOrigin="1,0" RadiusX="0.95" RadiusY="1.35"><GradientStop Color="#3A3323" Offset="0"/><GradientStop Color="#171C38" Offset="0.62"/><GradientStop Color="#12162D" Offset="1"/></RadialGradientBrush>
        </Border.Background>
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="RecDot" Width="8" Height="8" Fill="#FF6B5E" Margin="0,0,8,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                <TextBlock x:Name="TableTitle" Foreground="{DynamicResource Gold}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Text="Open world"/>
              </StackPanel>
              <TextBlock x:Name="ZoneLbl" FontFamily="{DynamicResource DisplayFont}" FontSize="27" FontWeight="SemiBold" Margin="0,8,0,0" Text="Waiting for the game" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="FarmTime" Foreground="{DynamicResource Muted}" FontSize="14" Margin="0,4,0,0" Text="Ctrl+Shift+K starts and stops from inside the game" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="16,0,0,0" HorizontalAlignment="Right">
              <Border Style="{StaticResource Chip}" HorizontalAlignment="Right">
                <TextBlock x:Name="TableWhat" Foreground="{DynamicResource Mint}" FontSize="11.5" FontWeight="SemiBold"/>
              </Border>
              <TextBlock x:Name="HeadRate" FontFamily="{DynamicResource DisplayFont}" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,8,0,0"/>
              <TextBlock Text="Kinah plus loot, after tax" Foreground="{DynamicResource Faint}" FontSize="12.5" HorizontalAlignment="Right" Margin="0,2,0,0"/>
            </StackPanel>
          </Grid>

          <!-- the stats, in the inset box the item page uses for "How many kills to expect". Element names stay from the tiles -->
          <Border x:Name="Tiles" Margin="0,20,0,0" Padding="18,14,18,14" CornerRadius="14" Background="#38000000" BorderBrush="{DynamicResource Line}" BorderThickness="1">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock x:Name="KinahHr" Style="{StaticResource TileNumber}" Foreground="{DynamicResource Gold}" Text="0"/><TextBlock x:Name="Tile1Label" Style="{StaticResource TileLabel}" Text="Kinah/hr"/></StackPanel>
              <StackPanel Grid.Column="1"><TextBlock x:Name="KinahKill" Style="{StaticResource TileNumber}" Foreground="{DynamicResource Gold}" Text="—"/><TextBlock x:Name="Tile2Label" Style="{StaticResource TileLabel}" Text="Kinah/kill"/></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock x:Name="KillsHr" Style="{StaticResource TileNumber}" Text="0"/><TextBlock x:Name="Tile3Label" Style="{StaticResource TileLabel}" Text="kills/hr"/></StackPanel>
              <StackPanel Grid.Column="3"><TextBlock x:Name="DropsHr" Style="{StaticResource TileNumber}" Text="0"/><TextBlock x:Name="Tile4Label" Style="{StaticResource TileLabel}" Text="drops/hr"/></StackPanel>
              <!-- the hour's total shows big at the top right; this keeps its figure and its pricing tooltip for the code -->
              <StackPanel x:Name="ValueTile" Visibility="Collapsed"><TextBlock x:Name="ValueHr" Text="—"/><TextBlock x:Name="Tile5Label" Text="total/hr"/></StackPanel>
            </Grid>
          </Border>

          <Grid Margin="0,18,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Button x:Name="StartBtn" Style="{StaticResource PrimaryButton}" Content="Start farming" Width="156" Height="46" VerticalAlignment="Center"/>
            <StackPanel x:Name="KindGrid" Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
              <ComboBox x:Name="Kind" Width="140" VerticalAlignment="Center" ToolTip="What the run is labelled as when it is shared and saved. The count itself covers everything the chat shows."/>
              <!-- off (the default): the tables start over when the zone changes; on: they keep counting across zones. The site gets each zone's own numbers either way -->
              <CheckBox x:Name="AllZonesChk" Content="All zones" Margin="14,0,0,0" VerticalAlignment="Center"
                        ToolTip="Off: the tables start over when you change zone, so they show this zone only. On: they keep counting across every zone. Either way, what goes to the site is kept apart by zone."/>
            </StackPanel>
            <TextBlock Grid.Column="2" Text="Ctrl+Shift+K in game" Foreground="{DynamicResource Faint}" FontSize="12.5" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="12,0,0,0"/>
          </Grid>
          <TextBlock x:Name="KindHint" Style="{StaticResource BodyStyle}" FontSize="12.5" LineHeight="17" Margin="0,10,0,0" Visibility="Collapsed"/>
        </StackPanel>
      </Border>

      <!-- one table at a time: Drops or Gathered, picked by the tabs. The tables grow with what's farmed and the
           window with them; a table only scrolls once it would run past the bottom of the screen -->

      <Border x:Name="TablesCard" Style="{StaticResource CardStyle}" Margin="0,16,0,0" Padding="0,8,0,0">
        <StackPanel x:Name="TableStack">
          <!-- idle time and skipped reward lines; net Kinah, crafts and sales: each shown only once there is something to say -->
          <TextBlock x:Name="Summary" Foreground="{DynamicResource Faint}" FontSize="12.5" Margin="20,8,20,4" TextWrapping="Wrap" Visibility="Collapsed"/>
          <TextBlock x:Name="ExtraLine" Foreground="{DynamicResource Faint}" FontSize="12.5" Margin="20,4,20,4" TextWrapping="Wrap" Visibility="Collapsed"/>

          <!-- both sections show at once (a run is often kills and nodes together); a click on a header folds that section -->
          <StackPanel x:Name="DropsSection">
            <Border x:Name="DropsHead" Background="Transparent" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Height="44" Cursor="Hand" ToolTip="Click to fold or unfold">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/><ColumnDefinition Width="46"/><ColumnDefinition Width="84"/><ColumnDefinition Width="58"/><ColumnDefinition Width="72"/><ColumnDefinition Width="86"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                  <TextBlock x:Name="DropsChev" Style="{StaticResource Th}" Text="▾" Width="14" Margin="0" HorizontalAlignment="Left"/>
                  <TextBlock x:Name="DropsTitle" Style="{StaticResource Th}" Text="LOOT FROM KILLS" Margin="0" HorizontalAlignment="Left"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Style="{StaticResource Th}" Text="QTY"/>
                <TextBlock x:Name="PctHeader" Grid.Column="2" Style="{StaticResource Th}" Text="ODDS" ToolTip="How many kills one drop takes, as the site shows it: drops divided by kills. Kills are counted from Kinah or Soul Point pickups (one per mob), or from kill lines when the chat shows them."/>
                <TextBlock Grid.Column="3" Style="{StaticResource Th}" Text="PER HR"/>
                <TextBlock Grid.Column="4" Style="{StaticResource Th}" Text="PRICE" ToolTip="The lowest Market price on your server for one: what you and other players saw on the Market, with the site's price board filling in. A dash means no price is known yet."/>
                <TextBlock Grid.Column="5" Style="{StaticResource Th}" Text="VALUE" Margin="0,0,20,0" ToolTip="Quantity times price, before the Market's fee and tax. Bound items can't be sold and have no value here."/>
              </Grid>
            </Border>
            <Grid x:Name="DropsBody" MinHeight="64">
              <ScrollViewer x:Name="DropsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="Rows" ItemTemplate="{StaticResource RowTemplate}"/>
              </ScrollViewer>
              <TextBlock x:Name="TableEmpty" Style="{StaticResource BodyStyle}" FontSize="12.5" Foreground="{DynamicResource Faint}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" MaxWidth="420"
                         Text="Drops show here as they're read, with the drop rate per kill and per hour."/>
            </Grid>
          </StackPanel>

          <StackPanel x:Name="GatherSection">
            <Border x:Name="GatherHead" Background="Transparent" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Height="44" Cursor="Hand" ToolTip="Click to fold or unfold">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/><ColumnDefinition Width="46"/><ColumnDefinition Width="84"/><ColumnDefinition Width="58"/><ColumnDefinition Width="72"/><ColumnDefinition Width="86"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                  <TextBlock x:Name="GatherChev" Style="{StaticResource Th}" Text="▾" Width="14" Margin="0" HorizontalAlignment="Left"/>
                  <TextBlock x:Name="GatherTitle" Style="{StaticResource Th}" Text="GATHERED" Margin="0" HorizontalAlignment="Left"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Style="{StaticResource Th}" Text="QTY"/>
                <TextBlock Grid.Column="2" Style="{StaticResource Th}" Text="PER TRY" ToolTip="Count divided by attempts. Every ore, log, Odyle, herb or food line counts as one attempt, failed gathers too."/>
                <TextBlock Grid.Column="3" Style="{StaticResource Th}" Text="PER HR"/>
                <TextBlock Grid.Column="4" Style="{StaticResource Th}" Text="PRICE" ToolTip="The lowest Market price on your server for one: what you and other players saw on the Market, with the site's price board filling in. A dash means no price is known yet."/>
                <TextBlock Grid.Column="5" Style="{StaticResource Th}" Text="VALUE" Margin="0,0,20,0" ToolTip="Quantity times price, before the Market's fee and tax."/>
              </Grid>
            </Border>
            <Grid x:Name="GatherBody" MinHeight="64">
              <ScrollViewer x:Name="GatherScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="GatherRows" ItemTemplate="{StaticResource RowTemplate}"/>
              </ScrollViewer>
              <TextBlock x:Name="GatherEmpty" Style="{StaticResource BodyStyle}" FontSize="12.5" Foreground="{DynamicResource Faint}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" MaxWidth="420"
                         Text="Gathered materials show here, with how often each comes per attempt and per hour."/>
            </Grid>
          </StackPanel>

          <!-- Kinah by enemy: what landed within a few seconds of the target bar naming an enemy. A guess, and labelled one -->
          <StackPanel x:Name="MobSection">
            <Border x:Name="MobHead" Background="Transparent" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Height="44" Cursor="Hand" ToolTip="Click to fold or unfold">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/><ColumnDefinition Width="46"/><ColumnDefinition Width="84"/><ColumnDefinition Width="58"/><ColumnDefinition Width="72"/><ColumnDefinition Width="86"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                  <TextBlock x:Name="MobChev" Style="{StaticResource Th}" Text="▾" Width="14" Margin="0" HorizontalAlignment="Left"/>
                  <TextBlock x:Name="MobTitle" Style="{StaticResource Th}" Text="KINAH BY ENEMY · BEST GUESS" Margin="0" HorizontalAlignment="Left"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Style="{StaticResource Th}" Text="KILLS"/>
                <TextBlock Grid.Column="2" Style="{StaticResource Th}" Text="PER KILL"/>
                <TextBlock Grid.Column="3" Style="{StaticResource Th}" Text="PER HR"/>
                <TextBlock Grid.Column="5" Style="{StaticResource Th}" Text="KINAH" Margin="0,0,20,0"/>
              </Grid>
            </Border>
            <Grid x:Name="MobBody" MinHeight="64">
              <ScrollViewer x:Name="MobScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="MobRows" ItemTemplate="{StaticResource RowTemplate}"/>
              </ScrollViewer>
              <TextBlock x:Name="MobEmpty" Style="{StaticResource BodyStyle}" FontSize="12.5" Foreground="{DynamicResource Faint}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" MaxWidth="440"
                         Text="A best guess: the Kinah that lands just after the target bar names an enemy. With several enemies on you, the bar shows only one."/>
            </Grid>
            <!-- the enemy pictures are MetaBot.GG's copies of the game portraits; its terms ask for a link back -->
            <TextBlock x:Name="MobCredit" FontSize="11" Foreground="{DynamicResource Faint}" Margin="16,4,16,6" Visibility="Collapsed">
              <Run Text="Enemy pictures from "/><Hyperlink x:Name="MobCreditLink" Style="{StaticResource LinkStyle}">MetaBot.GG</Hyperlink>
            </TextBlock>
          </StackPanel>

          <!-- the totals, like the site's session summary footer: loot before tax, the Market's cut, Kinah, the session total -->
          <Border x:Name="Foot" Background="{DynamicResource Card2}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="0,1,0,0" CornerRadius="0,0,17,17">
            <StackPanel>
              <Border Style="{StaticResource FootRow}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Text="Loot before tax" FontWeight="SemiBold"/>
                  <TextBlock x:Name="FootLootNote" Grid.Column="1" Foreground="{DynamicResource Muted}" Margin="14,0,12,0" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right"/>
                  <TextBlock x:Name="FootLoot" Grid.Column="2" FontWeight="SemiBold" Text="—"/></Grid>
              </Border>
              <Border Style="{StaticResource FootRow}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock x:Name="FootTaxLbl" Foreground="{DynamicResource Muted}" Text="Market fee and tax"/>
                  <TextBlock x:Name="FootTax" Grid.Column="2" Foreground="{DynamicResource Bad}" Text="—"/></Grid>
              </Border>
              <Border Style="{StaticResource FootRow}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Text="Kinah" FontWeight="SemiBold"/>
                  <TextBlock x:Name="FootKinahNote" Grid.Column="1" Foreground="{DynamicResource Muted}" Margin="14,0,12,0" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right"/>
                  <TextBlock x:Name="FootKinah" Grid.Column="2" FontWeight="SemiBold" Foreground="{DynamicResource Gold}" Text="0"/></Grid>
              </Border>
              <Border Style="{StaticResource FootRow}" BorderThickness="0">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Text="SESSION TOTAL" Foreground="{DynamicResource Gold}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                  <TextBlock x:Name="FootTotalNote" Grid.Column="1" Foreground="{DynamicResource Muted}" Margin="14,0,12,0" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                  <TextBlock x:Name="FootTotal" Grid.Column="2" FontFamily="{DynamicResource DisplayFont}" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource Gold}" Text="0" VerticalAlignment="Center"/></Grid>
              </Border>
            </StackPanel>
          </Border>

          <TextBlock x:Name="TableNote" Style="{StaticResource BodyStyle}" Foreground="{DynamicResource Faint}" FontSize="11.5" Margin="16,8,16,10" Visibility="Collapsed"/>
        </StackPanel>
      </Border>

      <!-- Crafting: every recipe crafted since the tracker started, with what a try costs, how often it worked, what came
           out and what that sells for. Crafted items never count as drops, and crafting is never farming time. -->
      <Border x:Name="CraftCard" Style="{StaticResource CardStyle}" Margin="0,16,0,0" Padding="0,8,0,0" Visibility="Collapsed">
        <StackPanel>
          <Grid Margin="16,12,16,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock FontFamily="{DynamicResource DisplayFont}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" VerticalAlignment="Center" Text="Crafting"/>
            <TextBlock x:Name="CraftWhat" Grid.Column="1" Foreground="{DynamicResource Faint}" FontSize="12" VerticalAlignment="Center" Margin="10,2,0,0" TextTrimming="CharacterEllipsis"/>
            <TextBlock Grid.Column="2" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"><Hyperlink x:Name="CraftResetLink" Style="{StaticResource LinkStyle}">Start over</Hyperlink></TextBlock>
          </Grid>
          <Border Background="Transparent" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Height="44">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="46"/><ColumnDefinition Width="84"/><ColumnDefinition Width="58"/><ColumnDefinition Width="72"/><ColumnDefinition Width="86"/>
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource Th}" Text="RECIPE · WHAT CAME OUT" Margin="20,0,0,0" HorizontalAlignment="Left"/>
              <TextBlock Grid.Column="1" Style="{StaticResource Th}" Text="TRIES"/>
              <TextBlock Grid.Column="2" Style="{StaticResource Th}" Text="SUCCESS" ToolTip="Tries that worked, out of all tries. The recipe's listed rate at the required mastery is shown under the recipe."/>
              <TextBlock Grid.Column="3" Style="{StaticResource Th}" Text="COST/TRY" ToolTip="The recipe's materials at the lowest Market prices on your server. A failed try uses them too."/>
              <TextBlock Grid.Column="4" Style="{StaticResource Th}" Text="SELLS FOR" ToolTip="What one of the item sells for at the lowest Market price, after the Market's fee and tax."/>
              <TextBlock Grid.Column="5" Style="{StaticResource Th}" Text="PROFIT" Margin="0,0,20,0" ToolTip="What came out, at Market prices after the Market's cut, minus the cost of every try."/>
            </Grid>
          </Border>
          <Grid MinHeight="64">
            <ScrollViewer x:Name="CraftScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl x:Name="CraftRows" ItemTemplate="{StaticResource RowTemplate}"/>
            </ScrollViewer>
            <TextBlock x:Name="CraftEmpty" Style="{StaticResource BodyStyle}" FontSize="12.5" Foreground="{DynamicResource Faint}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" MaxWidth="440"
                       Text="Craft something in the game. Each recipe shows here with what a try costs, how often it worked, what came out and what that sells for."/>
          </Grid>
          <Border Background="{DynamicResource Card2}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="0,1,0,0" CornerRadius="0,0,17,17">
            <StackPanel>
              <Border Style="{StaticResource FootRow}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Text="Spent on materials" FontWeight="SemiBold"/>
                  <TextBlock x:Name="CraftSpentNote" Grid.Column="1" Foreground="{DynamicResource Muted}" Margin="14,0,12,0" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right"/>
                  <TextBlock x:Name="CraftSpent" Grid.Column="2" FontWeight="SemiBold" Foreground="{DynamicResource Bad}" Text="—"/></Grid>
              </Border>
              <Border Style="{StaticResource FootRow}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Text="What came out sells for" FontWeight="SemiBold"/>
                  <TextBlock x:Name="CraftMadeNote" Grid.Column="1" Foreground="{DynamicResource Muted}" Margin="14,0,12,0" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right"/>
                  <TextBlock x:Name="CraftMade" Grid.Column="2" FontWeight="SemiBold" Foreground="{DynamicResource Gold}" Text="—"/></Grid>
              </Border>
              <Border Style="{StaticResource FootRow}" BorderThickness="0">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Text="Profit" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  <TextBlock x:Name="CraftProfitNote" Grid.Column="1" Foreground="{DynamicResource Muted}" Margin="14,0,12,0" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                  <TextBlock x:Name="CraftProfit" Grid.Column="2" FontFamily="{DynamicResource DisplayFont}" FontSize="26" FontWeight="SemiBold" Text="—" VerticalAlignment="Center"/></Grid>
              </Border>
            </StackPanel>
          </Border>
          <!-- the recipes come from MetaBot.GG, whose terms ask for a link to the page they came from -->
          <TextBlock Style="{StaticResource BodyStyle}" Foreground="{DynamicResource Faint}" FontSize="11.5" Margin="16,8,16,10" TextWrapping="Wrap">
            <Run x:Name="CraftNote" Text="Prices are the lowest on the Market for your server. "/><Run Text="Recipes from "/><Hyperlink x:Name="CraftCreditLink" Style="{StaticResource LinkStyle}">MetaBot.GG</Hyperlink><Run Text="."/>
          </TextBlock>
        </StackPanel>
      </Border>

      <!-- status -->
      <Grid x:Name="StatusRow" Margin="0,14,0,0">
        <TextBlock x:Name="Status" Foreground="{DynamicResource Faint}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,0,80,0"/>
        <TextBlock FontSize="12" HorizontalAlignment="Right"><Hyperlink x:Name="LogsLink" Style="{StaticResource LinkStyle}">Open logs</Hyperlink></TextBlock>
      </Grid>

    </StackPanel>
  </Border>
</Window>
