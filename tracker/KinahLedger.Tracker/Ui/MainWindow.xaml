<Window x:Class="KinahLedger.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kinah Ledger" Width="600" SizeToContent="Height" ResizeMode="CanMinimize"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Ink}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        WindowStartupLocation="CenterScreen">

  <Window.Resources>
    <!-- drops and gathered rows: icon, name, count, rate, per hour -->
    <DataTemplate x:Key="RowTemplate">
      <Border x:Name="RowBorder" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Height="32">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="72"/><ColumnDefinition Width="92"/><ColumnDefinition Width="92"/>
          </Grid.ColumnDefinitions>
          <Grid x:Name="NameCell" Margin="8,0,6,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <!-- the item's icon once it is cached; its initial until then, or when none is known -->
            <Border x:Name="IconTile" Width="22" Height="22" CornerRadius="5" Background="{DynamicResource Card2}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1" Margin="0,0,8,0" VerticalAlignment="Center">
              <Grid>
                <TextBlock x:Name="IconInitial" Text="{Binding Initial}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                <Image Source="{Binding Icon.Image}" Stretch="Uniform" Margin="1" RenderOptions.BitmapScalingMode="HighQuality"/>
              </Grid>
            </Border>
            <TextBlock x:Name="NameText" Grid.Column="1" Text="{Binding Name}" Foreground="{DynamicResource Ink}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="13"/>
          </Grid>
          <TextBlock Grid.Column="1" Text="{Binding Drops}" Foreground="{DynamicResource Ink}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0" FontSize="13"/>
          <TextBlock Grid.Column="2" Text="{Binding DropPct}" Foreground="{DynamicResource Mint}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0" FontSize="13"/>
          <TextBlock Grid.Column="3" Text="{Binding PerHour}" Foreground="{DynamicResource Violet}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0" FontSize="13"/>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Icon.Image}" Value="{x:Null}"><Setter TargetName="IconInitial" Property="Visibility" Value="Visible"/></DataTrigger>
        <Trigger SourceName="RowBorder" Property="IsMouseOver" Value="True"><Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource RowHover}"/></Trigger>
        <!-- item grades in the game's own colours, in the dictionary's order: Common, Rare (green), Legend (blue), Unique (yellow), Epic (violet) -->
        <DataTrigger Binding="{Binding Grade}" Value="Rare"><Setter TargetName="NameText" Property="Foreground" Value="#5FE08A"/><Setter TargetName="IconTile" Property="BorderBrush" Value="#995FE08A"/></DataTrigger>
        <DataTrigger Binding="{Binding Grade}" Value="Legend"><Setter TargetName="NameText" Property="Foreground" Value="#5FA8FF"/><Setter TargetName="IconTile" Property="BorderBrush" Value="#995FA8FF"/></DataTrigger>
        <DataTrigger Binding="{Binding Grade}" Value="Unique"><Setter TargetName="NameText" Property="Foreground" Value="#F5D05A"/><Setter TargetName="IconTile" Property="BorderBrush" Value="#99F5D05A"/></DataTrigger>
        <DataTrigger Binding="{Binding Grade}" Value="Epic"><Setter TargetName="NameText" Property="Foreground" Value="#C88CFF"/><Setter TargetName="IconTile" Property="BorderBrush" Value="#99C88CFF"/></DataTrigger>
        <!-- a skill header row inside the gathered table: its own attempts, failures and Plentiful rate, across the whole row -->
        <DataTrigger Binding="{Binding Header}" Value="True">
          <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource RowHead}"/>
          <Setter TargetName="RowBorder" Property="Height" Value="28"/>
          <Setter TargetName="IconTile" Property="Visibility" Value="Collapsed"/>
          <Setter TargetName="NameCell" Property="Grid.ColumnSpan" Value="4"/>
          <Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource Gold}"/>
          <Setter TargetName="NameText" Property="FontWeight" Value="SemiBold"/>
          <Setter TargetName="NameText" Property="FontSize" Value="11.5"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- pets: name, drops, per hour. No drop % column: Soul Crystals are rated by time in the zone, never by kill. -->
    <DataTemplate x:Key="PetRowTemplate">
      <Border x:Name="RowBorder" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Height="32">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="80"/><ColumnDefinition Width="100"/>
          </Grid.ColumnDefinitions>
          <Grid x:Name="NameCell" Margin="8,0,6,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border x:Name="IconTile" Width="22" Height="22" CornerRadius="5" Background="{DynamicResource Card2}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1" Margin="0,0,8,0" VerticalAlignment="Center">
              <Grid>
                <TextBlock x:Name="IconInitial" Text="{Binding Initial}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                <Image Source="{Binding Icon.Image}" Stretch="Uniform" Margin="1" RenderOptions.BitmapScalingMode="HighQuality"/>
              </Grid>
            </Border>
            <TextBlock x:Name="NameText" Grid.Column="1" Text="{Binding Name}" Foreground="{DynamicResource Ink}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="13"/>
          </Grid>
          <TextBlock Grid.Column="1" Text="{Binding Drops}" Foreground="{DynamicResource Ink}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0" FontSize="13"/>
          <TextBlock Grid.Column="2" Text="{Binding PerHour}" Foreground="{DynamicResource Violet}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0" FontSize="13"/>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Icon.Image}" Value="{x:Null}"><Setter TargetName="IconInitial" Property="Visibility" Value="Visible"/></DataTrigger>
        <Trigger SourceName="RowBorder" Property="IsMouseOver" Value="True"><Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource RowHover}"/></Trigger>
        <!-- a zone header row: time spent there, kills and the crystal rate, so the best spot stands out -->
        <DataTrigger Binding="{Binding Header}" Value="True">
          <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource RowHead}"/>
          <Setter TargetName="RowBorder" Property="Height" Value="28"/>
          <Setter TargetName="IconTile" Property="Visibility" Value="Collapsed"/>
          <Setter TargetName="NameCell" Property="Grid.ColumnSpan" Value="3"/>
          <Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource Gold}"/>
          <Setter TargetName="NameText" Property="FontWeight" Value="SemiBold"/>
          <Setter TargetName="NameText" Property="FontSize" Value="11.5"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>

  <Border x:Name="Root" Background="{DynamicResource Bg}" Padding="18,14,18,12">
    <StackPanel>

      <!-- header: the mark, the name and version, the server everything is filed under, and Options -->
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <!-- the app mark: the same gold hex as the tray icon, drawn here so no image ships -->
          <Grid Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center">
            <Path Data="M13,1 L24,7.5 L24,19.5 L13,26 L2,19.5 L2,7.5 Z" Fill="{DynamicResource Mark}" Stroke="{DynamicResource Gold}" StrokeThickness="1.4" StrokeLineJoin="Round" Stretch="Uniform"/>
            <Path Data="M13,7 L18.5,10.2 L18.5,16.8 L13,20 L7.5,16.8 L7.5,10.2 Z" Fill="#E3B55B" Stretch="Uniform" Margin="5.5"/>
          </Grid>
          <StackPanel VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="KINAH LEDGER" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
              <TextBlock x:Name="Version" Text="v0.6.6" Foreground="{DynamicResource Faint}" VerticalAlignment="Center" Margin="8,2,0,0" FontSize="11.5"/>
            </StackPanel>
            <TextBlock x:Name="ServerChip" Foreground="{DynamicResource Muted}" FontSize="11.5" Margin="0,1,0,0" Cursor="Hand" ToolTip="Your server. Change it in Options."
                       Text="No server chosen"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="SiteBtn" Content="kinahledger.com" Height="32" Padding="12,0" FontSize="12.5" Margin="0,0,8,0" ToolTip="Open the website: community drop rates, prices and your profile."/>
          <Button x:Name="OptionsBtn" Height="32" Padding="12,0" FontSize="12.5" ToolTip="Server, startup, sharing, game reading, hotkey, updates.">
            <StackPanel Orientation="Horizontal">
              <!-- a gear, drawn so no image ships -->
              <Path Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,7,0"
                    Data="M10.3,1 L13.7,1 L14.2,3.6 C15,3.9 15.7,4.3 16.4,4.8 L18.9,3.9 L20.6,6.8 L18.6,8.6 C18.7,9.4 18.7,10.2 18.6,11 L20.6,12.8 L18.9,15.7 L16.4,14.8 C15.7,15.3 15,15.7 14.2,16 L13.7,18.6 L10.3,18.6 L9.8,16 C9,15.7 8.3,15.3 7.6,14.8 L5.1,15.7 L3.4,12.8 L5.4,11 C5.3,10.2 5.3,9.4 5.4,8.6 L3.4,6.8 L5.1,3.9 L7.6,4.8 C8.3,4.3 9,3.9 9.8,3.6 Z M12,6.6 A3.2,3.2 0 1 0 12,13 A3.2,3.2 0 1 0 12,6.6 Z"/>
              <TextBlock Text="Options" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
      <TextBlock x:Name="Tagline" Style="{StaticResource BodyStyle}" FontSize="12.5" Margin="0,8,0,0" Visibility="Collapsed"
                 Text="Unofficial Aion 2 farming tracker. Reads the loot lines from the chat on your screen while the game is open. Nothing touches the game."/>

      <!-- a newer version: shown only while there is one (downloading, ready to install, or waiting for a click) -->
      <Border x:Name="UpdateCard" Style="{StaticResource CardStyle}" Margin="0,12,0,0" Padding="14,10,14,10" Visibility="Collapsed">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="UpdateText" Style="{StaticResource BodyStyle}" FontSize="12.5" LineHeight="17" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="UpdateNotesText" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,12,0"><Hyperlink x:Name="UpdateNotesLink" Style="{StaticResource LinkStyle}">What's new</Hyperlink></TextBlock>
            <Button x:Name="UpdateBtn" Style="{StaticResource PrimaryButton}" Content="Restart now" Height="34" Padding="16,0" FontSize="13"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- first run: region, faction, server and a look, before anything else. Everything shared is filed per server. -->
      <Border x:Name="WelcomeCard" Style="{StaticResource CardStyle}" Margin="0,14,0,0" Padding="22,20,22,20" Visibility="Collapsed">
        <StackPanel>
          <TextBlock Text="Welcome. Where do you play?" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="18" FontWeight="Bold"/>
          <TextBlock Style="{StaticResource BodyStyle}" Margin="0,6,0,0" Text="Everything the tracker shares is filed per server, so this comes first. Three taps and you are in; change any of it later in Options."/>
          <TextBlock Style="{StaticResource LabelStyle}" Text="REGION" Margin="0,16,0,8"/>
          <WrapPanel x:Name="RegionChips"/>
          <TextBlock Style="{StaticResource LabelStyle}" Text="FACTION" Margin="0,8,0,8"/>
          <WrapPanel x:Name="FactionChips"/>
          <TextBlock Style="{StaticResource LabelStyle}" Text="SERVER" Margin="0,8,0,8"/>
          <WrapPanel x:Name="ServerChips"/>
          <TextBlock x:Name="WelcomeHint" Style="{StaticResource BodyStyle}" FontSize="12.5" Margin="0,2,0,0"/>
          <TextBlock Style="{StaticResource LabelStyle}" Text="LOOK" Margin="0,12,0,8"/>
          <WrapPanel x:Name="SkinChips"/>
          <Grid Margin="0,14,0,0">
            <TextBlock Style="{StaticResource BodyStyle}" FontSize="12" VerticalAlignment="Center" MaxWidth="300" HorizontalAlignment="Left" Text="Nothing is read or shared until you continue. The chat and the zone are found on their own."/>
            <Button x:Name="WelcomeGo" Style="{StaticResource PrimaryButton}" Content="Continue" Width="160" Height="44" HorizontalAlignment="Right" VerticalAlignment="Center"/>
          </Grid>
        </StackPanel>
      </Border>

      <!-- the run bar: everything is counted all the time; Start farming times a run on top and shows it -->
      <Border x:Name="SessionCard" Style="{StaticResource CardStyle}" Margin="0,12,0,0" Padding="14,12,14,12">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Button x:Name="StartBtn" Style="{StaticResource PrimaryButton}" Content="Start farming" Width="150" Height="44" VerticalAlignment="Center"/>
          <Grid x:Name="KindGrid" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
            <ComboBox x:Name="Kind" Width="130" VerticalAlignment="Center" ToolTip="What the run is labelled as when it is shared and saved. The count itself covers everything the chat shows."/>
          </Grid>
          <StackPanel Grid.Column="2" Margin="14,0,0,0" VerticalAlignment="Center">
            <TextBlock x:Name="ZoneLbl" Foreground="{DynamicResource Ink}" FontSize="13" FontWeight="SemiBold" Text="Zone: waiting for the game" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="FarmTime" Foreground="{DynamicResource Faint}" FontSize="12" Margin="0,2,0,0" Text="Ctrl+Shift+K starts and stops from inside the game" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="KindHint" Style="{StaticResource BodyStyle}" FontSize="12" LineHeight="16" Visibility="Collapsed"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- tiles -->
      <UniformGrid x:Name="Tiles" Columns="4" Margin="-5,10,-5,0">
        <Border Style="{StaticResource CardStyle}" Margin="5,0" Padding="12,9,12,10">
          <StackPanel><TextBlock x:Name="Tile1Label" Style="{StaticResource LabelStyle}" Text="KINAH / HR"/><TextBlock x:Name="KinahHr" Style="{StaticResource TileValue}" Foreground="{DynamicResource Gold}" Text="0"/></StackPanel>
        </Border>
        <Border Style="{StaticResource CardStyle}" Margin="5,0" Padding="12,9,12,10">
          <StackPanel><TextBlock x:Name="Tile2Label" Style="{StaticResource LabelStyle}" Text="KINAH / KILL"/><TextBlock x:Name="KinahKill" Style="{StaticResource TileValue}" Foreground="{DynamicResource Gold}" Text="—"/></StackPanel>
        </Border>
        <Border Style="{StaticResource CardStyle}" Margin="5,0" Padding="12,9,12,10">
          <StackPanel><TextBlock x:Name="Tile3Label" Style="{StaticResource LabelStyle}" Text="KILLS / HR"/><TextBlock x:Name="KillsHr" Style="{StaticResource TileValue}" Foreground="{DynamicResource Mint}" Text="0"/></StackPanel>
        </Border>
        <Border Style="{StaticResource CardStyle}" Margin="5,0" Padding="12,9,12,10">
          <StackPanel><TextBlock x:Name="Tile4Label" Style="{StaticResource LabelStyle}" Text="DROPS / HR"/><TextBlock x:Name="DropsHr" Style="{StaticResource TileValue}" Foreground="{DynamicResource Violet}" Text="0"/></StackPanel>
        </Border>
      </UniformGrid>

      <!-- one table at a time: Drops, Gathered or Pets, picked by the tabs -->
      <Border x:Name="TablesCard" Style="{StaticResource CardStyle}" Margin="0,10,0,0" Padding="14,10,14,10">
        <StackPanel x:Name="TableStack">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="TableTitle" Style="{StaticResource LabelStyle}" Text="WHILE THE GAME IS OPEN" VerticalAlignment="Center"/>
            <!-- the summary trims from the right when the window is narrow, instead of running under the title -->
            <TextBlock x:Name="Summary" Grid.Column="1" Foreground="{DynamicResource Muted}" FontSize="11.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" Text="nothing read yet"/>
          </Grid>
          <StackPanel Orientation="Horizontal" Margin="0,8,0,8">
            <Button x:Name="DropsTab" Content="Drops" Padding="12,5" FontSize="12.5" Margin="0,0,6,0"/>
            <Button x:Name="GatherTab" Content="Gathered" Padding="12,5" FontSize="12.5" Margin="0,0,6,0"/>
            <Button x:Name="PetsTab" Content="Pets" Padding="12,5" FontSize="12.5"/>
          </StackPanel>

          <StackPanel x:Name="DropsSection">
            <Border Background="{DynamicResource Card2}" CornerRadius="6" Height="28">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/><ColumnDefinition Width="72"/><ColumnDefinition Width="92"/><ColumnDefinition Width="92"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource LabelStyle}" Text="DROPS FROM KILLS" VerticalAlignment="Center" Margin="10,0,0,0"/>
                <TextBlock Grid.Column="1" Style="{StaticResource LabelStyle}" Text="DROPS" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                <TextBlock x:Name="PctHeader" Grid.Column="2" Style="{StaticResource LabelStyle}" Text="DROP %" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0" ToolTip="Drops divided by kills. Kills are counted from Kinah or Soul Point pickups (one per mob), or from kill lines when the chat shows them."/>
                <TextBlock Grid.Column="3" Style="{StaticResource LabelStyle}" Text="PER HOUR" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
              </Grid>
            </Border>
            <Grid MinHeight="64">
              <ScrollViewer MaxHeight="228" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="Rows" ItemTemplate="{StaticResource RowTemplate}"/>
              </ScrollViewer>
              <TextBlock x:Name="TableEmpty" Style="{StaticResource BodyStyle}" FontSize="12.5" Foreground="{DynamicResource Faint}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" MaxWidth="420"
                         Text="Drops show here as they're read, with the drop rate per kill and per hour."/>
            </Grid>
          </StackPanel>

          <StackPanel x:Name="GatherSection">
            <Border Background="{DynamicResource Card2}" CornerRadius="6" Height="28">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/><ColumnDefinition Width="72"/><ColumnDefinition Width="92"/><ColumnDefinition Width="92"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource LabelStyle}" Text="GATHERED" VerticalAlignment="Center" Margin="10,0,0,0"/>
                <TextBlock Grid.Column="1" Style="{StaticResource LabelStyle}" Text="COUNT" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                <TextBlock Grid.Column="2" Style="{StaticResource LabelStyle}" Text="PER ATTEMPT" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0" ToolTip="Count divided by attempts. Every ore, log, Odyle, herb or food line counts as one attempt, failed gathers too; gemstones and higher tiers are the finds."/>
                <TextBlock Grid.Column="3" Style="{StaticResource LabelStyle}" Text="PER HOUR" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
              </Grid>
            </Border>
            <Grid MinHeight="64">
              <ScrollViewer MaxHeight="228" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="GatherRows" ItemTemplate="{StaticResource RowTemplate}"/>
              </ScrollViewer>
              <TextBlock x:Name="GatherEmpty" Style="{StaticResource BodyStyle}" FontSize="12.5" Foreground="{DynamicResource Faint}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" MaxWidth="420"
                         Text="Gathered materials show here, with how often each comes per attempt and per hour."/>
            </Grid>
          </StackPanel>

          <StackPanel x:Name="PetSection">
            <Border Background="{DynamicResource Card2}" CornerRadius="6" Height="28">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/><ColumnDefinition Width="80"/><ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource LabelStyle}" Text="SOUL CRYSTALS BY ZONE" VerticalAlignment="Center" Margin="10,0,0,0"/>
                <TextBlock Grid.Column="1" Style="{StaticResource LabelStyle}" Text="DROPS" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                <TextBlock Grid.Column="2" Style="{StaticResource LabelStyle}" Text="PER HOUR" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0" ToolTip="Crystals divided by the time spent in that zone. There is no drop %: Soul Crystals are rated by time in the zone, not by kill."/>
              </Grid>
            </Border>
            <Grid MinHeight="64">
              <ScrollViewer MaxHeight="228" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="PetRows" ItemTemplate="{StaticResource PetRowTemplate}"/>
              </ScrollViewer>
              <TextBlock x:Name="PetEmpty" Style="{StaticResource BodyStyle}" FontSize="12.5" Foreground="{DynamicResource Faint}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" MaxWidth="420"
                         Text="Soul Crystals show here by zone, with drops and per hour, so the best pet-farming spot stands out."/>
            </Grid>
          </StackPanel>

          <TextBlock x:Name="TableNote" Style="{StaticResource BodyStyle}" Foreground="{DynamicResource Faint}" FontSize="11.5" Margin="0,6,0,0" Visibility="Collapsed"/>
        </StackPanel>
      </Border>

      <!-- status -->
      <Grid x:Name="StatusRow" Margin="0,10,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="Status" Foreground="{DynamicResource Faint}" FontSize="12" TextTrimming="CharacterEllipsis"/>
        <!-- shown with a reading problem: straight to the page that fixes it -->
        <TextBlock x:Name="FixText" Grid.Column="1" FontSize="12" Margin="12,0,0,0" Visibility="Collapsed"><Hyperlink x:Name="FixLink" Style="{StaticResource LinkStyle}">Game reading options</Hyperlink></TextBlock>
      </Grid>

    </StackPanel>
  </Border>
</Window>
