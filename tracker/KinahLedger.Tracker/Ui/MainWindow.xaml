<Window x:Class="KinahLedger.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kinah Ledger" SizeToContent="WidthAndHeight" ResizeMode="CanMinimize"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Ink}"
        FontFamily="{DynamicResource BodyFont}" FontSize="13" FontWeight="Normal" Typography.NumeralAlignment="Tabular"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        WindowStartupLocation="CenterScreen">

  <Window.Resources>
    <!-- table column labels and figures (the approved mocks): plain labels, figures in the data face -->
    <Style x:Key="FTh" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="{DynamicResource Faint}"/>
      <Setter Property="VerticalAlignment" Value="Bottom"/>
      <Setter Property="HorizontalAlignment" Value="Right"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
    <Style x:Key="FTd" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="FontFamily" Value="{DynamicResource MonoFont}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="HorizontalAlignment" Value="Right"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    </Style>
    <!-- a section you open (direction C): a chevron, the name in small gold capitals, a faint line, a figure on the right -->
    <Style x:Key="SecChev" TargetType="Path">
      <Setter Property="Data" Value="M0,0 L4,4 L0,8"/>
      <Setter Property="Stroke" Value="{DynamicResource Faint}"/>
      <Setter Property="StrokeThickness" Value="1.5"/>
      <Setter Property="Width" Value="8"/>
      <Setter Property="Height" Value="8"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
    </Style>
    <Style x:Key="SecTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="{DynamicResource SecGold}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,0,10,0"/>
    </Style>
    <Style x:Key="SecNote" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Foreground" Value="{DynamicResource Faint}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="SecSum" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontFamily" Value="{DynamicResource MonoFont}"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="12,0,20,0"/>
    </Style>

    <!-- a drop row (direction C's aligned table with the tooltip look's icon tiles, 2026-10-24): the item's icon at 40 px in a
         slot framed and lit in its grade colour, the stack count on it; name, qty, odds, an hour, value. A missing price is a
         blank cell. A Header row is the sub-line above a group ("CRAFTING MATERIALS · 4"). -->
    <DataTemplate x:Key="FarmRowTemplate">
      <Border x:Name="RowBorder" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Height="52" Background="Transparent" Cursor="Hand" ToolTip="{Binding Tip}" ToolTipService.InitialShowDelay="250">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/><ColumnDefinition Width="76"/><ColumnDefinition Width="64"/><ColumnDefinition Width="84"/></Grid.ColumnDefinitions>
          <Grid x:Name="IconCell" Width="46" Height="46" HorizontalAlignment="Left" VerticalAlignment="Center">
            <Border x:Name="IconTile" Width="40" Height="40" CornerRadius="7" BorderThickness="1" BorderBrush="{DynamicResource SlotFrame}" HorizontalAlignment="Left" VerticalAlignment="Top">
              <Border.Background>
                <RadialGradientBrush Center="0.5,0.38" GradientOrigin="0.5,0.38" RadiusX="0.75" RadiusY="0.75"><GradientStop Color="#1ACDD3E2" Offset="0"/><GradientStop Color="{DynamicResource SlotColor}" Offset="1"/></RadialGradientBrush>
              </Border.Background>
              <Grid>
                <TextBlock x:Name="IconInitial" Text="{Binding Initial}" FontFamily="{DynamicResource DisplayFont}" FontSize="15" FontWeight="Normal" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                <Image Source="{Binding Icon.Image}" Stretch="Uniform" Margin="2" RenderOptions.BitmapScalingMode="HighQuality"/>
              </Grid>
            </Border>
            <!-- the stack count, as the game's inventory slot shows it -->
            <Border x:Name="Badge" HorizontalAlignment="Right" VerticalAlignment="Bottom" MinWidth="18" Height="16" CornerRadius="8" Padding="4,0" Background="{DynamicResource Slot}" BorderBrush="{DynamicResource SlotBadgeLine}" BorderThickness="1">
              <TextBlock Text="{Binding Drops}" FontFamily="{DynamicResource MonoFont}" FontSize="10.5" Foreground="{DynamicResource OnSlot}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </Grid>
          <Grid x:Name="NameCell" Grid.Column="1" Margin="0,0,10,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="NameText" Text="{Binding Name}" Foreground="{DynamicResource Ink}" FontWeight="Normal" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            <!-- "Looks wrong? Report" (the hint, then the action): shown on hover, "Reported · Undo" kept on a flagged row. A
                 flagged drop is never sent to the site -->
            <TextBlock x:Name="ReportLink" Grid.Column="1" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Hidden"
                       ToolTip="Something looks wrong with this drop? Report keeps it out of what this run sends to the site.">
              <Run Text="{Binding ReportHint, Mode=OneWay}" Foreground="{DynamicResource Faint}"/><Run Text=" "/><Hyperlink Style="{StaticResource LinkStyle}" Click="ReportClick"><Run Text="{Binding ReportText, Mode=OneWay}"/></Hyperlink>
            </TextBlock>
          </Grid>
          <TextBlock x:Name="QtyText" Grid.Column="2" Style="{StaticResource FTd}" Text="{Binding Drops}"/>
          <TextBlock x:Name="OddsText" Grid.Column="3" Style="{StaticResource FTd}" Text="{Binding DropPct}" Foreground="{DynamicResource Faint}"/>
          <TextBlock x:Name="HourText" Grid.Column="4" Style="{StaticResource FTd}" Text="{Binding PerHour}" Foreground="{DynamicResource Faint}"/>
          <!-- the value; where its price is from, its readings and age on hover (Ui/MainWindow.Prices.cs) -->
          <TextBlock x:Name="ValueText" Grid.Column="5" Style="{StaticResource FTd}" Text="{Binding Value}" Foreground="{DynamicResource Gold}" Background="Transparent" ToolTip="{Binding PriceTip}" ToolTipService.InitialShowDelay="250"/>
          <TextBlock x:Name="SubLine" Grid.ColumnSpan="6" Visibility="Collapsed" VerticalAlignment="Bottom" Margin="0,0,0,6" Text="{Binding Name}" Foreground="{DynamicResource Faint}" FontSize="11"/>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Icon.Image}" Value="{x:Null}"><Setter TargetName="IconInitial" Property="Visibility" Value="Visible"/></DataTrigger>
        <DataTrigger Binding="{Binding Tip}" Value=""><Setter TargetName="RowBorder" Property="ToolTip" Value="{x:Null}"/></DataTrigger>
        <DataTrigger Binding="{Binding PriceTip}" Value=""><Setter TargetName="ValueText" Property="ToolTip" Value="{x:Null}"/></DataTrigger>
        <DataTrigger Binding="{Binding PriceTone}" Value="Unsure"><Setter TargetName="ValueText" Property="Opacity" Value="0.5"/></DataTrigger>
        <DataTrigger Binding="{Binding PriceTone}" Value="Old"><Setter TargetName="ValueText" Property="Opacity" Value="0.7"/></DataTrigger>
        <!-- a drop no enemy you fought can drop, by their loot tables: the name says check -->
        <DataTrigger Binding="{Binding Tone}" Value="Warn"><Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource Warn}"/></DataTrigger>
        <Trigger SourceName="RowBorder" Property="IsMouseOver" Value="True"><Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource RowHover}"/><Setter TargetName="ReportLink" Property="Visibility" Value="Visible"/></Trigger>
        <DataTrigger Binding="{Binding Reported}" Value="True"><Setter TargetName="ReportLink" Property="Visibility" Value="Visible"/><Setter TargetName="NameText" Property="Opacity" Value="0.55"/></DataTrigger>
        <DataTrigger Binding="{Binding Report}" Value=""><Setter TargetName="ReportLink" Property="Visibility" Value="Collapsed"/><Setter TargetName="RowBorder" Property="Cursor" Value="Arrow"/></DataTrigger>
        <!-- item grades in the game's own colours, on the name and the tile's frame and glow -->
        <DataTrigger Binding="{Binding Grade}" Value="Rare">
          <Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource GradeRare}"/><Setter TargetName="IconTile" Property="BorderBrush" Value="#9962D98B"/>
          <Setter TargetName="IconTile" Property="Background"><Setter.Value><RadialGradientBrush Center="0.5,0.38" GradientOrigin="0.5,0.38" RadiusX="0.75" RadiusY="0.75"><GradientStop Color="#4262D98B" Offset="0"/><GradientStop Color="{DynamicResource SlotColor}" Offset="1"/></RadialGradientBrush></Setter.Value></Setter>
        </DataTrigger>
        <DataTrigger Binding="{Binding Grade}" Value="Legend">
          <Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource GradeLegend}"/><Setter TargetName="IconTile" Property="BorderBrush" Value="#995AA6FF"/>
          <Setter TargetName="IconTile" Property="Background"><Setter.Value><RadialGradientBrush Center="0.5,0.38" GradientOrigin="0.5,0.38" RadiusX="0.75" RadiusY="0.75"><GradientStop Color="#42BEC6DC" Offset="0"/><GradientStop Color="{DynamicResource SlotColor}" Offset="1"/></RadialGradientBrush></Setter.Value></Setter>
        </DataTrigger>
        <DataTrigger Binding="{Binding Grade}" Value="Unique">
          <Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource GradeUnique}"/><Setter TargetName="IconTile" Property="BorderBrush" Value="#9EF3D35E"/>
          <Setter TargetName="IconTile" Property="Background"><Setter.Value><RadialGradientBrush Center="0.5,0.38" GradientOrigin="0.5,0.38" RadiusX="0.75" RadiusY="0.75"><GradientStop Color="#42F3D35E" Offset="0"/><GradientStop Color="{DynamicResource SlotColor}" Offset="1"/></RadialGradientBrush></Setter.Value></Setter>
        </DataTrigger>
        <DataTrigger Binding="{Binding Grade}" Value="Epic">
          <Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource GradeEpic}"/><Setter TargetName="IconTile" Property="BorderBrush" Value="#99B48BFF"/>
          <Setter TargetName="IconTile" Property="Background"><Setter.Value><RadialGradientBrush Center="0.5,0.38" GradientOrigin="0.5,0.38" RadiusX="0.75" RadiusY="0.75"><GradientStop Color="#42BEC6DC" Offset="0"/><GradientStop Color="{DynamicResource SlotColor}" Offset="1"/></RadialGradientBrush></Setter.Value></Setter>
        </DataTrigger>
        <!-- the sub-line row: a small label, nothing else -->
        <DataTrigger Binding="{Binding Header}" Value="True">
          <Setter TargetName="RowBorder" Property="Height" Value="32"/>
          <Setter TargetName="RowBorder" Property="BorderThickness" Value="0"/>
          <Setter TargetName="RowBorder" Property="Cursor" Value="Arrow"/>
          <Setter TargetName="RowBorder" Property="Background" Value="Transparent"/>
          <Setter TargetName="IconCell" Property="Visibility" Value="Collapsed"/>
          <Setter TargetName="NameCell" Property="Visibility" Value="Collapsed"/>
          <Setter TargetName="SubLine" Property="Visibility" Value="Visible"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- a row of a small table opened in place (Gathered, a gathering skill, Soul Crystals, Kinah by enemy): a 28 px tile, the
         name, three figures. An enemy's loot rows (Child) sit indented under it, its listed chance beside the name. -->
    <DataTemplate x:Key="SmallRowTemplate">
      <Border x:Name="RowBorder" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Height="40" Background="Transparent" ToolTip="{Binding Tip}" ToolTipService.InitialShowDelay="250">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="72"/><ColumnDefinition Width="80"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
          <Border x:Name="IconTile" Width="28" Height="28" CornerRadius="5" BorderThickness="1" BorderBrush="{DynamicResource SlotFrame}" Background="{DynamicResource Slot}" HorizontalAlignment="Left" VerticalAlignment="Center">
            <Grid>
              <TextBlock x:Name="IconInitial" Text="{Binding Initial}" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
              <Image Source="{Binding Icon.Image}" Stretch="Uniform" Margin="2" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Grid>
          </Border>
          <StackPanel x:Name="NameCell" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
            <TextBlock x:Name="NameText" Text="{Binding Name}" Foreground="{DynamicResource Ink}" FontWeight="Normal" FontSize="13" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="SubText" Text="{Binding Sub}" Foreground="{DynamicResource Faint}" FontSize="12" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <TextBlock Grid.Column="2" Style="{StaticResource FTd}" Text="{Binding Drops}"/>
          <TextBlock Grid.Column="3" Style="{StaticResource FTd}" Text="{Binding DropPct}" Foreground="{DynamicResource Faint}"/>
          <TextBlock x:Name="ValueText" Grid.Column="4" Style="{StaticResource FTd}" Text="{Binding Value}" Foreground="{DynamicResource Gold}"/>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Icon.Image}" Value="{x:Null}"><Setter TargetName="IconInitial" Property="Visibility" Value="Visible"/></DataTrigger>
        <DataTrigger Binding="{Binding Tip}" Value=""><Setter TargetName="RowBorder" Property="ToolTip" Value="{x:Null}"/></DataTrigger>
        <DataTrigger Binding="{Binding Key}" Value=""><Setter TargetName="RowBorder" Property="Cursor" Value="Arrow"/></DataTrigger>
        <DataTrigger Binding="{Binding Report}" Value=""><Setter TargetName="RowBorder" Property="Cursor" Value="Arrow"/></DataTrigger>
        <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Child}" Value="False"/><Condition Binding="{Binding Header}" Value="False"/></MultiDataTrigger.Conditions><Setter TargetName="RowBorder" Property="Cursor" Value="Hand"/></MultiDataTrigger>
        <Trigger SourceName="RowBorder" Property="IsMouseOver" Value="True"><Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource RowHover}"/></Trigger>
        <DataTrigger Binding="{Binding Tone}" Value="Warn"><Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource Warn}"/></DataTrigger>
        <DataTrigger Binding="{Binding Grade}" Value="Rare"><Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource GradeRare}"/><Setter TargetName="IconTile" Property="BorderBrush" Value="#9962D98B"/></DataTrigger>
        <DataTrigger Binding="{Binding Grade}" Value="Legend"><Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource GradeLegend}"/><Setter TargetName="IconTile" Property="BorderBrush" Value="#995AA6FF"/></DataTrigger>
        <DataTrigger Binding="{Binding Grade}" Value="Unique"><Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource GradeUnique}"/><Setter TargetName="IconTile" Property="BorderBrush" Value="#9EF3D35E"/></DataTrigger>
        <DataTrigger Binding="{Binding Grade}" Value="Epic"><Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource GradeEpic}"/><Setter TargetName="IconTile" Property="BorderBrush" Value="#99B48BFF"/></DataTrigger>
        <DataTrigger Binding="{Binding Child}" Value="True">
          <Setter TargetName="RowBorder" Property="Height" Value="34"/>
          <Setter TargetName="IconTile" Property="Margin" Value="12,0,0,0"/>
          <Setter TargetName="IconTile" Property="Width" Value="22"/><Setter TargetName="IconTile" Property="Height" Value="22"/>
          <Setter TargetName="NameText" Property="FontWeight" Value="Normal"/>
          <Setter TargetName="RowBorder" Property="BorderThickness" Value="0"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Header}" Value="True">
          <Setter TargetName="RowBorder" Property="Height" Value="30"/>
          <Setter TargetName="RowBorder" Property="BorderThickness" Value="0"/>
          <Setter TargetName="IconTile" Property="Visibility" Value="Collapsed"/>
          <Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource Faint}"/>
          <Setter TargetName="NameText" Property="FontSize" Value="11"/>
          <Setter TargetName="NameText" Property="FontWeight" Value="Normal"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- a recipe of this session (Crafting, direction C): icon, name, tries, worked, spent, sells for, profit. A failed-only
         recipe shows its loss in grey, not red; a row opens its recipe card. Under a recipe, its upgrades (Child, 2026-10-26):
         indented on a tree line, the count after the name, "—" for tries and worked, what they sell for and what they added -->
    <DataTemplate x:Key="CraftRowTemplate">
      <Border x:Name="RowBorder" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Height="44" Background="Transparent" Cursor="Hand" ToolTip="{Binding Tip}" ToolTipService.InitialShowDelay="250">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/><ColumnDefinition Width="58"/><ColumnDefinition Width="64"/><ColumnDefinition Width="72"/><ColumnDefinition Width="72"/></Grid.ColumnDefinitions>
          <Border x:Name="TreeLine" Width="8" Height="18" Margin="5,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" BorderThickness="1,0,0,1" BorderBrush="{DynamicResource LineStrong}" Visibility="Collapsed"/>
          <Border x:Name="IconTile" Width="30" Height="30" CornerRadius="5" BorderThickness="1" BorderBrush="{DynamicResource SlotFrame}" Background="{DynamicResource Slot}" HorizontalAlignment="Left" VerticalAlignment="Center">
            <Grid>
              <TextBlock x:Name="IconInitial" Text="{Binding Initial}" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
              <Image Source="{Binding Icon.Image}" Stretch="Uniform" Margin="2" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Grid>
          </Border>
          <!-- the name (an upgrade row's count after it); under a recipe's name, what came out when it isn't one a craft ("40 made · 4 crafts of ×10") -->
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
            <TextBlock x:Name="NameText" Foreground="{DynamicResource Ink}" FontWeight="Normal" FontSize="13" TextTrimming="CharacterEllipsis"><Run Text="{Binding Name, Mode=OneWay}"/><Run Text="{Binding Sub, Mode=OneWay}" FontFamily="{DynamicResource MonoFont}" FontWeight="Normal" FontSize="12" Foreground="{DynamicResource Faint}"/></TextBlock>
            <TextBlock x:Name="UnderText" Text="{Binding Under}" FontFamily="{DynamicResource MonoFont}" FontSize="11.5" Foreground="{DynamicResource Faint}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
          </StackPanel>
          <TextBlock Grid.Column="2" Style="{StaticResource FTd}" Text="{Binding Drops}" Foreground="{DynamicResource Faint}"/>
          <TextBlock Grid.Column="3" Style="{StaticResource FTd}" Text="{Binding DropPct}" Foreground="{DynamicResource Faint}"/>
          <TextBlock Grid.Column="4" Style="{StaticResource FTd}" Text="{Binding PerHour}" Foreground="{DynamicResource Faint}"/>
          <TextBlock x:Name="SellsText" Grid.Column="5" Style="{StaticResource FTd}" Text="{Binding Price}" ToolTip="{Binding PriceTip}"/>
          <TextBlock x:Name="ValueText" Grid.Column="6" Style="{StaticResource FTd}" Text="{Binding Value}" Foreground="{DynamicResource Gold}"/>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Child}" Value="True">
          <Setter TargetName="RowBorder" Property="Height" Value="36"/>
          <Setter TargetName="RowBorder" Property="BorderThickness" Value="0"/>
          <Setter TargetName="TreeLine" Property="Visibility" Value="Visible"/>
          <Setter TargetName="IconTile" Property="Margin" Value="14,0,0,0"/>
          <Setter TargetName="IconTile" Property="Width" Value="24"/><Setter TargetName="IconTile" Property="Height" Value="24"/>
          <Setter TargetName="NameText" Property="FontWeight" Value="Normal"/>
          <Setter TargetName="NameText" Property="Margin" Value="6,0,0,0"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Under}" Value=""><Setter TargetName="UnderText" Property="Visibility" Value="Collapsed"/></DataTrigger>
        <DataTrigger Binding="{Binding Icon.Image}" Value="{x:Null}"><Setter TargetName="IconInitial" Property="Visibility" Value="Visible"/></DataTrigger>
        <DataTrigger Binding="{Binding Tip}" Value=""><Setter TargetName="RowBorder" Property="ToolTip" Value="{x:Null}"/></DataTrigger>
        <DataTrigger Binding="{Binding PriceTip}" Value=""><Setter TargetName="SellsText" Property="ToolTip" Value="{x:Null}"/></DataTrigger>
        <DataTrigger Binding="{Binding PriceTone}" Value="Unsure"><Setter TargetName="SellsText" Property="Opacity" Value="0.5"/></DataTrigger>
        <DataTrigger Binding="{Binding PriceTone}" Value="Old"><Setter TargetName="SellsText" Property="Opacity" Value="0.7"/></DataTrigger>
        <DataTrigger Binding="{Binding Tone}" Value="Bad"><Setter TargetName="ValueText" Property="Foreground" Value="{DynamicResource Faint}"/></DataTrigger>
        <Trigger SourceName="RowBorder" Property="IsMouseOver" Value="True"><Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource RowHover}"/></Trigger>
        <DataTrigger Binding="{Binding Grade}" Value="Rare"><Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource GradeRare}"/><Setter TargetName="IconTile" Property="BorderBrush" Value="#9962D98B"/></DataTrigger>
        <DataTrigger Binding="{Binding Grade}" Value="Legend"><Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource GradeLegend}"/><Setter TargetName="IconTile" Property="BorderBrush" Value="#995AA6FF"/></DataTrigger>
        <DataTrigger Binding="{Binding Grade}" Value="Unique"><Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource GradeUnique}"/><Setter TargetName="IconTile" Property="BorderBrush" Value="#9EF3D35E"/></DataTrigger>
        <DataTrigger Binding="{Binding Grade}" Value="Epic"><Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource GradeEpic}"/><Setter TargetName="IconTile" Property="BorderBrush" Value="#99B48BFF"/></DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

  </Window.Resources>

  <Border x:Name="Root" Background="{DynamicResource Bg}" Padding="22,10,22,10">
    <!-- FitHost: scaled down as one piece when Full view is wider than the screen (Ui/MainWindow.Fit.cs) -->
    <Grid x:Name="FitHost">
    <!-- the ledger: always the same width, wherever the settings are -->
    <!-- never taller than the screen (Steven, 0.7.6): the header, the run card and the summary stay put; the pickups and
         the tables scroll below them once the window would run past the screen (Window.MaxHeight is the work area) -->
    <!-- 0.7.6 (Steven): Compact (the default) is the run card and the summary; Full view doubles the width and puts every
         table in a second column beside them. Never taller than the screen: the tables' column scrolls past it. -->
    <Grid x:Name="LedgerCol" VerticalAlignment="Top">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition x:Name="LeftColDef" Width="662"/><ColumnDefinition x:Name="RightColDef" Width="0"/></Grid.ColumnDefinitions>
    <!-- across both columns; its width is set with the view (ApplyView) so long text never widens the window -->
    <StackPanel x:Name="HeadStack" Grid.ColumnSpan="2" Width="662" HorizontalAlignment="Left">

      <!-- header, the Quest look (2026-11-07, docs/ui/mockups/directions-2026-11-07): the mark and the name with the server
           under it; Farm / Craft / Runs as icon pills, the lit one gold; then round icon buttons: Compact/Full, the site,
           Share (its sheet opens in the hero card) and Options -->
      <!-- the round buttons' column is as wide as all four (4 x 32 + 3 x 6), so the page tabs stand still when a page hides
           Compact/Full and Share (UI audit 2026-11-08: the tabs slid about 75 px between Farm and the other pages) -->
      <Grid Height="44">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="146"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <!-- the app mark, the K tile (tools/brand/logo.svg) -->
          <Image Source="{StaticResource AppMark}" Width="32" Height="32" Margin="0,0,10,0" VerticalAlignment="Center"/>
          <StackPanel VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Kinah Ledger" FontFamily="{DynamicResource DisplayFont}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
              <TextBlock x:Name="Version" Text="v0.7.6" Foreground="{DynamicResource Faint}" VerticalAlignment="Center" Margin="8,1,0,0" FontSize="11" FontWeight="Medium"/>
            </StackPanel>
            <!-- the character, then the server (Ui/MainWindow.Characters.cs): capped so a long name never pushes the page tabs; the server trims first -->
            <TextBlock x:Name="ServerChip" Foreground="{DynamicResource Muted}" FontSize="11" FontWeight="Medium" Cursor="Hand" ToolTip="Your server. Change it in Options." Text="No server chosen" MaxWidth="200" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
        </StackPanel>
        <!-- three pages that never mix: Farm (the run, the rate, the loot), Craft (recipes, cost, profit), Runs (expeditions and events) -->
        <Border x:Name="PartTabs" Grid.Column="1" HorizontalAlignment="Right" Margin="0,0,8,0" Padding="4" CornerRadius="12" Background="{DynamicResource Card}" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <Button x:Name="FarmTab" Style="{StaticResource SegOn}">
              <TextBlock Text="Farm" VerticalAlignment="Center"/>
            </Button>
            <Button x:Name="CraftTab" Style="{StaticResource SegOff}" Margin="2,0,0,0">
              <TextBlock Text="Craft" VerticalAlignment="Center"/>
            </Button>
            <Button x:Name="EventsTab" Style="{StaticResource SegOff}" Margin="2,0,0,0" ToolTip="Expeditions and events: each trip, from entering to the last loot. Never on the Farming page.">
              <TextBlock Text="Runs" VerticalAlignment="Center"/>
            </Button>
            <!-- Quests (2026-11-08, Ui/MainWindow.QuestsPage.cs): every quest, pins, daily and all time, done, your score -->
            <Button x:Name="QuestsTab" Style="{StaticResource SegOff}" Margin="2,0,0,0" ToolTip="Quests: every quest with its tree, pins for Next up, today's and all time, what you have done, your score.">
              <TextBlock Text="Quests" VerticalAlignment="Center"/>
            </Button>
          </StackPanel>
        </Border>
        <!-- round buttons: Compact / Full view (Farming only), the site, Share and Options -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
          <Button x:Name="ViewBtn" Style="{StaticResource RoundBtn}" Margin="0,0,6,0" ToolTip="Full view: every table beside the summary" AutomationProperties.Name="Compact or Full view">
            <Grid Width="16" Height="12">
              <Rectangle Width="16" Height="12" RadiusX="3" RadiusY="3" Stroke="{DynamicResource Muted}" StrokeThickness="1.6"/>
              <Rectangle Width="1.6" Height="12" Fill="{DynamicResource Muted}" HorizontalAlignment="Left" Margin="7,0,0,0"/>
              <Rectangle x:Name="ViewFill" Width="6" Height="9" Fill="{DynamicResource Muted}" HorizontalAlignment="Right" Margin="0,0,1.5,0" Opacity="0.25"/>
            </Grid>
          </Button>
          <Button x:Name="SiteBtn" Style="{StaticResource RoundBtn}" Margin="0,0,6,0" ToolTip="kinahledger.com: community drop rates, prices and your profile" AutomationProperties.Name="Open kinahledger.com">
            <Path Style="{StaticResource QIconStyle}" Data="{StaticResource IcGlobe}"/>
          </Button>
          <Button x:Name="ShareCardBtn" Style="{StaticResource RoundBtn}" Margin="0,0,6,0" IsEnabled="False" AutomationProperties.Name="Share"
                  ToolTip="A picture of this session, the last run or the week, to paste in Discord or anywhere. Nothing is uploaded.">
            <Path Style="{StaticResource QIconStyle}" Data="{StaticResource IcShare}"/>
          </Button>
          <Button x:Name="OptionsBtn" Style="{StaticResource RoundBtn}" ToolTip="Startup and look, server and price alerts, sharing and your data, game reading, the shortcut and the panel over the game, updates.">
            <Path Style="{StaticResource QIconStyle}" Data="{StaticResource IcGear}"/>
          </Button>
        </StackPanel>
      </Grid>
      <!-- a newer version: downloaded on its own, installed when the window closes or on Restart now -->
      <!-- one line (2026-10-28, the calm Farming page): the ready notice fits beside its two actions -->
      <Border x:Name="UpdateCard" Style="{StaticResource CardStyle}" Margin="0,12,0,0" Padding="14,6,6,6" Visibility="Collapsed">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="UpdateText" Style="{StaticResource BodyStyle}" FontSize="12.5" LineHeight="17" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="UpdateNotesText" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,12,0"><Hyperlink x:Name="UpdateNotesLink" Style="{StaticResource LinkStyle}">What's new</Hyperlink></TextBlock>
            <Button x:Name="UpdateBtn" Style="{StaticResource PrimaryButton}" Content="Restart now" Height="32" Padding="16,0" FontSize="13"/>
          </StackPanel>
        </Grid>
      </Border>
      <TextBlock x:Name="Tagline" Style="{StaticResource BodyStyle}" FontSize="12.5" Margin="0,6,0,0"
                 Text="Unofficial Aion 2 farming tracker. Reads the loot lines from the chat on your screen while the game is open. Nothing touches the game."/>

      <!-- first run: region, faction, server and a look, before anything else. Everything shared is filed per server. -->
      <Border x:Name="WelcomeCard" Style="{StaticResource CardStyle}" Margin="0,14,0,0" Padding="22,20,22,20" Visibility="Collapsed">
        <StackPanel>
          <TextBlock Text="Welcome. Where do you play?" FontFamily="{DynamicResource DisplayFont}" FontSize="18" FontWeight="Medium"/>
          <TextBlock Style="{StaticResource BodyStyle}" Margin="0,6,0,0" Text="Everything the tracker shares is filed per server, so this comes first. Three clicks and you are in; change any of it later in Options."/>
          <TextBlock Style="{StaticResource LabelStyle}" Text="REGION" Margin="0,16,0,8"/>
          <WrapPanel x:Name="RegionChips"/>
          <TextBlock Style="{StaticResource LabelStyle}" Text="FACTION" Margin="0,8,0,8"/>
          <WrapPanel x:Name="FactionChips"/>
          <TextBlock Style="{StaticResource LabelStyle}" Text="SERVER" Margin="0,8,0,8"/>
          <WrapPanel x:Name="ServerChips"/>
          <TextBlock x:Name="WelcomeHint" Style="{StaticResource BodyStyle}" FontSize="12.5" Margin="0,2,0,0"/>
          <!-- gear score (0.8.12): the run card compares the player with players at the same gear; empty is every player -->
          <TextBlock Style="{StaticResource LabelStyle}" Text="GEAR SCORE" Margin="0,12,0,8"/>
          <!-- the box says what goes in it and the hint gives the scale (2026-11-08 audit: an empty box with no unit or range) -->
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBox x:Name="WelcomeGear" Width="120" MaxLength="5" VerticalAlignment="Center" AutomationProperties.Name="Gear score"/>
            <TextBlock Text="e.g. 1450" IsHitTestVisible="False" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource Faint}">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=WelcomeGear}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <TextBlock Grid.Column="1" Style="{StaticResource BodyStyle}" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="Optional. The gear score on your character window. Your runs are compared with players in the same band of 200 (1450 sits in 1400–1599). Change it in Options."/>
          </Grid>
          <TextBlock Style="{StaticResource LabelStyle}" Text="LOOK" Margin="0,12,0,8"/>
          <WrapPanel x:Name="SkinChips"/>
          <!-- sharing, chosen here before anything is read or sent (the same switch as Options › Sharing) -->
          <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,16,0">
              <TextBlock Text="Share my runs and Market prices, anonymously" FontSize="13.5" FontWeight="Normal"/>
              <TextBlock Style="{StaticResource BodyStyle}" FontSize="12" Margin="0,2,0,0" Text="Totals only, sent in small batches about every 15 minutes while you play, for the site's public tables. Never your character, chat text or screenshots. Turn it off any time in Options."/>
              <TextBlock FontSize="12.5" Margin="0,4,0,0"><Hyperlink x:Name="WelcomeSentLink" Style="{StaticResource LinkStyle}">What's shared</Hyperlink><Run Text="   "/><Hyperlink x:Name="WelcomePrivacyLink" Style="{StaticResource LinkStyle}">Privacy</Hyperlink></TextBlock>
            </StackPanel>
            <CheckBox x:Name="WelcomeShareChk" Grid.Column="1" Style="{StaticResource Switch}" IsChecked="True" VerticalAlignment="Center" AutomationProperties.Name="Share my runs and Market prices, anonymously"/>
          </Grid>
          <Grid Margin="0,14,0,0">
            <TextBlock Style="{StaticResource BodyStyle}" FontSize="12" VerticalAlignment="Center" MaxWidth="300" HorizontalAlignment="Left" Text="Nothing is read or sent until you continue. The chat and the zone are found on their own."/>
            <Button x:Name="WelcomeGo" Style="{StaticResource PrimaryButton}" Content="Continue" Width="160" Height="44" HorizontalAlignment="Right" VerticalAlignment="Center"/>
          </Grid>
          <!-- what to do once Continue is pressed (2026-11-08 audit: nothing said it); the key is filled in by InitWelcome -->
          <TextBlock x:Name="WelcomeNext" Style="{StaticResource BodyStyle}" FontSize="12.5" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Ink}"
                     Text="Then: open Aion 2, keep the chat on screen, and press Start run."/>
        </StackPanel>
      </Border>

      <!-- Today (0.8.50, option C of kinah-bench/mock-today, Steven 2026-10-27): one gold line over Farming and Events with
           the day so far ("2:41 farming · 412 kills · 4 runs" and what it made); opened, the day's loot as inventory slots,
           farming and the runs apart, zone chips to pin one zone, and the game-tooltip card on each slot (Ui/MainWindow.Today.cs).
           Since midnight on this PC, carried across restarts in today.json. -->
      <Border x:Name="TodayStrip" Margin="0,12,0,0" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource CardLine}" Background="{DynamicResource Card}" Visibility="Collapsed">
        <StackPanel>
          <Grid x:Name="TodayHead" Height="46" Background="Transparent" Cursor="Hand" ToolTip="Today since midnight on this PC. Click to see the loot.">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Path x:Name="TodayChev" Style="{StaticResource SecChev}" Margin="16,0,-6,0"/>
            <TextBlock x:Name="TodayTitle" Grid.Column="1" Text="TODAY" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Gold}" VerticalAlignment="Center" Margin="16,0,10,0"/>
            <TextBlock x:Name="TodayNote" Grid.Column="2" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <!-- Day wrapped or Week wrapped, for the side shown (2026-11-11): the recap sheet, Ui/MainWindow.Wrapped.cs -->
            <Button x:Name="TodayWrapBtn" Grid.Column="3" Style="{StaticResource PillBtn}" Height="28" FontSize="12" Padding="10,0" Margin="12,0,0,0" VerticalAlignment="Center"/>
            <!-- today or the last 7 days (0.9, History A): the runs' Week side, Ui/MainWindow.Week.cs -->
            <Border x:Name="TodayScope" Grid.Column="4" Padding="3" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource CardLine}" Background="{DynamicResource SegGroup}" VerticalAlignment="Center" Margin="12,0,0,0">
              <StackPanel Orientation="Horizontal">
                <Button x:Name="TodayDayBtn" Style="{StaticResource SegOn}" Content="Today" Height="26" FontSize="12.5" Padding="10,0" ToolTip="Today's expeditions and events since midnight on this PC."/>
                <Button x:Name="TodayWeekBtn" Style="{StaticResource SegOff}" Content="Week" Height="26" FontSize="12.5" Padding="10,0" Margin="2,0,0,0" ToolTip="The last 7 days of expeditions and events on this PC, a bar a day."/>
              </StackPanel>
            </Border>
            <TextBlock x:Name="TodaySum" Grid.Column="5" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Gold}" VerticalAlignment="Center" Margin="12,0,16,0"/>
          </Grid>
          <Border x:Name="TodayBody" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardLine}" Padding="16,0,16,12" Visibility="Collapsed">
            <StackPanel x:Name="TodayHost"/>
          </Border>
        </StackPanel>
      </Border>

    </StackPanel>

    <!-- the left column: the live card (the feed, the rate, the actions) and the Session section; in Full view also Where to
         farm now and the footer (moved here by ApplyView) -->
    <StackPanel x:Name="LeftCol" Grid.Row="1" Width="662" VerticalAlignment="Top">
      <!-- What's new (0.9.12): after an update, this version's release notes as bold leads and the rest, once; Got it puts
           it away until the next version (Ui/MainWindow.WhatsNew.cs, the notes built in by Platform/WhatsNew.cs) -->
      <Border x:Name="WhatsNewCard" Margin="0,12,0,0" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource GoldLine}" Background="{DynamicResource Card}" Visibility="Collapsed">
        <StackPanel Margin="20,14,20,14">
          <TextBlock x:Name="WhatsNewTitle" Text="WHAT'S NEW" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource SecGold}"/>
          <StackPanel x:Name="WhatsNewList" Margin="0,8,0,0"/>
          <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="WhatsNewLinks" FontSize="12.5" VerticalAlignment="Center"><Hyperlink x:Name="WhatsNewAllLink" Style="{StaticResource LinkStyle}">All notes on GitHub</Hyperlink></TextBlock>
            <Button x:Name="WhatsNewGotIt" Grid.Column="1" Content="Got it" Height="30" Padding="16,0" FontSize="12.5" ToolTip="Put this away until the next version"/>
          </Grid>
        </StackPanel>
      </Border>

      <!-- the hero (Quest, 2026-11-07): where you are and for how long, the hour as the big figure, the chase against your
           best here as a bar toward the flag and as a ring, Start run and the three dots under the ring; "chart" opens
           the rate line. Filled by Ui/MainWindow.Live.cs (FillRate) -->
      <Border x:Name="SessionCard" Style="{StaticResource QCard}" Margin="0,10,0,0" Background="{DynamicResource HeroBg}" Padding="16,12,16,12">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                  <!-- live: the game is being read now -->
                  <StackPanel x:Name="LiveMark" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed" ToolTip="The game is being read now." Background="Transparent">
                    <Ellipse x:Name="RecDot" Width="8" Height="8" Fill="{DynamicResource Mint}" Margin="0,0,8,0" VerticalAlignment="Center">
                      <Ellipse.Effect><DropShadowEffect Color="#3DD68C" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/></Ellipse.Effect>
                    </Ellipse>
                  </StackPanel>
                  <TextBlock x:Name="ZoneLbl" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource Muted}" Text="Waiting for the game" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" MaxWidth="260"/>
                  <TextBlock x:Name="ZoneSep" Text=" · " FontSize="12" FontWeight="Medium" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                  <!-- what and how long ("Open world · 42 min"), in minutes -->
                  <TextBlock x:Name="TableTitle" Foreground="{DynamicResource Muted}" FontSize="12" FontWeight="Medium" Text="Not reading yet" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel x:Name="ChartToggle" Grid.Column="1" Orientation="Horizontal" Cursor="Hand" Background="Transparent" VerticalAlignment="Center" Margin="8,0,0,0" Visibility="Collapsed"
                            ToolTip="The hour since the session started, one sample a minute; the dashed line is your best here.">
                  <TextBlock Text="chart" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Faint}" VerticalAlignment="Center"/>
                  <Path x:Name="ChartChev" Style="{StaticResource QChev}" Margin="3,0,0,0"/>
                </StackPanel>
              </Grid>
              <!-- is it working: "Reading · last pickup 4s ago", or a nudge when nothing has been read for a while; a dot says how
                   reading goes at a glance (green reading, gold looking or paused, red a read problem), and a click opens
                   Options › Game reading (FillReading) -->
              <StackPanel x:Name="ReadingLine" Orientation="Horizontal" Margin="0,3,0,0" Visibility="Collapsed" Background="Transparent" Cursor="Hand"
                          ToolTipService.InitialShowDelay="600" AutomationProperties.Name="Game reading options">
                <Ellipse x:Name="ReadingDot" Width="6" Height="6" Fill="{DynamicResource Good}" Margin="0,1,6,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="ReadingLbl" Foreground="{DynamicResource Faint}" FontSize="11.5" FontWeight="Medium" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" MaxWidth="420"/>
              </StackPanel>
              <!-- the hour, big, and its unit -->
              <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock x:Name="HeadRate" Cursor="Hand" MouseLeftButtonUp="HeadRate_Click" FontFamily="{DynamicResource DisplayFont}" FontSize="44" FontWeight="Bold" Foreground="{DynamicResource Ink}" Text=" " LineHeight="42" LineStackingStrategy="BlockLineHeight"/>
                <TextBlock x:Name="HeadRateLbl" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource Muted}" Margin="8,0,0,7" VerticalAlignment="Bottom" TextWrapping="Wrap" MaxWidth="230" Text="Kinah and loot an hour, once something is counted"/>
              </StackPanel>
              <!-- the chase: this hour against your best here, a bar toward the flag (mint once it is beaten) -->
              <StackPanel x:Name="ChaseBox" Margin="0,8,0,0" Visibility="Collapsed">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock x:Name="ChaseLbl" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                    <Image x:Name="ChaseFlag" Source="/Art/medalgold.png" Width="18" Height="18" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock x:Name="ChaseBest" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Gold}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                </Grid>
                <Grid Margin="0,6,0,0">
                  <Border x:Name="ChaseTrack" Height="12" CornerRadius="6" Background="{DynamicResource Bg}"/>
                  <Border x:Name="ChaseFill" Height="12" HorizontalAlignment="Left" Width="0" CornerRadius="6" Background="{DynamicResource Gold}">
                    <Border CornerRadius="6" Margin="1"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#55FFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="0.6"/></LinearGradientBrush></Border.Background></Border>
                  </Border>
                </Grid>
              </StackPanel>
              <!-- your usual and best here (Compare B, 0.9.3, Ui/MainWindow.Compare.cs): only with Options › Compare zones and runs on -->
              <Border x:Name="UsualBox" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Line}" Margin="0,10,0,0" Padding="0,8,0,0" Background="Transparent" Visibility="Collapsed">
                <TextBlock x:Name="UsualLine" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource Muted}" LineHeight="19" TextWrapping="Wrap"/>
              </Border>
              <!-- "161 kills · 3.9K a kill" and "best here 1.40M": said by the chips and the chase now; kept for the figures the code reads -->
              <TextBlock x:Name="KvLine" Visibility="Collapsed"/>
              <!-- shown only when something is wrong (FillHealth) -->
              <StackPanel x:Name="HealthLine" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
                <Path x:Name="HealthMark" Width="13" Height="13" Stretch="Uniform" Stroke="{DynamicResource Good}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M3.5,8.5 L6.5,11.5 L12.5,4.5" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="HealthText" FontSize="11.5" FontWeight="Medium" Foreground="{DynamicResource Faint}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="300"/>
              </StackPanel>
            </StackPanel>
            <!-- the ring (QRing, filled by FillRate), Start run and the three dots under it -->
            <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="140">
              <Grid x:Name="RingHost" Width="76" Height="76" HorizontalAlignment="Center"/>
              <StackPanel Orientation="Horizontal" Margin="0,10,0,0" HorizontalAlignment="Center">
                <Button x:Name="StartBtn" Style="{StaticResource PillBtn}" Content="Start run" MinWidth="96" VerticalAlignment="Center"
                        ToolTip="Times a run. Counting happens anyway; a run is what gets saved and shared."/>
                <!-- the rest, out of the way: All zones, Clear everything, a missing pickup, the shortcut -->
                <Button x:Name="MoreBtn" Style="{StaticResource RoundBtn}" Width="30" Height="30" Margin="6,0,0,0" Background="Transparent" BorderBrush="{DynamicResource CardLineHover}" ToolTip="More: goals, all zones, clear everything, report a missing pickup" AutomationProperties.Name="More">
                  <TextBlock Text="⋯" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Muted}" Margin="0,-3,0,0"/>
                </Button>
              </StackPanel>
            </StackPanel>
          </Grid>
          <!-- the rate since the start (click "chart"): one sample a minute under a gold line, the dashed lilac line your best here -->
          <StackPanel x:Name="ChartBox" Margin="0,12,0,0" Visibility="Collapsed">
            <Canvas x:Name="RateCanvas" Width="628" Height="96" HorizontalAlignment="Left" ClipToBounds="False">
              <Path x:Name="RateFill" StrokeThickness="0">
                <Path.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#99F5B942" Offset="0"/><GradientStop Color="#26F5B942" Offset="0.55"/><GradientStop Color="#00F5B942" Offset="1"/></LinearGradientBrush></Path.Fill>
              </Path>
              <Polyline x:Name="RateLinePath" Stroke="{DynamicResource Gold}" StrokeThickness="3" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              <Ellipse x:Name="RateDot" Width="10" Height="10" Fill="{DynamicResource Gold}" Stroke="{DynamicResource Bg}" StrokeThickness="2" Visibility="Collapsed"/>
              <Line x:Name="BestLinePath" X1="0" X2="628" Stroke="{DynamicResource Lilac}" StrokeThickness="1.6" StrokeDashArray="4,3" Visibility="Collapsed"/>
              <TextBlock x:Name="BestLineLbl" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Lilac}" Canvas.Left="4" Visibility="Collapsed"/>
            </Canvas>
            <Grid x:Name="RateAxis" Margin="0,2,0,0">
              <TextBlock x:Name="RateFrom" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Faint}" HorizontalAlignment="Left"/>
              <TextBlock x:Name="RateTo" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Faint}" HorizontalAlignment="Right" Text="now"/>
            </Grid>
          </StackPanel>
          <!-- the shortcut that starts and stops a run (UpdateStartHint): in Start run's tooltip and the three dots now -->
          <TextBlock x:Name="StartHint" Visibility="Collapsed"/>
          <!-- the Share sheet while it is open (0.9.3): a dark panel inside the card, never a window of its own -->
          <Border x:Name="ShareHost" Margin="0,12,0,0" Visibility="Collapsed"/>
          <!-- figures the code still works out for the Discord card and the panel over the game; not drawn since the feed (0.8.30) -->
          <StackPanel Visibility="Collapsed">
            <TextBlock x:Name="HeadRateUnit" Text="an hour"/>
            <StackPanel x:Name="CompareLine" Orientation="Horizontal">
              <TextBlock x:Name="BestLine"/><TextBlock x:Name="CompareSep" Text="·"/><TextBlock x:Name="FarmLine"/>
            </StackPanel>
            <UniformGrid x:Name="Tiles" Columns="3" Rows="1">
              <Border x:Name="Tile1"><StackPanel><TextBlock x:Name="KinahHr" Text="0"/><TextBlock x:Name="Tile1Label" Text="Kinah an hour"/></StackPanel></Border>
              <Border x:Name="Tile2"><StackPanel><TextBlock x:Name="KinahKill" Text=" "/><TextBlock x:Name="Tile2Label" Text="Kinah a kill"/></StackPanel></Border>
              <Border x:Name="Tile3"><StackPanel><TextBlock x:Name="KillsHr" Text="0"/><TextBlock x:Name="Tile3Label" Text="kills an hour"/></StackPanel></Border>
              <Border x:Name="Tile4"><StackPanel><TextBlock x:Name="DropsHr" Text="0"/><TextBlock x:Name="Tile4Label" Text="drops a kill"/></StackPanel></Border>
              <StackPanel x:Name="ValueTile"><TextBlock x:Name="ValueHr" Text=" "/><TextBlock x:Name="Tile5Label" Text="total/hr"/></StackPanel>
            </UniformGrid>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- three chips (Quest): Kinah, loot, kills; a click opens what is behind it under the row: Kinah by enemy, the bag,
           kills by enemy (Ui/MainWindow.QuestFarm.cs) -->
      <Grid x:Name="ChipsRow" Margin="0,8,0,0" Visibility="Collapsed">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border x:Name="ChipKinah" Style="{StaticResource QChip}"/>
        <Border x:Name="ChipLoot" Grid.Column="2" Style="{StaticResource QChip}"/>
        <Border x:Name="ChipKills" Grid.Column="4" Style="{StaticResource QChip}"/>
      </Grid>
      <!-- the bag at a glance (Compact): the session's items as inventory slots with their counts, the total on the right;
           a click on the head opens the bag card under it (Ui/MainWindow.QuestFarm.cs FillBagStrip) -->
      <Border x:Name="BagStrip" Style="{StaticResource QCard}" Margin="0,8,0,0" Padding="14,10,14,10" Visibility="Collapsed">
        <StackPanel>
          <Grid x:Name="BagStripHead" Background="Transparent" Cursor="Hand">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Image Source="/Art/attendance.png" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Grid.Column="1" Text="The bag" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <TextBlock x:Name="BagStripNote" Grid.Column="2" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="BagStripTotal" Grid.Column="3" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Gold}" VerticalAlignment="Center"/>
            <Path x:Name="BagStripChev" Grid.Column="4" Style="{StaticResource QChev}"/>
          </Grid>
          <WrapPanel x:Name="BagStripHost" Margin="0,8,0,-6"/>
        </StackPanel>
      </Border>
      <Border x:Name="ChipPanel" Style="{StaticResource QCard}" Margin="0,8,0,0" Visibility="Collapsed">
        <StackPanel x:Name="ChipPanelHost"/>
      </Border>

      <!-- the bag (LOOT since 2026-10-28, Ui/MainWindow.Loot.cs): what was picked up, as slots with the game-tooltip card on
           hover, for one period at a time: this zone since you arrived (or the run, or every zone), Today, or the Week. It
           opens from the loot chip in Compact; in Full view it is a column of its own -->
      <Border x:Name="SummaryCard" Style="{StaticResource QCard}" Margin="0,8,0,0" Visibility="Collapsed">
        <StackPanel>
          <Grid x:Name="SessionHead" Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Image Source="/Art/attendance.png" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Grid.Column="1" Text="The bag" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <TextBlock x:Name="FootTotalNote" Grid.Column="2" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
            <!-- one period at a time: this zone (or the run, or All zones), today, or the week -->
            <Border x:Name="LootScope" Grid.Column="3" Padding="3" CornerRadius="10" Background="{DynamicResource Bg}" VerticalAlignment="Center" Margin="12,0,0,0">
              <StackPanel Orientation="Horizontal">
                <Button x:Name="LootHereBtn" Style="{StaticResource SegOn}" Content="This zone" Height="24" FontSize="11.5" Padding="10,0" ToolTip="Since you came to this zone. It starts over when you change zone."/>
                <Button x:Name="LootTodayBtn" Style="{StaticResource SegOff}" Content="Today" Height="24" FontSize="11.5" Padding="10,0" Margin="2,0,0,0" ToolTip="Today's farming since midnight on this PC, every zone."/>
                <!-- the last 7 days (0.9, History A of kinah-bench/mock-goals-history): Ui/MainWindow.Week.cs -->
                <Button x:Name="LootWeekBtn" Style="{StaticResource SegOff}" Content="Week" Height="24" FontSize="11.5" Padding="10,0" Margin="2,0,0,0" ToolTip="The last 7 days of farming on this PC, a bar a day."/>
              </StackPanel>
            </Border>
            <TextBlock x:Name="FootTotal" Grid.Column="4" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Gold}" VerticalAlignment="Center" Margin="12,0,0,0" Text=" " MinWidth="40" TextAlignment="Right" Background="Transparent" ToolTipService.InitialShowDelay="250" ToolTipService.ShowDuration="30000"/>
          </Grid>
          <StackPanel x:Name="SessionBody">
            <StackPanel x:Name="LootHost"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Next up (Quest): today's goals and the milestones the pace puts minutes away, as rows with a thin bar; two at rest,
           the rest on a click. With nothing to count down to, one line: "Set a goal for today" (Ui/MainWindow.Goals.cs) -->
      <Border x:Name="GoalsCard" Style="{StaticResource QCard}" Margin="0,8,0,0" Visibility="Collapsed">
        <StackPanel>
          <!-- no goal and nothing counted yet: the whole row is one button (keyboard focus, a name for screen readers) that
               opens Set a goal, the same sheet as the three dots' Set a goal -->
          <Button x:Name="GoalsSlim" Cursor="Hand" Visibility="Collapsed" AutomationProperties.Name="Set a goal for today" ToolTip="Kinah, an item or runs to reach today. Up to three, shown here.">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border Background="Transparent">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Image Source="/Art/medalgold.png" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Grid.Column="1" Text="Next up" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="SlimLink" Grid.Column="2" FontSize="11.5" FontWeight="Medium" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Right" Text="⊕ Set a goal for today"/>
                  </Grid>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SlimLink" Property="Foreground" Value="{DynamicResource Ink}"/></Trigger>
                  <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SlimLink" Property="Foreground" Value="{DynamicResource Ink}"/></Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
          </Button>
          <StackPanel x:Name="GoalsBox">
            <Grid x:Name="GoalsHead" Background="Transparent" Cursor="Hand">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Image Source="/Art/medalgold.png" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
              <TextBlock Grid.Column="1" Text="Next up" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
              <!-- "at this pace · 3 more" -->
              <TextBlock x:Name="GoalsNote" Grid.Column="2" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
              <Path x:Name="GoalsChev" Grid.Column="3" Style="{StaticResource QChev}"/>
            </Grid>
            <!-- three bars and no more (Steven, 2026-11-08): the rest is the Quests page -->
            <StackPanel x:Name="GoalsHost" Margin="0,2,0,0"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Just dropped (Quest): the last five things counted, newest first, each with the game's icon and its worth in mint;
           a line that looks wrong is clicked and filed as a miscount report (Ui/MainWindow.Live.cs) -->
      <Border x:Name="FeedCard" Style="{StaticResource QCard}" Margin="0,8,0,0">
        <StackPanel>
          <Grid Margin="0,0,0,2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Image Source="/Art/attendance.png" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Grid.Column="1" Text="Just dropped" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <TextBlock x:Name="FeedNote" Grid.Column="2" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
          </Grid>
          <Border x:Name="FeedBox" Background="Transparent" ClipToBounds="True"
                  ToolTip="A line wrong? Click it to report it. A pickup that never showed: ⋯ › A pickup is missing." ToolTipService.InitialShowDelay="900">
            <Grid>
              <StackPanel x:Name="FeedHost"/>
              <!-- what the empty feed waits for, from the reader (FillFeedEmpty): the game, the chat, or the first pickup -->
              <!-- and while a new player sets up, the first-session checklist under it (Ui/MainWindow.Onboard.cs, 2026-11-04) -->
              <StackPanel x:Name="FeedEmptyBox">
                <TextBlock x:Name="FeedEmpty" Style="{StaticResource BodyStyle}" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource Faint}" Margin="0,8,0,4" TextWrapping="Wrap"
                           Text="Ready. Pick something up and it shows here, newest first."/>
                <StackPanel x:Name="FeedOnboard" Margin="0,6,0,4" Visibility="Collapsed"/>
              </StackPanel>
            </Grid>
          </Border>
          <!-- kept as the place a marked line's Undo goes; the hint itself moved to the feed's hover and the three dots (2026-10-28) -->
          <TextBlock x:Name="FeedHint" FontSize="11.5" Foreground="{DynamicResource Faint}" Margin="0,8,0,0" Background="Transparent" Cursor="Hand" HorizontalAlignment="Left" Visibility="Collapsed"
                     Text="A line wrong or missing? Click it." ToolTip="Click a wrong line to report it, or here for a pickup that never showed. The report is saved on this PC."/>
        </StackPanel>
      </Border>

      <!-- Where next (Quest): the zone that pays more than here as one line with a pin; a click opens the board, the best zones
           for the player's gear as bars (FillWhere) -->
      <Border x:Name="WhereSection" Style="{StaticResource QCard}" Margin="0,8,0,0" Padding="14,10,14,10" Visibility="Collapsed">
        <StackPanel>
          <Grid x:Name="WhereHead" Background="Transparent" Cursor="Hand">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border x:Name="WhereIcon" Width="30" Height="30" CornerRadius="10" Background="{DynamicResource SkyTint}" VerticalAlignment="Center">
              <Image x:Name="WhereIconPath" Source="/Art/rift.png" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
              <TextBlock x:Name="WhereTitle" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="WhereNote" FontSize="11.5" FontWeight="Medium" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock x:Name="WhereSum" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
              <Path x:Name="WhereChev" Style="{StaticResource QChev}"/>
            </StackPanel>
          </Grid>
          <StackPanel x:Name="WhereBody" Margin="0,10,0,0" Visibility="Collapsed"/>
        </StackPanel>
      </Border>
    </StackPanel>

      <!-- status: on the Farming part in Compact, the farming card's footer (JoinCards); a plain line under the rest -->
      <Border x:Name="StatusBar" Grid.Row="3" Grid.ColumnSpan="2" Width="662" HorizontalAlignment="Left" Margin="0,14,0,0">
      <Border x:Name="StatusInner" BorderBrush="{DynamicResource Line}">
      <Grid x:Name="StatusRow">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <!-- how the count held up against the game's own numbers, as one chip in the look's colours; a click opens the Accuracy
             card over the window (Ui/MainWindow.AccuracyCard.cs). In the footer since 2026-10-28. Since 0.9.0 it shows only
             with Options › Show accuracy details on: the "2 to look at" pill is gone for players (Steven, 2026-10-30) -->
        <Border x:Name="AccuracyChip" Margin="0,0,12,0" HorizontalAlignment="Left" VerticalAlignment="Center" Height="26" CornerRadius="8" BorderThickness="1" Padding="11,0,12,1"
                Cursor="Hand" Visibility="Collapsed" MouseLeftButtonUp="AccuracyChipClick" AutomationProperties.Name="Accuracy"
                ToolTip="How the count held up against the game's own numbers. Click to see." ToolTipService.InitialShowDelay="400">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Background" Value="{DynamicResource ChipOff}"/>
              <Setter Property="BorderBrush" Value="{DynamicResource ChipOffLine}"/>
              <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource GoldLine}"/></Trigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
        </Border>
        <TextBlock x:Name="Status" Grid.Column="1" Foreground="{DynamicResource Faint}" FontSize="12" TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis" Background="Transparent" ToolTipService.InitialShowDelay="250" VerticalAlignment="Center"/>
        <!-- shown with a reading problem: straight to the page that fixes it -->
        <TextBlock x:Name="FixText" Grid.Column="2" FontSize="12" Margin="12,0,0,0" Visibility="Collapsed" VerticalAlignment="Center"><Hyperlink x:Name="FixLink" Style="{StaticResource LinkStyle}">Game reading options</Hyperlink></TextBlock>
        <!-- the last minute of what was read and counted, saved on this PC (2026-10-23) and, since 0.9.0, sent to the site's
             report table with other players' chat taken out (Ui/MainWindow.xaml.cs ReportMiscount, Upload/ReportClient.cs) -->
        <TextBlock x:Name="MiscountText" Grid.Column="3" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center"
                   ToolTip="Sends this report to Kinah Ledger (no chat from other players): what the tracker read and counted in the last minute. A copy stays on this PC."><Hyperlink x:Name="MiscountLink" Style="{StaticResource LinkStyle}">Report a miscount</Hyperlink></TextBlock>
        <!-- the Kinah Ledger Discord: where a miscount report goes (#bugs-and-feedback), help and release news (2026-10-25) -->
        <TextBlock x:Name="DiscordText" Grid.Column="4" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center"
                   ToolTip="Opens the Kinah Ledger Discord in your browser. Post a miscount in #bugs-and-feedback with a screenshot, your server and the tracker version."><Hyperlink x:Name="DiscordLink" Style="{StaticResource LinkStyle}">Discord</Hyperlink></TextBlock>
        <!-- Always on top, in sight (Steven, 2026-11-11: "so I stop losing the window"): the same switch as Options › General
             and the ⋯ menu's Keep above other windows (MainWindow.Shell.cs SetAlwaysOnTop) -->
        <CheckBox x:Name="TopmostBox" Grid.Column="5" Content="Always on top" FontSize="12" Margin="14,-3,0,-3" VerticalAlignment="Center"
                  Foreground="{DynamicResource Muted}" Click="TopmostBox_Click" AutomationProperties.Name="Always on top"
                  ToolTip="Keeps this window above the game and other windows. The same switch as Options › General." ToolTipService.InitialShowDelay="400"/>
      </Grid>
      </Border>
      </Border>

    <!-- the right column (Full view, or Crafting and Events): the tables, scrolling once they'd run past the screen; the bar
         sits in the window's right padding, so the cards keep their width -->
    <ScrollViewer x:Name="LowerScroll" Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="16,0,-20,0" Focusable="False" Visibility="Collapsed">
      <StackPanel Width="662" HorizontalAlignment="Left">

      <!-- the Quest right column (Full view, 2026-11-07, Ui/MainWindow.QuestFull.cs): the bag as tiles (LOOT's card, moved in by
           ApplyView), Kinah by enemy as bars, drop odds as badges, the zone board as bars (Where next, moved in too), gathering as two chips -->
      <StackPanel x:Name="QuestRight" Margin="0,2,0,0" Visibility="Collapsed">
        <Border x:Name="QuestWho" Style="{StaticResource QCard}" Margin="0,8,0,0" Visibility="Collapsed"><StackPanel x:Name="QuestWhoHost"/></Border>
        <Border x:Name="QuestOdds" Style="{StaticResource QCard}" Margin="0,8,0,0" Visibility="Collapsed"><StackPanel x:Name="QuestOddsHost"/></Border>
        <Grid x:Name="QuestGather" Margin="0,8,0,0" Visibility="Collapsed">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Border x:Name="GatherChip1" Style="{StaticResource QChip}" Cursor="Arrow"/>
          <Border x:Name="GatherChip2" Grid.Column="2" Style="{StaticResource QChip}" Cursor="Arrow"/>
        </Grid>
      </StackPanel>

      <Border x:Name="TablesCard" Background="{DynamicResource Card}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1,0,1,0">
        <StackPanel x:Name="TableStack">
          <!-- idle time and skipped reward lines; each shown only once there is something to say -->
          <TextBlock x:Name="Summary" Foreground="{DynamicResource Faint}" FontSize="12" Margin="20,12,20,0" TextWrapping="Wrap" Visibility="Collapsed"/>
          <!-- with nothing counted yet, one line instead of empty sections; each section appears with its first row -->
          <TextBlock x:Name="TablesEmpty" Style="{StaticResource BodyStyle}" FontSize="12.5" Foreground="{DynamicResource Faint}" Margin="20,16,20,14" TextWrapping="Wrap"
                     Text="Loot shows here as it comes in: drops from kills, gathering, Kinah by enemy and Soul Crystals."/>
          <!-- loot from other zones for the sections empty here, in one line; All zones counts them together -->
          <TextBlock x:Name="OtherZones" Foreground="{DynamicResource Muted}" FontSize="12.5" Margin="20,14,20,4" TextWrapping="Wrap" Visibility="Collapsed" Background="Transparent"
                     ToolTip="The tables show this zone only, and start over when you change zone. Turn on All zones (the … button) to count every zone together."/>

          <!-- Drops from kills: open by default; one aligned table, the crafting materials under their own sub-line -->
          <Border x:Name="DropsSection" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
            <StackPanel>
              <Grid x:Name="DropsHead" Height="48" Background="Transparent" Cursor="Hand">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Path x:Name="DropsChev" Style="{StaticResource SecChev}" Margin="20,0,10,0"/>
                <TextBlock x:Name="DropsTitle" Grid.Column="1" Style="{StaticResource SecTitle}" Text="DROPS FROM KILLS"/>
                <TextBlock x:Name="DropsNote" Grid.Column="2" Style="{StaticResource SecNote}"/>
              </Grid>
              <StackPanel x:Name="DropsOpenBody" Margin="20,0,20,16">
                <Grid Height="24">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/><ColumnDefinition Width="76"/><ColumnDefinition Width="64"/><ColumnDefinition Width="84"/></Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="2" Style="{StaticResource FTh}" Text="Qty"/>
                  <TextBlock x:Name="PctHeader" Grid.Column="3" Style="{StaticResource FTh}" Text="Odds" Background="Transparent" Cursor="Hand"/>
                  <TextBlock Grid.Column="4" Style="{StaticResource FTh}" Text="An hour"/>
                  <TextBlock Grid.Column="5" Style="{StaticResource FTh}" Text="Value" ToolTip="Quantity times the lowest Market price on your server, less the Market's fee and tax unless Options › General shows amounts before it, like the Session total. Bound copies can't be sold and have no value here."/>
                </Grid>
                <Grid MinHeight="40">
                  <ScrollViewer x:Name="DropsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                      <ItemsControl x:Name="Rows" ItemTemplate="{StaticResource FarmRowTemplate}"/>
                      <Grid x:Name="MatHead" Height="34" Visibility="Collapsed">
                        <TextBlock x:Name="MatTitle" Text="CRAFTING MATERIALS" Foreground="{DynamicResource Faint}" FontSize="11" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                      </Grid>
                      <ItemsControl x:Name="MatRows" ItemTemplate="{StaticResource FarmRowTemplate}"/>
                    </StackPanel>
                  </ScrollViewer>
                  <TextBlock x:Name="TableEmpty" Style="{StaticResource BodyStyle}" FontSize="12.5" Foreground="{DynamicResource Faint}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" MaxWidth="420"
                             Text="Drops show here as they're read, with the odds and how many come an hour."/>
                </Grid>
                <!-- the top rows only, until "show all" is pressed -->
                <TextBlock x:Name="DropsMore" FontSize="12" Margin="0,8,0,0" Visibility="Collapsed"><Hyperlink x:Name="DropsMoreLink" Style="{StaticResource LinkStyle}"><Run x:Name="DropsMoreRun" Text="Show all"/></Hyperlink></TextBlock>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Also this session: one chip each for Gathered, a gathering skill, Soul Crystals and Kinah by enemy; a chip opens its own small table in place -->
          <Border x:Name="ExtrasSection" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Visibility="Collapsed">
            <StackPanel>
              <Grid x:Name="ExtrasHead" Height="48" Background="Transparent" Cursor="Hand">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Path x:Name="ExtrasChev" Style="{StaticResource SecChev}" Margin="20,0,10,0"/>
                <TextBlock Grid.Column="1" Style="{StaticResource SecTitle}" Text="ALSO THIS SESSION"/>
              </Grid>
              <StackPanel x:Name="ExtrasBody" Margin="20,0,20,16">
                <WrapPanel x:Name="ExtraChips"/>
                <TextBlock x:Name="GatherLimit" FontSize="11.5" Foreground="{DynamicResource Muted}" Margin="0,0,0,6" Visibility="Collapsed"/>
                <!-- the open chip's table, in place, under a gold rule on its left -->
                <Border x:Name="InPlace" BorderBrush="{DynamicResource GoldLine}" BorderThickness="2,0,0,0" Padding="12,0,0,0" Margin="0,4,0,0" Visibility="Collapsed">
                  <StackPanel>
                    <Grid x:Name="InPlaceHead" Height="24">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="72"/><ColumnDefinition Width="80"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                      <TextBlock x:Name="InPlaceH1" Grid.Column="2" Style="{StaticResource FTh}"/>
                      <TextBlock x:Name="InPlaceH2" Grid.Column="3" Style="{StaticResource FTh}"/>
                      <TextBlock x:Name="InPlaceH3" Grid.Column="4" Style="{StaticResource FTh}"/>
                    </Grid>
                    <TextBlock x:Name="InPlaceLead" FontSize="12" Foreground="{DynamicResource Faint}" Margin="0,4,0,4" TextWrapping="Wrap" Visibility="Collapsed"/>
                    <ItemsControl x:Name="GatherRows" ItemTemplate="{StaticResource SmallRowTemplate}"/>
                    <ItemsControl x:Name="MobRows" ItemTemplate="{StaticResource SmallRowTemplate}"/>
                    <ItemsControl x:Name="PetRows" ItemTemplate="{StaticResource SmallRowTemplate}"/>
                    <StackPanel x:Name="SkillLines"/>
                    <TextBlock x:Name="InPlaceNote" FontSize="12" Foreground="{DynamicResource Faint}" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                    <TextBlock x:Name="InPlaceMore" FontSize="12" Margin="0,8,0,0" Visibility="Collapsed"><Hyperlink x:Name="InPlaceMoreLink" Style="{StaticResource LinkStyle}"><Run x:Name="InPlaceMoreRun" Text="Show all"/></Hyperlink></TextBlock>
                    <!-- the enemy pictures are MetaBot.GG's copies of the game portraits; its terms ask for a link back -->
                    <TextBlock x:Name="MobCredit" FontSize="11" Foreground="{DynamicResource Faint}" Margin="0,6,0,0" Visibility="Collapsed">
                      <Run Text="Enemy pictures from "/><Hyperlink x:Name="MobCreditLink" Style="{StaticResource LinkStyle}">MetaBot.GG</Hyperlink>
                    </TextBlock>
                  </StackPanel>
                </Border>
              </StackPanel>
            </StackPanel>
          </Border>

          <TextBlock x:Name="TableNote" Style="{StaticResource BodyStyle}" Foreground="{DynamicResource Faint}" FontSize="11.5" Margin="20,0,20,12" TextWrapping="Wrap" Visibility="Collapsed"/>
        </StackPanel>
      </Border>
      <!-- Expeditions and events: their own part of the window, never on the Farming page (Steven, 2026-10-22). One box
           (Ui/MainWindow.RunsCard.cs BuildPlaceBox, 2026-11-06): the place picked from its band's dropdown and its loot laid out as the
           TODAY strip's, This session or All time; the runs stay until cleared. Share, every run, Save as CSV and Clear are under ⋯. -->
      <Border x:Name="EventsCard" Margin="0,16,0,0" Visibility="Collapsed">
        <StackPanel>
          <Grid Margin="2,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <!-- the title with what the runs shown made under it: "20 runs · 14 counted · 7.46M made" (0.8.31, the mock) -->
            <StackPanel VerticalAlignment="Bottom">
              <TextBlock FontFamily="{DynamicResource DisplayFont}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" Text="Expeditions and events"/>
              <TextBlock x:Name="InstWhat" Foreground="{DynamicResource Muted}" FontSize="12" FontWeight="Medium" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
              <!-- Share (0.9.3): the last run as a picture, the same sheet as Farming's (Ui/MainWindow.Share.cs) -->
              <Button x:Name="EventsShareBtn" Content="Share" Height="30" FontSize="12.5" Padding="12,0" Margin="0,0,8,0" VerticalAlignment="Center" IsEnabled="False" Visibility="Collapsed"
                      BorderBrush="{DynamicResource GoldLine}" Foreground="{DynamicResource Gold}" AutomationProperties.Name="Share the last run"
                      ToolTip="A picture of the last run, to paste in Discord or anywhere. Nothing is uploaded."/>
              <!-- this session's runs by default, or with the ones kept on this PC from earlier (Steven, 2026-10-22); a switch
                   and a button, not small links (Steven, 2026-10-23: "more prevalent") -->
              <Border x:Name="InstScope" Padding="3" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource CardLine}" Background="{DynamicResource SegGroup}" VerticalAlignment="Center" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                  <Button x:Name="InstSessionBtn" Style="{StaticResource SegOn}" Content="This session" Height="26" FontSize="12.5" Padding="10,0" ToolTip="Only the runs since the tracker started"/>
                  <Button x:Name="InstEarlierBtn" Style="{StaticResource SegOff}" Content="All time" Height="26" FontSize="12.5" Padding="10,0" Margin="2,0,0,0" ToolTip="Every run kept on this PC, earlier sessions too"/>
                </StackPanel>
              </Border>
              <Button x:Name="InstClearBtn" Content="Clear" Height="30" FontSize="12.5" Padding="10,0" Margin="6,0,0,0" VerticalAlignment="Center" Background="Transparent" BorderBrush="Transparent" Foreground="{DynamicResource Faint}" FontWeight="Normal" ToolTip="Clear the runs shown here" Visibility="Collapsed"/>
              <!-- the rest, out of the way (2026-11-06): Share the last run, every run on its line, Save as CSV, Clear -->
              <Button x:Name="EventsMoreBtn" Style="{StaticResource RoundBtn}" Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="More: share the last run, every run on its line, Save as CSV, clear" AutomationProperties.Name="More">
                <TextBlock Text="⋯" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource Muted}" Margin="0,-3,0,0"/>
              </Button>
            </StackPanel>
          </Grid>
          <!-- the Share sheet while it is open from this page (0.9.3) -->
          <Border x:Name="EventsShareHost" Margin="0,0,0,16" Visibility="Collapsed"/>
          <StackPanel x:Name="InstHost"/>
          <Border x:Name="InstEmpty" Style="{StaticResource QCard}" Padding="20,22,20,22">
            <TextBlock Style="{StaticResource BodyStyle}" FontSize="12.5" Foreground="{DynamicResource Faint}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="440"
                       Text="Run an expedition or join an event. Each one shows here with how long it took and what it paid."/>
          </Border>
        </StackPanel>
      </Border>

      <!-- Quests (2026-11-08, Ui/MainWindow.QuestsPage.cs): the score on the head, This session, Daily, All time, Your goals, Done -->
      <StackPanel x:Name="QuestsPage" Margin="0,12,0,0" Visibility="Collapsed">
        <Grid Margin="2,0,0,12">
          <StackPanel>
            <TextBlock FontFamily="{DynamicResource DisplayFont}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" Text="Quests"/>
            <TextBlock Foreground="{DynamicResource Muted}" FontSize="12" FontWeight="Medium" Margin="0,3,0,0" TextWrapping="Wrap"
                       Text="Each quest is the next step of something you farm. Reach one to earn points (pts): bigger steps and rarer materials earn more."/>
          </StackPanel>
          <!-- the score, one line once there are points; the breakdown on hover -->
          <TextBlock x:Name="QuestsScoreLine" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,0,0" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Gold}" Visibility="Collapsed"/>
        </Grid>
        <Border x:Name="QuestsOffCard" Style="{StaticResource QCard}" Padding="20,22,20,22" Visibility="Collapsed">
          <TextBlock Style="{StaticResource BodyStyle}" FontSize="12.5" Foreground="{DynamicResource Faint}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="440"
                     Text="Quests are off. Turn them on in Options › General to get goals from what you farm, points for reaching them, and a score on your profile."/>
        </Border>
        <Border x:Name="QuestsActiveCard" Style="{StaticResource QCard}"><StackPanel x:Name="QuestsActiveHost"/></Border>
        <Border x:Name="QuestsDailyCard" Style="{StaticResource QCard}" Margin="0,8,0,0"><StackPanel x:Name="QuestsDailyHost"/></Border>
        <Border x:Name="QuestsAllTimeCard" Style="{StaticResource QCard}" Margin="0,8,0,0"><StackPanel x:Name="QuestsAllTimeHost"/></Border>
        <Border x:Name="QuestsGoalsCard" Style="{StaticResource QCard}" Margin="0,8,0,0"><StackPanel x:Name="QuestsGoalsHost"/></Border>
        <Border x:Name="QuestsDoneCard" Style="{StaticResource QCard}" Margin="0,8,0,0"><StackPanel x:Name="QuestsDoneHost"/></Border>
      </StackPanel>

      <!-- Crafting (direction C, 2026-10-24): the last five crafts beside the session's profit, then This session (every recipe
           crafted since the tracker started: tries, worked, spent, sells for, profit) and Best crafts today. Crafted items never
           count as drops, and crafting is never farming time. -->
      <!-- the Crafting page (Quest, 2026-11-07, step 3, Ui/MainWindow.QuestCraft.cs): profit as the hero in mint with the ring of
           crafts that worked; three chips; Next up (the next round profit and the recipe that pays most today); Just crafted with
           a worked or failed dot on each item; the recipes this session as small cards; Best crafts today behind its head -->
      <Border x:Name="CraftCard" Margin="0,10,0,0" Background="Transparent" BorderThickness="0" Visibility="Collapsed">
        <StackPanel>
          <Border x:Name="CraftHero" Style="{StaticResource QCard}" Background="{DynamicResource HeroBg}" Padding="16,12,16,12">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock x:Name="CraftWhere" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource Muted}" Text="Crafting" TextTrimming="CharacterEllipsis"/>
                  <!-- the queue under way: "3 of 10 · 2 worked · 1 unsure" (Steven, 2026-11-04: a miss should show while it happens) -->
                  <TextBlock x:Name="CraftQueueNow" FontSize="11.5" FontWeight="Medium" Foreground="{DynamicResource Faint}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
                  <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock x:Name="CraftProfit" FontFamily="{DynamicResource DisplayFont}" FontSize="44" FontWeight="Bold" Foreground="{DynamicResource Mint}" Text=" " LineHeight="42" LineStackingStrategy="BlockLineHeight"/>
                    <TextBlock x:Name="CraftProfitNote" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource Muted}" Margin="8,0,0,7" VerticalAlignment="Bottom" TextWrapping="Wrap" MaxWidth="230" Text="profit this session"/>
                  </StackPanel>
                  <!-- the chase: how many crafts worked, spent against sells for -->
                  <StackPanel x:Name="CraftChaseBox" Margin="0,8,0,0" Visibility="Collapsed">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <TextBlock x:Name="CraftChaseLbl" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                        <Path Style="{StaticResource QIconStyle}" Data="{StaticResource IcCheck}" Width="13" Height="13" StrokeThickness="2.4" Stroke="{DynamicResource Mint}"/>
                        <TextBlock x:Name="CraftChaseBest" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Mint}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Grid>
                    <Grid Margin="0,6,0,0">
                      <Border x:Name="CraftChaseTrack" Height="12" CornerRadius="6" Background="{DynamicResource Bg}"/>
                      <Border x:Name="CraftChaseFill" Height="12" HorizontalAlignment="Left" Width="0" CornerRadius="6" Background="{DynamicResource Mint}">
                        <Border CornerRadius="6" Margin="1"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#55FFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="0.6"/></LinearGradientBrush></Border.Background></Border>
                      </Border>
                    </Grid>
                  </StackPanel>
                  <!-- the figures the code still writes (crafts, worked, made, spent, sells for): the chips say them -->
                  <TextBlock x:Name="CraftWhat" Visibility="Collapsed"/>
                  <StackPanel x:Name="CraftHealth" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
                    <Path x:Name="CraftHealthMark" Width="13" Height="13" Stretch="Uniform" Stroke="{DynamicResource Good}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M3.5,8.5 L6.5,11.5 L12.5,4.5" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="CraftHealthText" FontSize="11.5" FontWeight="Medium" Foreground="{DynamicResource Faint}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="300"/>
                  </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="120">
                  <Grid x:Name="CraftRingHost" Width="76" Height="76" HorizontalAlignment="Center"/>
                  <TextBlock x:Name="CraftResetText" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0"><Hyperlink x:Name="CraftCsvLink" Style="{StaticResource LinkStyle}" ToolTip="This session's recipes as a file for a spreadsheet: tries, worked, what came out, cost, what it sells for, profit. Nothing is uploaded.">Save as CSV</Hyperlink><Run Text="   ·   " Foreground="{DynamicResource Faint}"/><Hyperlink x:Name="CraftResetLink" Style="{StaticResource LinkStyle}">Start over</Hyperlink></TextBlock>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <Grid x:Name="CraftChips" Margin="0,8,0,0" Visibility="Collapsed">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border x:Name="ChipCrafts" Style="{StaticResource QChip}" Cursor="Arrow"/>
            <Border x:Name="ChipSpent" Grid.Column="2" Style="{StaticResource QChip}" Cursor="Arrow"/>
            <Border x:Name="ChipSells" Grid.Column="4" Style="{StaticResource QChip}" Cursor="Arrow"/>
          </Grid>

          <Border x:Name="CraftNextCard" Style="{StaticResource QCard}" Margin="0,8,0,0" Visibility="Collapsed">
            <StackPanel x:Name="CraftNextHost"/>
          </Border>

          <!-- Just crafted: the last five crafts, worked or failed, with what each made or cost; a line that looks wrong is clicked and reported -->
          <Border x:Name="CraftFeedCard" Style="{StaticResource QCard}" Margin="0,8,0,0">
            <StackPanel>
              <Grid Margin="0,0,0,2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Image Source="/Art/scroll.png" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Grid.Column="1" Text="Just crafted" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock x:Name="CraftFeedNote" Grid.Column="2" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Right" Text="last five · click one for its recipe"/>
              </Grid>
              <Grid>
                <StackPanel x:Name="CraftFeedHost"/>
                <TextBlock x:Name="CraftEmpty" Style="{StaticResource BodyStyle}" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource Faint}" Margin="0,8,0,4" TextWrapping="Wrap"
                           Text="Open the crafting window and queue a craft. It shows here, newest first."/>
              </Grid>
              <TextBlock x:Name="CraftHint" FontSize="11.5" Foreground="{DynamicResource Faint}" Margin="0,8,0,0" Background="Transparent" Cursor="Hand" HorizontalAlignment="Left" Visibility="Collapsed"
                         Text="A craft wrong or missing? Click it." ToolTip="Click a wrong craft to report it, or here for one that never showed. The report is saved on this PC."/>
            </StackPanel>
          </Border>

          <!-- Recipes this session: a small card per recipe (crafts, worked, profit); a card opens its recipe's breakdown -->
          <Border x:Name="CraftHead" Style="{StaticResource QCard}" Margin="0,8,0,0">
            <StackPanel>
              <Grid x:Name="CraftSessionHead" Background="Transparent" Cursor="Hand">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Image Source="/Art/scroll.png" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Grid.Column="1" Text="Recipes this session" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock x:Name="CraftSpentNote" Grid.Column="2" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="CraftSpent" Grid.Column="3" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Gold}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                <Path x:Name="CraftSessionChev" Grid.Column="4" Style="{StaticResource QChev}"/>
              </Grid>
              <StackPanel x:Name="CraftBody" Margin="0,8,0,0">
                <WrapPanel x:Name="CraftRecipeHost" Margin="0,0,-8,-8"/>
                <!-- the table the code fills (its rows feed the recipe cards and the panel over the game); not drawn since the Quest look -->
                <StackPanel Visibility="Collapsed">
                  <ScrollViewer x:Name="CraftScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="CraftRows" ItemTemplate="{StaticResource CraftRowTemplate}"/>
                  </ScrollViewer>
                </StackPanel>
                <TextBlock x:Name="CraftMadeNote" FontSize="11.5" FontWeight="Medium" Foreground="{DynamicResource Faint}" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- the server's most profitable recipes today (kinahledger.com /crafts), behind its head and Next up's "all N" -->
          <Border x:Name="BestCraftsCard" Style="{StaticResource QCard}" Margin="0,8,0,0" Visibility="Collapsed">
            <StackPanel>
              <Grid x:Name="BestHead" Background="Transparent" Cursor="Hand">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Image Source="/Art/medalgold.png" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Grid.Column="1" Text="Best crafts today" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock x:Name="BestNote" Grid.Column="2" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
                <Path x:Name="BestChev" Grid.Column="3" Style="{StaticResource QChev}"/>
              </Grid>
              <StackPanel x:Name="BestCraftsHost" Margin="0,8,0,0"/>
            </StackPanel>
          </Border>

          <!-- the recipes come from MetaBot.GG, whose terms ask for a link to the page they came from -->
          <TextBlock x:Name="CraftCredit" Foreground="{DynamicResource Faint}" FontSize="11" FontWeight="Medium" Margin="4,8,4,0" TextWrapping="Wrap">
            <Run x:Name="CraftNote" Text="Lowest Market price on your server"/><Run Text="  ·  recipes from "/><Hyperlink x:Name="CraftCreditLink" Style="{StaticResource LinkStyle}">MetaBot.GG</Hyperlink>
          </TextBlock>
        </StackPanel>
      </Border>
      </StackPanel>
    </ScrollViewer>

    </Grid>

    <!-- the Undo bar (Ui/MainWindow.Undo.cs): for 8 s after clearing the tables or the runs, starting crafting over,
         removing a run or stopping a run from this window. The game-tooltip look, the same in every look of the window;
         a gold line runs down the seconds left. Ctrl+Z works too. -->
    <Border x:Name="UndoBar" VerticalAlignment="Bottom" HorizontalAlignment="Left" Width="622" Margin="20,0,0,10" CornerRadius="6" BorderThickness="1" BorderBrush="#2E3346" Visibility="Collapsed">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#171920" Offset="0"/><GradientStop Color="#0E0F14" Offset="1"/></LinearGradientBrush>
      </Border.Background>
      <Border.Effect><DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.55"/></Border.Effect>
      <Grid>
        <Grid Height="44" Margin="16,0,8,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <!-- a check in a gold-framed slot -->
          <Border Width="22" Height="22" CornerRadius="4" BorderThickness="1" BorderBrush="#8CFFD27A" Background="#0F1014" VerticalAlignment="Center" Margin="0,0,12,0">
            <Path Data="M5,12 L10,17 L19,7" Stroke="#FFD27A" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Margin="5"/>
          </Border>
          <TextBlock x:Name="UndoText" Grid.Column="1" Foreground="#EDEFF5" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
          <Button x:Name="UndoBtn" Grid.Column="2" Content="Undo" Height="30" FontSize="13" FontWeight="Normal" Margin="12,0,0,0" VerticalAlignment="Center"
                  Foreground="#FFD27A" ToolTip="Put it back (Ctrl+Z)" AutomationProperties.Name="Undo">
            <!-- its own colours: the look's hover brushes are made for the window's cards, not this dark bar -->
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border x:Name="b" Background="#14FFD27A" BorderBrush="#80FFD27A" BorderThickness="1" CornerRadius="8" Padding="16,0">
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#33FFD27A"/></Trigger>
                  <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.8"/></Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
          </Button>
        </Grid>
        <!-- the time left: a gold line along the bottom that shortens to nothing over the 8 seconds -->
        <Border x:Name="UndoTime" Height="2" VerticalAlignment="Bottom" Margin="6,0,6,1" Background="#FFD27A" Opacity="0.7" RenderTransformOrigin="0,0.5">
          <Border.RenderTransform><ScaleTransform x:Name="UndoTimeScale" ScaleX="1"/></Border.RenderTransform>
        </Border>
      </Grid>
    </Border>

    <!-- the toast (Ui/MainWindow.Toast.cs, 0.9.10): a "done" said where it is seen (copied, goal set, server set), bottom
         centre of the left column, over the page so the window never changes size. The Undo bar's look, the same in every
         look of the window; it fades in, holds a moment and fades out. Never takes a click or the focus. -->
    <Border x:Name="Toast" VerticalAlignment="Bottom" HorizontalAlignment="Left" Width="662" Margin="0,0,0,14" IsHitTestVisible="False" Focusable="False" Visibility="Collapsed">
      <Border x:Name="ToastCard" HorizontalAlignment="Center" MaxWidth="560" CornerRadius="6" BorderThickness="1" BorderBrush="#2E3346" Padding="12,9,16,9">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#171920" Offset="0"/><GradientStop Color="#0E0F14" Offset="1"/></LinearGradientBrush>
        </Border.Background>
        <Border.Effect><DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.55"/></Border.Effect>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <!-- a check in a gold-framed slot, as on the Undo bar -->
          <Border Width="20" Height="20" CornerRadius="4" BorderThickness="1" BorderBrush="#8CFFD27A" Background="#0F1014" VerticalAlignment="Top" Margin="0,0,10,0">
            <Path Data="M5,12 L10,17 L19,7" Stroke="#FFD27A" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Margin="4.5"/>
          </Border>
          <TextBlock x:Name="ToastText" Grid.Column="1" Foreground="#EDEFF5" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" LineHeight="19"/>
        </Grid>
      </Border>
    </Border>

    </Grid>
  </Border>
</Window>
