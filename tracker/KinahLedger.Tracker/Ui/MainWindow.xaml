<Window x:Class="KinahLedger.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kinah Ledger" Width="560" SizeToContent="Height" ResizeMode="CanMinimize"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Ink}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        WindowStartupLocation="CenterScreen">

  <Window.Resources>
    <!-- five tiles in a 560 px window: labels and numbers a touch smaller than the house tile style -->
    <Style x:Key="TileLabel" TargetType="TextBlock" BasedOn="{StaticResource LabelStyle}">
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="TileNumber" TargetType="TextBlock" BasedOn="{StaticResource TileValue}">
      <Setter Property="FontSize" Value="23"/>
    </Style>

    <!-- drops and gathered rows: icon, name, count, rate, per hour -->
    <DataTemplate x:Key="RowTemplate">
      <Border x:Name="RowBorder" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Height="32">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="72"/><ColumnDefinition Width="92"/><ColumnDefinition Width="92"/>
          </Grid.ColumnDefinitions>
          <Grid x:Name="NameCell" Margin="8,0,6,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <!-- the item's icon once it is cached; its initial until then, or when none is known -->
            <Border x:Name="IconTile" Width="22" Height="22" CornerRadius="5" Background="{DynamicResource Card2}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1" Margin="0,0,8,0" VerticalAlignment="Center">
              <Grid>
                <TextBlock x:Name="IconInitial" Text="{Binding Initial}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                <Image Source="{Binding Icon.Image}" Stretch="Uniform" Margin="1" RenderOptions.BitmapScalingMode="HighQuality"/>
              </Grid>
            </Border>
            <TextBlock x:Name="NameText" Grid.Column="1" Text="{Binding Name}" Foreground="{DynamicResource Ink}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="13"/>
          </Grid>
          <TextBlock Grid.Column="1" Text="{Binding Drops}" Foreground="{DynamicResource Ink}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0" FontSize="13"/>
          <TextBlock Grid.Column="2" Text="{Binding DropPct}" Foreground="{DynamicResource Mint}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0" FontSize="13"/>
          <TextBlock Grid.Column="3" Text="{Binding PerHour}" Foreground="{DynamicResource Violet}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0" FontSize="13"/>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Icon.Image}" Value="{x:Null}"><Setter TargetName="IconInitial" Property="Visibility" Value="Visible"/></DataTrigger>
        <Trigger SourceName="RowBorder" Property="IsMouseOver" Value="True"><Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource RowHover}"/></Trigger>
        <!-- item grades in the game's own colours, in the dictionary's order: Common, Rare (green), Legend (blue), Unique (yellow), Epic (violet) -->
        <DataTrigger Binding="{Binding Grade}" Value="Rare"><Setter TargetName="NameText" Property="Foreground" Value="#5FE08A"/><Setter TargetName="IconTile" Property="BorderBrush" Value="#995FE08A"/></DataTrigger>
        <DataTrigger Binding="{Binding Grade}" Value="Legend"><Setter TargetName="NameText" Property="Foreground" Value="#5FA8FF"/><Setter TargetName="IconTile" Property="BorderBrush" Value="#995FA8FF"/></DataTrigger>
        <DataTrigger Binding="{Binding Grade}" Value="Unique"><Setter TargetName="NameText" Property="Foreground" Value="#F5D05A"/><Setter TargetName="IconTile" Property="BorderBrush" Value="#99F5D05A"/></DataTrigger>
        <DataTrigger Binding="{Binding Grade}" Value="Epic"><Setter TargetName="NameText" Property="Foreground" Value="#C88CFF"/><Setter TargetName="IconTile" Property="BorderBrush" Value="#99C88CFF"/></DataTrigger>
        <!-- a skill header row inside the gathered table: its own attempts, failures and Plentiful rate, across the whole row -->
        <DataTrigger Binding="{Binding Header}" Value="True">
          <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource RowHead}"/>
          <Setter TargetName="RowBorder" Property="Height" Value="28"/>
          <Setter TargetName="IconTile" Property="Visibility" Value="Collapsed"/>
          <Setter TargetName="NameCell" Property="Grid.ColumnSpan" Value="4"/>
          <Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource Gold}"/>
          <Setter TargetName="NameText" Property="FontWeight" Value="SemiBold"/>
          <Setter TargetName="NameText" Property="FontSize" Value="11.5"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

  </Window.Resources>

  <Border x:Name="Root" Background="{DynamicResource Bg}" Padding="18,14,18,12">
    <StackPanel>

      <!-- header -->
      <Grid>
        <StackPanel Orientation="Horizontal">
          <!-- the app mark: the same gold hex as the tray icon, drawn here so no image ships -->
          <Grid Width="24" Height="24" Margin="0,0,9,0" VerticalAlignment="Center">
            <Path Data="M13,1 L24,7.5 L24,19.5 L13,26 L2,19.5 L2,7.5 Z" Fill="{DynamicResource Mark}" Stroke="{DynamicResource Gold}" StrokeThickness="1.4" StrokeLineJoin="Round" Stretch="Uniform"/>
            <Path Data="M13,7 L18.5,10.2 L18.5,16.8 L13,20 L7.5,16.8 L7.5,10.2 Z" Fill="#E3B55B" Stretch="Uniform" Margin="5"/>
          </Grid>
          <TextBlock Text="KINAH LEDGER" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
          <TextBlock x:Name="Version" Text="v0.7.0" Foreground="{DynamicResource Faint}" VerticalAlignment="Center" Margin="10,2,0,0" FontSize="11.5"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <TextBlock FontSize="12.5" VerticalAlignment="Center" Margin="0,0,12,0"><Hyperlink x:Name="SiteLink" Style="{StaticResource LinkStyle}">Project page</Hyperlink></TextBlock>
          <!-- everything that needs setting lives behind this button; the main window is the live count -->
          <Button x:Name="SettingsBtn" Content="Settings" Height="30" Padding="12,0" FontSize="12.5"/>
        </StackPanel>
      </Grid>
      <TextBlock x:Name="Tagline" Style="{StaticResource BodyStyle}" FontSize="12.5" Margin="0,6,0,0"
                 Text="Unofficial Aion 2 farming tracker. Reads the loot lines from the chat on your screen while the game is open. Nothing touches the game."/>

      <!-- first run: region, faction, server and a look, before anything else. Everything shared is filed per server. -->
      <Border x:Name="WelcomeCard" Style="{StaticResource CardStyle}" Margin="0,14,0,0" Padding="22,20,22,20" Visibility="Collapsed">
        <StackPanel>
          <TextBlock Text="Welcome. Where do you play?" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="18" FontWeight="Bold"/>
          <TextBlock Style="{StaticResource BodyStyle}" Margin="0,6,0,0" Text="Everything the tracker shares is filed per server, so this comes first. Three taps and you are in; change any of it later under Settings."/>
          <TextBlock Style="{StaticResource LabelStyle}" Text="REGION" Margin="0,16,0,8"/>
          <WrapPanel x:Name="RegionChips"/>
          <TextBlock Style="{StaticResource LabelStyle}" Text="FACTION" Margin="0,8,0,8"/>
          <WrapPanel x:Name="FactionChips"/>
          <TextBlock Style="{StaticResource LabelStyle}" Text="SERVER" Margin="0,8,0,8"/>
          <WrapPanel x:Name="ServerChips"/>
          <TextBlock x:Name="WelcomeHint" Style="{StaticResource BodyStyle}" FontSize="12.5" Margin="0,2,0,0"/>
          <TextBlock Style="{StaticResource LabelStyle}" Text="LOOK" Margin="0,12,0,8"/>
          <WrapPanel x:Name="SkinChips"/>
          <Grid Margin="0,14,0,0">
            <TextBlock Style="{StaticResource BodyStyle}" FontSize="12" VerticalAlignment="Center" MaxWidth="300" HorizontalAlignment="Left" Text="Nothing is read or shared until you continue. The chat and the zone are found on their own."/>
            <Button x:Name="WelcomeGo" Style="{StaticResource PrimaryButton}" Content="Continue" Width="160" Height="44" HorizontalAlignment="Right" VerticalAlignment="Center"/>
          </Grid>
        </StackPanel>
      </Border>

      <!-- settings: server, sharing, chat and zone, Market, look. Hidden once set up; the Settings button brings it back. -->
      <Border x:Name="SetupCard" Style="{StaticResource CardStyle}" Margin="0,14,0,0" Padding="18,14,18,16">
        <StackPanel>
          <TextBlock Style="{StaticResource LabelStyle}" Text="SERVER"/>
          <WrapPanel x:Name="ServerRow" Margin="0,8,0,0">
            <TextBlock x:Name="ServerLabel" Text="Your server" Foreground="{DynamicResource Muted}" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,6" Visibility="Collapsed"/>
            <ComboBox x:Name="RegionBox" Width="138" FontSize="13" Margin="0,0,8,6" VerticalAlignment="Center" ToolTip="The region you play in. The same server names exist in every region, so both parts matter."/>
            <ComboBox x:Name="ServerPick" Width="190" FontSize="13" Margin="0,0,12,6" VerticalAlignment="Center" ToolTip="Your home server and faction, as the game's server list shows them."/>
            <TextBlock x:Name="ServerHint" Style="{StaticResource BodyStyle}" FontSize="12" LineHeight="16" VerticalAlignment="Center" Margin="0,0,0,6" MaxWidth="500"/>
          </WrapPanel>

          <TextBlock Style="{StaticResource LabelStyle}" Text="SHARING" Margin="0,12,0,0"/>
          <WrapPanel x:Name="OptsRow" Margin="0,8,0,0">
            <CheckBox x:Name="ShareChk" Content="Share runs and Market prices anonymously" Margin="0,0,6,4"/>
            <TextBlock Margin="0,0,16,4" VerticalAlignment="Center" FontSize="13"><Hyperlink x:Name="SentLink" Style="{StaticResource LinkStyle}">what's sent?</Hyperlink></TextBlock>
            <CheckBox x:Name="HudChk" Content="Panel over the game while farming" Margin="0,0,0,4"/>
          </WrapPanel>
          <!-- optional: ties this PC's runs to a profile on the site; runs stay anonymous without it -->
          <WrapPanel x:Name="LinkRow" Margin="0,8,0,0">
            <Button x:Name="LinkBtn" Content="Link to my profile on the site" Width="232" Margin="0,0,12,4"
                    ToolTip="Opens kinahledger.com with this PC's link code. Sign in with Discord if asked, and the runs this PC shares show on your profile. Runs stay anonymous in the public tables either way."/>
            <TextBlock VerticalAlignment="Center" Margin="0,0,0,4" FontSize="12.5" Foreground="{DynamicResource Muted}"
                       ToolTip="The same code, for pasting by hand into Profile › Link your tracker."><Run Text="code "/><Run x:Name="LinkCodeRun" FontFamily="Consolas" FontSize="13" Foreground="{DynamicResource Gold}"/><Run Text="   "/><Hyperlink x:Name="CopyCodeLink" Style="{StaticResource LinkStyle}">copy</Hyperlink></TextBlock>
          </WrapPanel>

          <TextBlock Style="{StaticResource LabelStyle}" Text="CHAT AND ZONE" Margin="0,14,0,0"/>
          <TextBlock x:Name="Step2Status" Style="{StaticResource BodyStyle}" FontSize="12.5" LineHeight="17" Margin="0,6,0,0"/>
          <WrapPanel Margin="0,10,0,0">
            <Button x:Name="DetectBtn" Content="Detect now" Width="104" Margin="0,0,8,6"/>
            <Button x:Name="PickBtn" Content="Choose the chat" Width="124" Margin="0,0,8,6"/>
            <Button x:Name="TestBtn" Content="Test read" Width="96" Margin="0,0,8,6"/>
            <TextBlock FontSize="12.5" VerticalAlignment="Center" Margin="4,0,0,6"><Hyperlink x:Name="ResetLink" Style="{StaticResource LinkStyle}">back to automatic</Hyperlink></TextBlock>
          </WrapPanel>
          <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Height="118" ClipToBounds="True" Margin="0,6,0,0">
            <Grid>
              <TextBlock x:Name="PreviewHint" Text="the game, with the chat, the map and the Market outlined" Foreground="{DynamicResource Faint}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="12,0"/>
              <Image x:Name="Preview" Stretch="Uniform" Margin="3" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Grid>
          </Border>
          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <Border Width="10" Height="10" CornerRadius="2" Background="{DynamicResource Accent}" VerticalAlignment="Center"/>
            <TextBlock Text="chat" Style="{StaticResource LabelStyle}" Margin="5,0,12,0"/>
            <Border Width="10" Height="10" CornerRadius="2" Background="{DynamicResource Gold}" VerticalAlignment="Center"/>
            <TextBlock Text="zone" Style="{StaticResource LabelStyle}" Margin="5,0,12,0"/>
            <Border Width="10" Height="10" CornerRadius="2" Background="{DynamicResource Mint}" VerticalAlignment="Center"/>
            <TextBlock Text="market" Style="{StaticResource LabelStyle}" Margin="5,0,0,0"/>
          </StackPanel>

          <TextBlock Style="{StaticResource LabelStyle}" Text="MARKET PRICES" Margin="0,14,0,0"/>
          <WrapPanel x:Name="MarketRow" Margin="0,6,0,0">
            <TextBlock Style="{StaticResource BodyStyle}" FontSize="12.5" LineHeight="17" Margin="0,0,6,4" VerticalAlignment="Center" MaxWidth="500" Text="Whenever you open the Market, the listings on your screen are shared as anonymous asks, under the Share switch above. Nothing to set up."/>
            <TextBlock Margin="0,0,0,4" VerticalAlignment="Center" FontSize="13"><Hyperlink x:Name="MarketSentLink" Style="{StaticResource LinkStyle}">what's read?</Hyperlink></TextBlock>
          </WrapPanel>
          <WrapPanel x:Name="MarketRow2" Margin="0,4,0,0">
            <Button x:Name="MarketPickBtn" Content="Choose the Market" Width="140" FontSize="12.5" Margin="0,0,10,4" VerticalAlignment="Center"/>
            <TextBlock x:Name="MarketResetText" Margin="0,0,0,4" VerticalAlignment="Center" FontSize="12.5" Visibility="Collapsed"><Hyperlink x:Name="MarketResetLink" Style="{StaticResource LinkStyle}">back to automatic</Hyperlink></TextBlock>
          </WrapPanel>
          <TextBlock x:Name="MarketStatus" Style="{StaticResource BodyStyle}" FontSize="12" LineHeight="16" Margin="0,4,0,0"
                     Text="Waiting for the game. While the game and this window are open, the Market is read whenever you open it."/>

          <TextBlock Style="{StaticResource LabelStyle}" Text="LOOK" Margin="0,14,0,8"/>
          <WrapPanel x:Name="SkinRow"/>
        </StackPanel>
      </Border>

      <!-- the run bar: everything is counted all the time; Start farming times a run on top and shows it -->
      <Border x:Name="SessionCard" Style="{StaticResource CardStyle}" Margin="0,12,0,0" Padding="14,12,14,12">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Button x:Name="StartBtn" Style="{StaticResource PrimaryButton}" Content="Start farming" Width="150" Height="44" VerticalAlignment="Center"/>
          <Grid x:Name="KindGrid" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
            <ComboBox x:Name="Kind" Width="130" VerticalAlignment="Center" ToolTip="What the run is labelled as when it is shared and saved. The count itself covers everything the chat shows."/>
          </Grid>
          <StackPanel Grid.Column="2" Margin="14,0,0,0" VerticalAlignment="Center">
            <TextBlock x:Name="ZoneLbl" Foreground="{DynamicResource Ink}" FontSize="13" FontWeight="SemiBold" Text="Zone: waiting for the game" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="FarmTime" Foreground="{DynamicResource Faint}" FontSize="12" Margin="0,2,0,0" Text="Ctrl+Shift+K starts and stops from inside the game" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="KindHint" Style="{StaticResource BodyStyle}" FontSize="12" LineHeight="16" Visibility="Collapsed"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- tiles -->
      <UniformGrid x:Name="Tiles" Columns="5" Margin="-4,10,-4,0">
        <Border Style="{StaticResource CardStyle}" Margin="4,0" Padding="8,9,8,10">
          <StackPanel><TextBlock x:Name="Tile1Label" Style="{StaticResource TileLabel}" Text="KINAH / HR"/><TextBlock x:Name="KinahHr" Style="{StaticResource TileNumber}" Foreground="{DynamicResource Gold}" Text="0"/></StackPanel>
        </Border>
        <Border Style="{StaticResource CardStyle}" Margin="4,0" Padding="8,9,8,10">
          <StackPanel><TextBlock x:Name="Tile2Label" Style="{StaticResource TileLabel}" Text="KINAH / KILL"/><TextBlock x:Name="KinahKill" Style="{StaticResource TileNumber}" Foreground="{DynamicResource Gold}" Text="—"/></StackPanel>
        </Border>
        <Border Style="{StaticResource CardStyle}" Margin="4,0" Padding="8,9,8,10">
          <StackPanel><TextBlock x:Name="Tile3Label" Style="{StaticResource TileLabel}" Text="KILLS / HR"/><TextBlock x:Name="KillsHr" Style="{StaticResource TileNumber}" Foreground="{DynamicResource Mint}" Text="0"/></StackPanel>
        </Border>
        <Border Style="{StaticResource CardStyle}" Margin="4,0" Padding="8,9,8,10">
          <StackPanel><TextBlock x:Name="Tile4Label" Style="{StaticResource TileLabel}" Text="DROPS / HR"/><TextBlock x:Name="DropsHr" Style="{StaticResource TileNumber}" Foreground="{DynamicResource Violet}" Text="0"/></StackPanel>
        </Border>
        <!-- Kinah per hour plus what the tradeable drops sell for at Market prices (gathering: the materials' value) -->
        <Border x:Name="ValueTile" Style="{StaticResource CardStyle}" Margin="4,0" Padding="8,9,8,10" ToolTipService.ShowDuration="20000">
          <StackPanel><TextBlock x:Name="Tile5Label" Style="{StaticResource TileLabel}" Text="TOTAL / HR"/><TextBlock x:Name="ValueHr" Style="{StaticResource TileNumber}" Foreground="{DynamicResource Gold}" Text="—"/></StackPanel>
        </Border>
      </UniformGrid>

      <!-- one table at a time: Drops or Gathered, picked by the tabs. The tables grow with what's farmed and the
           window with them; a table only scrolls once it would run past the bottom of the screen -->

      <Border x:Name="TablesCard" Style="{StaticResource CardStyle}" Margin="0,10,0,0" Padding="14,10,14,10">
        <StackPanel x:Name="TableStack">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="TableTitle" Style="{StaticResource LabelStyle}" Text="WHILE THE GAME IS OPEN" VerticalAlignment="Center"/>
            <!-- the summary trims from the right when the window is narrow, instead of running under the title -->
            <TextBlock x:Name="Summary" Grid.Column="1" Foreground="{DynamicResource Muted}" FontSize="11.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" Text="nothing read yet"/>
          </Grid>
          <!-- net Kinah from the balance counter, craft and enchant results, your own Market sales: shown once there is one -->
          <TextBlock x:Name="ExtraLine" Foreground="{DynamicResource Ink}" FontSize="11.5" HorizontalAlignment="Right" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
          <StackPanel Orientation="Horizontal" Margin="0,8,0,8">
            <Button x:Name="DropsTab" Content="Drops" Padding="12,5" FontSize="12.5" Margin="0,0,6,0"/>
            <Button x:Name="GatherTab" Content="Gathered" Padding="12,5" FontSize="12.5"/>
          </StackPanel>

          <StackPanel x:Name="DropsSection">
            <Border Background="{DynamicResource Card2}" CornerRadius="6" Height="28">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/><ColumnDefinition Width="72"/><ColumnDefinition Width="92"/><ColumnDefinition Width="92"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource LabelStyle}" Text="DROPS FROM KILLS" VerticalAlignment="Center" Margin="10,0,0,0"/>
                <TextBlock Grid.Column="1" Style="{StaticResource LabelStyle}" Text="DROPS" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                <TextBlock x:Name="PctHeader" Grid.Column="2" Style="{StaticResource LabelStyle}" Text="DROP %" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0" ToolTip="Drops divided by kills. Kills are counted from Kinah or Soul Point pickups (one per mob), or from kill lines when the chat shows them."/>
                <TextBlock Grid.Column="3" Style="{StaticResource LabelStyle}" Text="PER HOUR" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
              </Grid>
            </Border>
            <Grid MinHeight="64">
              <ScrollViewer x:Name="DropsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="Rows" ItemTemplate="{StaticResource RowTemplate}"/>
              </ScrollViewer>
              <TextBlock x:Name="TableEmpty" Style="{StaticResource BodyStyle}" FontSize="12.5" Foreground="{DynamicResource Faint}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" MaxWidth="420"
                         Text="Drops show here as they're read, with the drop rate per kill and per hour."/>
            </Grid>
          </StackPanel>

          <StackPanel x:Name="GatherSection">
            <Border Background="{DynamicResource Card2}" CornerRadius="6" Height="28">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/><ColumnDefinition Width="72"/><ColumnDefinition Width="92"/><ColumnDefinition Width="92"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource LabelStyle}" Text="GATHERED" VerticalAlignment="Center" Margin="10,0,0,0"/>
                <TextBlock Grid.Column="1" Style="{StaticResource LabelStyle}" Text="COUNT" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                <TextBlock Grid.Column="2" Style="{StaticResource LabelStyle}" Text="PER ATTEMPT" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0" ToolTip="Count divided by attempts. Every ore, log, Odyle, herb or food line counts as one attempt, failed gathers too; gemstones and higher tiers are the finds."/>
                <TextBlock Grid.Column="3" Style="{StaticResource LabelStyle}" Text="PER HOUR" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
              </Grid>
            </Border>
            <Grid MinHeight="64">
              <ScrollViewer x:Name="GatherScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="GatherRows" ItemTemplate="{StaticResource RowTemplate}"/>
              </ScrollViewer>
              <TextBlock x:Name="GatherEmpty" Style="{StaticResource BodyStyle}" FontSize="12.5" Foreground="{DynamicResource Faint}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" MaxWidth="420"
                         Text="Gathered materials show here, with how often each comes per attempt and per hour."/>
            </Grid>
          </StackPanel>

          <TextBlock x:Name="TableNote" Style="{StaticResource BodyStyle}" Foreground="{DynamicResource Faint}" FontSize="11.5" Margin="0,6,0,0" Visibility="Collapsed"/>
        </StackPanel>
      </Border>

      <!-- status -->
      <Grid x:Name="StatusRow" Margin="0,10,0,0">
        <TextBlock x:Name="Status" Foreground="{DynamicResource Faint}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,0,80,0"/>
        <TextBlock FontSize="12" HorizontalAlignment="Right"><Hyperlink x:Name="LogsLink" Style="{StaticResource LinkStyle}">Open logs</Hyperlink></TextBlock>
      </Grid>

    </StackPanel>
  </Border>
</Window>
