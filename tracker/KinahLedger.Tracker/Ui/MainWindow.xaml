<Window x:Class="KinahLedger.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kinah Ledger" SizeToContent="WidthAndHeight" ResizeMode="CanMinimize"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Ink}"
        FontFamily="{DynamicResource BodyFont}" FontSize="13.5"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        WindowStartupLocation="CenterScreen">

  <Window.Resources>
    <!-- table column labels and figures (the approved mocks): plain labels, figures in the data face -->
    <Style x:Key="FTh" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="{DynamicResource Faint}"/>
      <Setter Property="VerticalAlignment" Value="Bottom"/>
      <Setter Property="HorizontalAlignment" Value="Right"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
    <Style x:Key="FTd" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="FontFamily" Value="{DynamicResource MonoFont}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="HorizontalAlignment" Value="Right"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    </Style>
    <!-- a section you open (direction C): a chevron, the name in small gold capitals, a faint line, a figure on the right -->
    <Style x:Key="SecChev" TargetType="Path">
      <Setter Property="Data" Value="M0,0 L4,4 L0,8"/>
      <Setter Property="Stroke" Value="{DynamicResource Faint}"/>
      <Setter Property="StrokeThickness" Value="1.5"/>
      <Setter Property="Width" Value="8"/>
      <Setter Property="Height" Value="8"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
    </Style>
    <Style x:Key="SecTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="#E9B45A"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,0,10,0"/>
    </Style>
    <Style x:Key="SecNote" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Foreground" Value="{DynamicResource Faint}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="SecSum" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontFamily" Value="{DynamicResource MonoFont}"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="12,0,20,0"/>
    </Style>

    <!-- a drop row (direction C's aligned table with the tooltip look's icon tiles, 2026-10-24): the item's icon at 40 px in a
         slot framed and lit in its grade colour, the stack count on it; name, qty, odds, an hour, value. A missing price is a
         blank cell. A Header row is the sub-line above a group ("CRAFTING MATERIALS · 4"). -->
    <DataTemplate x:Key="FarmRowTemplate">
      <Border x:Name="RowBorder" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Height="52" Background="Transparent" Cursor="Hand" ToolTip="{Binding Tip}" ToolTipService.InitialShowDelay="250">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/><ColumnDefinition Width="76"/><ColumnDefinition Width="64"/><ColumnDefinition Width="84"/></Grid.ColumnDefinitions>
          <Grid x:Name="IconCell" Width="46" Height="46" HorizontalAlignment="Left" VerticalAlignment="Center">
            <Border x:Name="IconTile" Width="40" Height="40" CornerRadius="7" BorderThickness="1" BorderBrush="#47CDD3E2" HorizontalAlignment="Left" VerticalAlignment="Top">
              <Border.Background>
                <RadialGradientBrush Center="0.5,0.38" GradientOrigin="0.5,0.38" RadiusX="0.75" RadiusY="0.75"><GradientStop Color="#1ACDD3E2" Offset="0"/><GradientStop Color="{DynamicResource SlotColor}" Offset="1"/></RadialGradientBrush>
              </Border.Background>
              <Grid>
                <TextBlock x:Name="IconInitial" Text="{Binding Initial}" FontFamily="{DynamicResource DisplayFont}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                <Image Source="{Binding Icon.Image}" Stretch="Uniform" Margin="2" RenderOptions.BitmapScalingMode="HighQuality"/>
              </Grid>
            </Border>
            <!-- the stack count, as the game's inventory slot shows it -->
            <Border x:Name="Badge" HorizontalAlignment="Right" VerticalAlignment="Bottom" MinWidth="18" Height="16" CornerRadius="8" Padding="4,0" Background="{DynamicResource Slot}" BorderBrush="#4A5277" BorderThickness="1">
              <TextBlock Text="{Binding Drops}" FontFamily="{DynamicResource MonoFont}" FontSize="10.5" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </Grid>
          <Grid x:Name="NameCell" Grid.Column="1" Margin="0,0,10,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="NameText" Text="{Binding Name}" Foreground="{DynamicResource Ink}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            <!-- Looks wrong?: shown on hover, kept on a flagged row. A flagged drop is never sent to the site -->
            <TextBlock x:Name="ReportLink" Grid.Column="1" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Hidden"
                       ToolTip="Something looks wrong with this drop? Keep it out of what this run sends to the site.">
              <Hyperlink Style="{StaticResource LinkStyle}" Click="ReportClick"><Run Text="{Binding ReportText, Mode=OneWay}"/></Hyperlink>
            </TextBlock>
          </Grid>
          <TextBlock x:Name="QtyText" Grid.Column="2" Style="{StaticResource FTd}" Text="{Binding Drops}"/>
          <TextBlock x:Name="OddsText" Grid.Column="3" Style="{StaticResource FTd}" Text="{Binding DropPct}" Foreground="{DynamicResource Faint}"/>
          <TextBlock x:Name="HourText" Grid.Column="4" Style="{StaticResource FTd}" Text="{Binding PerHour}" Foreground="{DynamicResource Faint}"/>
          <!-- the value; where its price is from, its readings and age on hover (Ui/MainWindow.Prices.cs) -->
          <TextBlock x:Name="ValueText" Grid.Column="5" Style="{StaticResource FTd}" Text="{Binding Value}" Foreground="{DynamicResource Gold}" Background="Transparent" ToolTip="{Binding PriceTip}" ToolTipService.InitialShowDelay="250"/>
          <TextBlock x:Name="SubLine" Grid.ColumnSpan="6" Visibility="Collapsed" VerticalAlignment="Bottom" Margin="0,0,0,6" Text="{Binding Name}" Foreground="{DynamicResource Faint}" FontSize="11"/>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Icon.Image}" Value="{x:Null}"><Setter TargetName="IconInitial" Property="Visibility" Value="Visible"/></DataTrigger>
        <DataTrigger Binding="{Binding Tip}" Value=""><Setter TargetName="RowBorder" Property="ToolTip" Value="{x:Null}"/></DataTrigger>
        <DataTrigger Binding="{Binding PriceTip}" Value=""><Setter TargetName="ValueText" Property="ToolTip" Value="{x:Null}"/></DataTrigger>
        <DataTrigger Binding="{Binding PriceTone}" Value="Unsure"><Setter TargetName="ValueText" Property="Opacity" Value="0.5"/></DataTrigger>
        <!-- a drop no enemy you fought can drop, by their loot tables: the name says check -->
        <DataTrigger Binding="{Binding Tone}" Value="Warn"><Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource Warn}"/></DataTrigger>
        <Trigger SourceName="RowBorder" Property="IsMouseOver" Value="True"><Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource RowHover}"/><Setter TargetName="ReportLink" Property="Visibility" Value="Visible"/></Trigger>
        <DataTrigger Binding="{Binding Reported}" Value="True"><Setter TargetName="ReportLink" Property="Visibility" Value="Visible"/><Setter TargetName="NameText" Property="Opacity" Value="0.55"/></DataTrigger>
        <DataTrigger Binding="{Binding Report}" Value=""><Setter TargetName="ReportLink" Property="Visibility" Value="Collapsed"/><Setter TargetName="RowBorder" Property="Cursor" Value="Arrow"/></DataTrigger>
        <!-- item grades in the game's own colours, on the name and the tile's frame and glow -->
        <DataTrigger Binding="{Binding Grade}" Value="Rare">
          <Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource GradeRare}"/><Setter TargetName="IconTile" Property="BorderBrush" Value="#9962D98B"/>
          <Setter TargetName="IconTile" Property="Background"><Setter.Value><RadialGradientBrush Center="0.5,0.38" GradientOrigin="0.5,0.38" RadiusX="0.75" RadiusY="0.75"><GradientStop Color="#4262D98B" Offset="0"/><GradientStop Color="{DynamicResource SlotColor}" Offset="1"/></RadialGradientBrush></Setter.Value></Setter>
        </DataTrigger>
        <DataTrigger Binding="{Binding Grade}" Value="Legend">
          <Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource GradeLegend}"/><Setter TargetName="IconTile" Property="BorderBrush" Value="#995AA6FF"/>
          <Setter TargetName="IconTile" Property="Background"><Setter.Value><RadialGradientBrush Center="0.5,0.38" GradientOrigin="0.5,0.38" RadiusX="0.75" RadiusY="0.75"><GradientStop Color="#425AA6FF" Offset="0"/><GradientStop Color="{DynamicResource SlotColor}" Offset="1"/></RadialGradientBrush></Setter.Value></Setter>
        </DataTrigger>
        <DataTrigger Binding="{Binding Grade}" Value="Unique">
          <Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource GradeUnique}"/><Setter TargetName="IconTile" Property="BorderBrush" Value="#9EF3D35E"/>
          <Setter TargetName="IconTile" Property="Background"><Setter.Value><RadialGradientBrush Center="0.5,0.38" GradientOrigin="0.5,0.38" RadiusX="0.75" RadiusY="0.75"><GradientStop Color="#42F3D35E" Offset="0"/><GradientStop Color="{DynamicResource SlotColor}" Offset="1"/></RadialGradientBrush></Setter.Value></Setter>
        </DataTrigger>
        <DataTrigger Binding="{Binding Grade}" Value="Epic">
          <Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource GradeEpic}"/><Setter TargetName="IconTile" Property="BorderBrush" Value="#99B48BFF"/>
          <Setter TargetName="IconTile" Property="Background"><Setter.Value><RadialGradientBrush Center="0.5,0.38" GradientOrigin="0.5,0.38" RadiusX="0.75" RadiusY="0.75"><GradientStop Color="#42B48BFF" Offset="0"/><GradientStop Color="{DynamicResource SlotColor}" Offset="1"/></RadialGradientBrush></Setter.Value></Setter>
        </DataTrigger>
        <!-- the sub-line row: a small label, nothing else -->
        <DataTrigger Binding="{Binding Header}" Value="True">
          <Setter TargetName="RowBorder" Property="Height" Value="32"/>
          <Setter TargetName="RowBorder" Property="BorderThickness" Value="0"/>
          <Setter TargetName="RowBorder" Property="Cursor" Value="Arrow"/>
          <Setter TargetName="RowBorder" Property="Background" Value="Transparent"/>
          <Setter TargetName="IconCell" Property="Visibility" Value="Collapsed"/>
          <Setter TargetName="NameCell" Property="Visibility" Value="Collapsed"/>
          <Setter TargetName="SubLine" Property="Visibility" Value="Visible"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- a row of a small table opened in place (Gathered, a gathering skill, Soul Crystals, Kinah by enemy): a 28 px tile, the
         name, three figures. An enemy's loot rows (Child) sit indented under it, its listed chance beside the name. -->
    <DataTemplate x:Key="SmallRowTemplate">
      <Border x:Name="RowBorder" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Height="40" Background="Transparent" ToolTip="{Binding Tip}" ToolTipService.InitialShowDelay="250">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="72"/><ColumnDefinition Width="80"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
          <Border x:Name="IconTile" Width="28" Height="28" CornerRadius="5" BorderThickness="1" BorderBrush="#47CDD3E2" Background="{DynamicResource Slot}" HorizontalAlignment="Left" VerticalAlignment="Center">
            <Grid>
              <TextBlock x:Name="IconInitial" Text="{Binding Initial}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
              <Image Source="{Binding Icon.Image}" Stretch="Uniform" Margin="2" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Grid>
          </Border>
          <StackPanel x:Name="NameCell" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
            <TextBlock x:Name="NameText" Text="{Binding Name}" Foreground="{DynamicResource Ink}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="SubText" Text="{Binding Sub}" Foreground="{DynamicResource Faint}" FontSize="12" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <TextBlock Grid.Column="2" Style="{StaticResource FTd}" Text="{Binding Drops}"/>
          <TextBlock Grid.Column="3" Style="{StaticResource FTd}" Text="{Binding DropPct}" Foreground="{DynamicResource Faint}"/>
          <TextBlock x:Name="ValueText" Grid.Column="4" Style="{StaticResource FTd}" Text="{Binding Value}" Foreground="{DynamicResource Gold}"/>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Icon.Image}" Value="{x:Null}"><Setter TargetName="IconInitial" Property="Visibility" Value="Visible"/></DataTrigger>
        <DataTrigger Binding="{Binding Tip}" Value=""><Setter TargetName="RowBorder" Property="ToolTip" Value="{x:Null}"/></DataTrigger>
        <DataTrigger Binding="{Binding Key}" Value=""><Setter TargetName="RowBorder" Property="Cursor" Value="Arrow"/></DataTrigger>
        <DataTrigger Binding="{Binding Report}" Value=""><Setter TargetName="RowBorder" Property="Cursor" Value="Arrow"/></DataTrigger>
        <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Child}" Value="False"/><Condition Binding="{Binding Header}" Value="False"/></MultiDataTrigger.Conditions><Setter TargetName="RowBorder" Property="Cursor" Value="Hand"/></MultiDataTrigger>
        <Trigger SourceName="RowBorder" Property="IsMouseOver" Value="True"><Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource RowHover}"/></Trigger>
        <DataTrigger Binding="{Binding Tone}" Value="Warn"><Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource Warn}"/></DataTrigger>
        <DataTrigger Binding="{Binding Grade}" Value="Rare"><Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource GradeRare}"/><Setter TargetName="IconTile" Property="BorderBrush" Value="#9962D98B"/></DataTrigger>
        <DataTrigger Binding="{Binding Grade}" Value="Legend"><Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource GradeLegend}"/><Setter TargetName="IconTile" Property="BorderBrush" Value="#995AA6FF"/></DataTrigger>
        <DataTrigger Binding="{Binding Grade}" Value="Unique"><Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource GradeUnique}"/><Setter TargetName="IconTile" Property="BorderBrush" Value="#9EF3D35E"/></DataTrigger>
        <DataTrigger Binding="{Binding Grade}" Value="Epic"><Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource GradeEpic}"/><Setter TargetName="IconTile" Property="BorderBrush" Value="#99B48BFF"/></DataTrigger>
        <DataTrigger Binding="{Binding Child}" Value="True">
          <Setter TargetName="RowBorder" Property="Height" Value="34"/>
          <Setter TargetName="IconTile" Property="Margin" Value="12,0,0,0"/>
          <Setter TargetName="IconTile" Property="Width" Value="22"/><Setter TargetName="IconTile" Property="Height" Value="22"/>
          <Setter TargetName="NameText" Property="FontWeight" Value="Normal"/>
          <Setter TargetName="RowBorder" Property="BorderThickness" Value="0"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Header}" Value="True">
          <Setter TargetName="RowBorder" Property="Height" Value="30"/>
          <Setter TargetName="RowBorder" Property="BorderThickness" Value="0"/>
          <Setter TargetName="IconTile" Property="Visibility" Value="Collapsed"/>
          <Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource Faint}"/>
          <Setter TargetName="NameText" Property="FontSize" Value="11"/>
          <Setter TargetName="NameText" Property="FontWeight" Value="Normal"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- a recipe of this session (Crafting, direction C): icon, name, tries, worked, spent, sells for, profit. A failed-only
         recipe shows its loss in grey, not red; a row opens its recipe card -->
    <DataTemplate x:Key="CraftRowTemplate">
      <Border x:Name="RowBorder" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Height="44" Background="Transparent" Cursor="Hand" ToolTip="{Binding Tip}" ToolTipService.InitialShowDelay="250">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/><ColumnDefinition Width="58"/><ColumnDefinition Width="64"/><ColumnDefinition Width="72"/><ColumnDefinition Width="72"/></Grid.ColumnDefinitions>
          <Border x:Name="IconTile" Width="30" Height="30" CornerRadius="5" BorderThickness="1" BorderBrush="#47CDD3E2" Background="{DynamicResource Slot}" HorizontalAlignment="Left" VerticalAlignment="Center">
            <Grid>
              <TextBlock x:Name="IconInitial" Text="{Binding Initial}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
              <Image Source="{Binding Icon.Image}" Stretch="Uniform" Margin="2" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Grid>
          </Border>
          <TextBlock x:Name="NameText" Grid.Column="1" Text="{Binding Name}" Foreground="{DynamicResource Ink}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBlock Grid.Column="2" Style="{StaticResource FTd}" Text="{Binding Drops}" Foreground="{DynamicResource Faint}"/>
          <TextBlock Grid.Column="3" Style="{StaticResource FTd}" Text="{Binding DropPct}" Foreground="{DynamicResource Faint}"/>
          <TextBlock Grid.Column="4" Style="{StaticResource FTd}" Text="{Binding PerHour}" Foreground="{DynamicResource Faint}"/>
          <TextBlock x:Name="SellsText" Grid.Column="5" Style="{StaticResource FTd}" Text="{Binding Price}" ToolTip="{Binding PriceTip}"/>
          <TextBlock x:Name="ValueText" Grid.Column="6" Style="{StaticResource FTd}" Text="{Binding Value}" Foreground="{DynamicResource Gold}"/>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Icon.Image}" Value="{x:Null}"><Setter TargetName="IconInitial" Property="Visibility" Value="Visible"/></DataTrigger>
        <DataTrigger Binding="{Binding Tip}" Value=""><Setter TargetName="RowBorder" Property="ToolTip" Value="{x:Null}"/></DataTrigger>
        <DataTrigger Binding="{Binding PriceTip}" Value=""><Setter TargetName="SellsText" Property="ToolTip" Value="{x:Null}"/></DataTrigger>
        <DataTrigger Binding="{Binding PriceTone}" Value="Unsure"><Setter TargetName="SellsText" Property="Opacity" Value="0.5"/></DataTrigger>
        <DataTrigger Binding="{Binding Tone}" Value="Bad"><Setter TargetName="ValueText" Property="Foreground" Value="{DynamicResource Faint}"/></DataTrigger>
        <Trigger SourceName="RowBorder" Property="IsMouseOver" Value="True"><Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource RowHover}"/></Trigger>
        <DataTrigger Binding="{Binding Grade}" Value="Rare"><Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource GradeRare}"/><Setter TargetName="IconTile" Property="BorderBrush" Value="#9962D98B"/></DataTrigger>
        <DataTrigger Binding="{Binding Grade}" Value="Legend"><Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource GradeLegend}"/><Setter TargetName="IconTile" Property="BorderBrush" Value="#995AA6FF"/></DataTrigger>
        <DataTrigger Binding="{Binding Grade}" Value="Unique"><Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource GradeUnique}"/><Setter TargetName="IconTile" Property="BorderBrush" Value="#9EF3D35E"/></DataTrigger>
        <DataTrigger Binding="{Binding Grade}" Value="Epic"><Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource GradeEpic}"/><Setter TargetName="IconTile" Property="BorderBrush" Value="#99B48BFF"/></DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

  </Window.Resources>

  <Border x:Name="Root" Background="{DynamicResource Bg}" Padding="22,16,22,14">
    <Grid>
    <!-- the ledger: always the same width, wherever the settings are -->
    <!-- never taller than the screen (Steven, 0.7.6): the header, the run card and the summary stay put; the pickups and
         the tables scroll below them once the window would run past the screen (Window.MaxHeight is the work area) -->
    <!-- 0.7.6 (Steven): Compact (the default) is the run card and the summary; Full view doubles the width and puts every
         table in a second column beside them. Never taller than the screen: the tables' column scrolls past it. -->
    <Grid x:Name="LedgerCol" VerticalAlignment="Top">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition x:Name="LeftColDef" Width="662"/><ColumnDefinition x:Name="RightColDef" Width="0"/></Grid.ColumnDefinitions>
    <!-- across both columns; its width is set with the view (ApplyView) so long text never widens the window -->
    <StackPanel x:Name="HeadStack" Grid.ColumnSpan="2" Width="662" HorizontalAlignment="Left">

      <!-- header: the gold mark and the name, the Farming / Crafting switch, the project page and Settings -->
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <!-- the app mark, the K tile (tools/brand/logo.svg) -->
          <Image Source="{StaticResource AppMark}" Width="32" Height="32" Margin="0,0,10,0" VerticalAlignment="Center"/>
          <StackPanel VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Kinah Ledger" FontFamily="{DynamicResource DisplayFont}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
              <TextBlock x:Name="Version" Text="v0.7.6" Foreground="{DynamicResource Faint}" VerticalAlignment="Center" Margin="10,2,0,0" FontSize="11.5"/>
            </StackPanel>
            <TextBlock x:Name="ServerChip" Foreground="{DynamicResource Muted}" FontSize="11.5" Margin="0,1,0,0" Cursor="Hand" ToolTip="Your server. Change it in Options." Text="No server chosen"/>
          </StackPanel>
        </StackPanel>
        <!-- two parts that never mix: Farming (the run, the stats, the loot) and Crafting (recipes, cost, success, profit) -->
        <Border x:Name="PartTabs" Grid.Column="1" HorizontalAlignment="Right" Margin="0,0,10,0" Padding="3" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource LineStrong}" Background="#08FFFFFF" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <Button x:Name="FarmTab" Style="{StaticResource SegOn}" Content="Farming" Padding="10,0"/>
            <Button x:Name="CraftTab" Style="{StaticResource SegOff}" Content="Crafting" Margin="2,0,0,0" Padding="10,0"/>
            <Button x:Name="EventsTab" Style="{StaticResource SegOff}" Content="Events" Margin="2,0,0,0" Padding="10,0" ToolTip="Expeditions and events: each trip, from entering to the last loot. Never on the Farming page."/>
          </StackPanel>
        </Border>
        <!-- the site and Options: everything that can be set is in the Options window, so the ledger never moves -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <!-- the site as a globe, so the three parts always fit beside the name (Steven, 2026-10-22: the tabs ran into the name) -->
          <Button x:Name="SiteBtn" Width="36" Height="32" Padding="0" Margin="0,0,8,0" ToolTip="kinahledger.com: community drop rates, prices and your profile">
            <Grid Width="16" Height="16">
              <Ellipse Width="16" Height="16" Stroke="{DynamicResource Muted}" StrokeThickness="1.4"/>
              <Ellipse Width="7" Height="16" Stroke="{DynamicResource Muted}" StrokeThickness="1.2"/>
              <Rectangle Height="1.2" Width="15" Fill="{DynamicResource Muted}" VerticalAlignment="Center"/>
              <Rectangle Height="1.1" Width="12" Fill="{DynamicResource Muted}" VerticalAlignment="Top" Margin="0,4,0,0"/>
              <Rectangle Height="1.1" Width="12" Fill="{DynamicResource Muted}" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
            </Grid>
          </Button>
          <!-- Compact / Full view: two panels drawn, the right one filled in Full view -->
          <Button x:Name="ViewBtn" Width="36" Height="32" Padding="0" Margin="0,0,8,0" ToolTip="Full view: every table beside the summary">
            <Grid Width="16" Height="12">
              <Rectangle Width="16" Height="12" RadiusX="2" RadiusY="2" Stroke="{DynamicResource Muted}" StrokeThickness="1.4"/>
              <Rectangle Width="1.4" Height="12" Fill="{DynamicResource Muted}" HorizontalAlignment="Left" Margin="7,0,0,0"/>
              <Rectangle x:Name="ViewFill" Width="6" Height="9" Fill="{DynamicResource Muted}" HorizontalAlignment="Right" Margin="0,0,1.5,0" Opacity="0.25"/>
            </Grid>
          </Button>
          <Button x:Name="OptionsBtn" Height="32" Padding="12,0" FontSize="12.5" ToolTip="Server, startup, sharing, game reading, hotkey, updates.">
            <StackPanel Orientation="Horizontal">
              <!-- a gear, drawn so no image ships -->
              <Path Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,7,0"
                    Data="M10.3,1 L13.7,1 L14.2,3.6 C15,3.9 15.7,4.3 16.4,4.8 L18.9,3.9 L20.6,6.8 L18.6,8.6 C18.7,9.4 18.7,10.2 18.6,11 L20.6,12.8 L18.9,15.7 L16.4,14.8 C15.7,15.3 15,15.7 14.2,16 L13.7,18.6 L10.3,18.6 L9.8,16 C9,15.7 8.3,15.3 7.6,14.8 L5.1,15.7 L3.4,12.8 L5.4,11 C5.3,10.2 5.3,9.4 5.4,8.6 L3.4,6.8 L5.1,3.9 L7.6,4.8 C8.3,4.3 9,3.9 9.8,3.6 Z M12,6.6 A3.2,3.2 0 1 0 12,13 A3.2,3.2 0 1 0 12,6.6 Z"/>
              <TextBlock Text="Options" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
      <!-- a newer version: downloaded on its own, installed when the window closes or on Restart now -->
      <Border x:Name="UpdateCard" Style="{StaticResource CardStyle}" Margin="0,12,0,0" Padding="14,10,14,10" Visibility="Collapsed">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="UpdateText" Style="{StaticResource BodyStyle}" FontSize="12.5" LineHeight="17" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="UpdateNotesText" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,12,0"><Hyperlink x:Name="UpdateNotesLink" Style="{StaticResource LinkStyle}">What's new</Hyperlink></TextBlock>
            <Button x:Name="UpdateBtn" Style="{StaticResource PrimaryButton}" Content="Restart now" Height="34" Padding="16,0" FontSize="13"/>
          </StackPanel>
        </Grid>
      </Border>
      <TextBlock x:Name="Tagline" Style="{StaticResource BodyStyle}" FontSize="12.5" Margin="0,6,0,0"
                 Text="Unofficial Aion 2 farming tracker. Reads the loot lines from the chat on your screen while the game is open. Nothing touches the game."/>

      <!-- first run: region, faction, server and a look, before anything else. Everything shared is filed per server. -->
      <Border x:Name="WelcomeCard" Style="{StaticResource CardStyle}" Margin="0,14,0,0" Padding="22,20,22,20" Visibility="Collapsed">
        <StackPanel>
          <TextBlock Text="Welcome. Where do you play?" FontFamily="{DynamicResource DisplayFont}" FontSize="18" FontWeight="Bold"/>
          <TextBlock Style="{StaticResource BodyStyle}" Margin="0,6,0,0" Text="Everything the tracker shares is filed per server, so this comes first. Three taps and you are in; change any of it later in Options."/>
          <TextBlock Style="{StaticResource LabelStyle}" Text="REGION" Margin="0,16,0,8"/>
          <WrapPanel x:Name="RegionChips"/>
          <TextBlock Style="{StaticResource LabelStyle}" Text="FACTION" Margin="0,8,0,8"/>
          <WrapPanel x:Name="FactionChips"/>
          <TextBlock Style="{StaticResource LabelStyle}" Text="SERVER" Margin="0,8,0,8"/>
          <WrapPanel x:Name="ServerChips"/>
          <TextBlock x:Name="WelcomeHint" Style="{StaticResource BodyStyle}" FontSize="12.5" Margin="0,2,0,0"/>
          <!-- gear score (0.8.12): the run card compares the player with players at the same gear; empty is every player -->
          <TextBlock Style="{StaticResource LabelStyle}" Text="GEAR SCORE" Margin="0,12,0,8"/>
          <StackPanel Orientation="Horizontal">
            <TextBox x:Name="WelcomeGear" Width="120" MaxLength="5" VerticalAlignment="Center" AutomationProperties.Name="Gear score"/>
            <TextBlock Style="{StaticResource BodyStyle}" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center" Text="Optional. Compares your runs with players at your gear. Change it in Options."/>
          </StackPanel>
          <TextBlock Style="{StaticResource LabelStyle}" Text="LOOK" Margin="0,12,0,8"/>
          <WrapPanel x:Name="SkinChips"/>
          <!-- sharing, chosen here before anything is read or sent (the same switch as Options › Sharing) -->
          <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,16,0">
              <TextBlock Text="Share my runs and Market prices, anonymously" FontSize="13.5" FontWeight="SemiBold"/>
              <TextBlock Style="{StaticResource BodyStyle}" FontSize="12" Margin="0,2,0,0" Text="Totals only, for the site's public tables. Never your character, chat text or screenshots. Change it any time in Options."/>
              <TextBlock FontSize="12.5" Margin="0,4,0,0"><Hyperlink x:Name="WelcomeSentLink" Style="{StaticResource LinkStyle}">What's shared</Hyperlink><Run Text="   "/><Hyperlink x:Name="WelcomePrivacyLink" Style="{StaticResource LinkStyle}">Privacy</Hyperlink></TextBlock>
            </StackPanel>
            <CheckBox x:Name="WelcomeShareChk" Grid.Column="1" Style="{StaticResource Switch}" IsChecked="True" VerticalAlignment="Center" AutomationProperties.Name="Share my runs and Market prices, anonymously"/>
          </Grid>
          <Grid Margin="0,14,0,0">
            <TextBlock Style="{StaticResource BodyStyle}" FontSize="12" VerticalAlignment="Center" MaxWidth="300" HorizontalAlignment="Left" Text="Nothing is read or sent until you continue. The chat and the zone are found on their own."/>
            <Button x:Name="WelcomeGo" Style="{StaticResource PrimaryButton}" Content="Continue" Width="160" Height="44" HorizontalAlignment="Right" VerticalAlignment="Center"/>
          </Grid>
        </StackPanel>
      </Border>


    </StackPanel>

    <!-- the left column: the live card (the feed, the rate, the actions) and the Session section; in Full view also Where to
         farm now and the footer (moved here by ApplyView) -->
    <StackPanel x:Name="LeftCol" Grid.Row="1" Width="662" VerticalAlignment="Top">
      <!-- the farming card (Steven, 2026-10-24, direction C "Live"): the zone and whether it is live; the last five things
           counted beside the rate and its line since the start; the actions. Sections fold under it (Session, Drops from
           kills, Also this session, Where to farm now) and join it as one card (JoinCards). -->
      <Border x:Name="SessionCard" Margin="0,16,0,0" BorderThickness="1" CornerRadius="6,6,0,0" BorderBrush="{DynamicResource LineStrong}" Background="{DynamicResource Card}">
        <StackPanel>
          <Grid Margin="20,16,20,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <!-- the zone's tile: a map pin in a gold-framed slot -->
            <Border Width="40" Height="40" CornerRadius="7" BorderThickness="1" BorderBrush="{DynamicResource Gold}" VerticalAlignment="Center">
              <Border.Background>
                <RadialGradientBrush Center="0.5,0.38" GradientOrigin="0.5,0.38" RadiusX="0.75" RadiusY="0.75"><GradientStop Color="#4DF8D598" Offset="0"/><GradientStop Color="{DynamicResource SlotColor}" Offset="1"/></RadialGradientBrush>
              </Border.Background>
              <Viewbox Width="22" Height="22">
                <Canvas Width="24" Height="24">
                  <Path Stroke="{DynamicResource Muted}" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                        Data="M12,21 C12,21 19,14.8 19,9.5 A7,7 0 0 0 5,9.5 C5,14.8 12,21 12,21 Z M12,7.1 A2.4,2.4 0 1 0 12,11.9 A2.4,2.4 0 1 0 12,7.1 Z"/>
                </Canvas>
              </Viewbox>
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
              <TextBlock x:Name="ZoneLbl" FontFamily="{DynamicResource DisplayFont}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Gold}" Text="Waiting for the game" TextTrimming="CharacterEllipsis"/>
              <!-- what and how long ("Open world · farming 42:17") -->
              <TextBlock x:Name="TableTitle" Foreground="{DynamicResource Muted}" FontSize="12.5" Margin="0,2,0,0" Text="Not reading yet" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <!-- live: the game is being read now -->
            <StackPanel x:Name="LiveMark" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Visibility="Collapsed" ToolTip="The game is being read now.">
              <Ellipse x:Name="RecDot" Width="6" Height="6" Fill="{DynamicResource Gold}" Margin="0,1,6,0" VerticalAlignment="Center">
                <Ellipse.Effect><DropShadowEffect Color="#F8D598" BlurRadius="8" ShadowDepth="0" Opacity="0.7"/></Ellipse.Effect>
              </Ellipse>
              <TextBlock Text="live" Foreground="{DynamicResource Gold}" FontSize="11.5" VerticalAlignment="Center"/>
            </StackPanel>
          </Grid>

          <!-- the live strip: the last five things counted on this tab, and the rate beside it (Ui/MainWindow.Live.cs) -->
          <Grid Margin="20,16,20,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
            <StackPanel>
              <Border x:Name="FeedBox" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource Line}" Background="{DynamicResource Slot}" Padding="0,4" ClipToBounds="True">
                <Grid>
                  <StackPanel x:Name="FeedHost"/>
                  <TextBlock x:Name="FeedEmpty" Style="{StaticResource BodyStyle}" FontSize="12.5" Foreground="{DynamicResource Faint}" Margin="12,10,12,10" TextWrapping="Wrap"
                             Text="Each pickup shows here as it is counted, newest first."/>
                </Grid>
              </Border>
              <TextBlock x:Name="FeedHint" FontSize="11.5" Foreground="{DynamicResource Faint}" Margin="0,8,0,0" Background="Transparent" Cursor="Hand" HorizontalAlignment="Left"
                         Text="A line wrong or missing? Tap it." ToolTip="Tap a wrong line to report it, or here for a pickup that never showed. The report is saved on this PC."/>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock x:Name="HeadRate" FontFamily="{DynamicResource DisplayFont}" FontSize="34" FontWeight="Light" Foreground="{DynamicResource Ink}" Text=" "/>
              <TextBlock x:Name="HeadRateLbl" FontSize="12.5" Foreground="{DynamicResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap" Text="Kinah and loot an hour, once something is counted"/>
              <!-- the rate since the start, one sample a minute -->
              <Canvas x:Name="RateCanvas" Width="200" Height="40" Margin="0,12,0,4" HorizontalAlignment="Left" ClipToBounds="True">
                <Path x:Name="RateFill" StrokeThickness="0">
                  <Path.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#42F8D598" Offset="0"/><GradientStop Color="#00F8D598" Offset="1"/></LinearGradientBrush></Path.Fill>
                </Path>
                <Polyline x:Name="RateLinePath" Stroke="{DynamicResource Gold}" StrokeThickness="1.5" StrokeLineJoin="Round"/>
              </Canvas>
              <Grid x:Name="RateAxis">
                <TextBlock x:Name="RateFrom" FontSize="11" Foreground="{DynamicResource Faint}" HorizontalAlignment="Left"/>
                <TextBlock x:Name="RateTo" FontSize="11" Foreground="{DynamicResource Faint}" HorizontalAlignment="Right" Text="now"/>
              </Grid>
              <!-- "161 kills · 3.9K a kill" and "best here 1.40M" -->
              <TextBlock x:Name="KvLine" FontSize="12.5" Foreground="{DynamicResource Muted}" Margin="0,12,0,0" LineHeight="21" TextWrapping="Wrap"/>
              <!-- the one place the read count shows: "Reading the chat · 3,620 reads" -->
              <StackPanel x:Name="HealthLine" Orientation="Horizontal" Margin="0,12,0,0">
                <Path x:Name="HealthMark" Width="13" Height="13" Stretch="Uniform" Stroke="{DynamicResource Gold}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M3.5,8.5 L6.5,11.5 L12.5,4.5" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="HealthText" FontSize="12" Foreground="{DynamicResource Faint}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="180"/>
              </StackPanel>
            </StackPanel>
          </Grid>

          <Grid Margin="20,16,20,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button x:Name="StartBtn" Style="{StaticResource PrimaryButton}" Content="Start run" MinWidth="112" Height="34" Padding="24,0" FontSize="13" VerticalAlignment="Center"
                    ToolTip="Everything is counted while the game is open. A run times one stretch on top; it is what gets saved and shared."/>
            <Button x:Name="ShareCardBtn" Grid.Column="1" Margin="8,0,0,0" IsEnabled="False" Height="34" Padding="16,0" FontSize="13" Content="Copy for Discord"
                    ToolTip="Copies a picture of this count (zone, per hour, top drops) to paste into Discord with Ctrl+V. A copy is saved too."/>
            <!-- the rest, out of the way: All zones, clearing the tables, the shortcut -->
            <Button x:Name="MoreBtn" Grid.Column="3" Width="34" Height="34" Padding="0" ToolTip="More" AutomationProperties.Name="More">
              <TextBlock Text="⋯" FontSize="17" Foreground="{DynamicResource Muted}" Margin="0,-3,0,0"/>
            </Button>
          </Grid>

          <!-- figures the code still works out for the Discord card and the panel over the game; not drawn since the feed (0.8.30) -->
          <StackPanel Visibility="Collapsed">
            <TextBlock x:Name="HeadRateUnit" Text="an hour"/>
            <StackPanel x:Name="CompareLine" Orientation="Horizontal">
              <TextBlock x:Name="BestLine"/><TextBlock x:Name="CompareSep" Text="·"/><TextBlock x:Name="FarmLine"/>
            </StackPanel>
            <UniformGrid x:Name="Tiles" Columns="3" Rows="1">
              <Border x:Name="Tile1"><StackPanel><TextBlock x:Name="KinahHr" Text="0"/><TextBlock x:Name="Tile1Label" Text="Kinah an hour"/></StackPanel></Border>
              <Border x:Name="Tile2"><StackPanel><TextBlock x:Name="KinahKill" Text=" "/><TextBlock x:Name="Tile2Label" Text="Kinah a kill"/></StackPanel></Border>
              <Border x:Name="Tile3"><StackPanel><TextBlock x:Name="KillsHr" Text="0"/><TextBlock x:Name="Tile3Label" Text="kills an hour"/></StackPanel></Border>
              <Border x:Name="Tile4"><StackPanel><TextBlock x:Name="DropsHr" Text="0"/><TextBlock x:Name="Tile4Label" Text="drops a kill"/></StackPanel></Border>
              <StackPanel x:Name="ValueTile"><TextBlock x:Name="ValueHr" Text=" "/><TextBlock x:Name="Tile5Label" Text="total/hr"/></StackPanel>
            </UniformGrid>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Session, folded to one line: what was counted and the total; opened, Kinah, loot, best here, players at your gear -->
      <Border x:Name="SummaryCard" Background="{DynamicResource Card}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1,0,1,0" Visibility="Collapsed">
        <StackPanel>
          <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
            <Grid x:Name="SessionHead" Height="48" Background="Transparent" Cursor="Hand">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Path x:Name="SessionChev" Style="{StaticResource SecChev}" Margin="20,0,10,0"/>
              <TextBlock Grid.Column="1" Style="{StaticResource SecTitle}" Text="SESSION"/>
              <TextBlock x:Name="FootTotalNote" Grid.Column="2" Style="{StaticResource SecNote}"/>
              <TextBlock x:Name="FootTotal" Grid.Column="3" Style="{StaticResource SecSum}" Foreground="{DynamicResource Gold}" FontSize="14" Text=" "/>
            </Grid>
          </Border>
          <StackPanel x:Name="SessionBody" Margin="20,0,20,16" Visibility="Collapsed">
            <StackPanel x:Name="SessionRows"/>
            <!-- how the total adds up, the whole sum on hover -->
            <TextBlock x:Name="SumBreakdown" Foreground="{DynamicResource Faint}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" Background="Transparent" ToolTipService.InitialShowDelay="250"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Where to farm now, folded to its best zone; opened, the best zones for the player's gear. Under the tables in Compact, under Session in Full view (ApplyView moves it) -->
      <Border x:Name="WhereSection" Background="{DynamicResource Card}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1,0,1,0" Visibility="Collapsed">
        <StackPanel>
          <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
            <Grid x:Name="WhereHead" Height="48" Background="Transparent" Cursor="Hand">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Path x:Name="WhereChev" Style="{StaticResource SecChev}" Margin="20,0,10,0"/>
              <TextBlock Grid.Column="1" Style="{StaticResource SecTitle}" Text="WHERE TO FARM NOW"/>
              <TextBlock x:Name="WhereNote" Grid.Column="2" Style="{StaticResource SecNote}"/>
              <TextBlock x:Name="WhereSum" Grid.Column="3" Style="{StaticResource SecSum}"/>
            </Grid>
          </Border>
          <StackPanel x:Name="WhereBody" Margin="20,0,20,16" Visibility="Collapsed"/>
        </StackPanel>
      </Border>
    </StackPanel>

      <!-- status: on the Farming part in Compact, the farming card's footer (JoinCards); a plain line under the rest -->
      <Border x:Name="StatusBar" Grid.Row="3" Grid.ColumnSpan="2" Width="662" HorizontalAlignment="Left" Margin="0,14,0,0">
      <Border x:Name="StatusInner" BorderBrush="{DynamicResource Line}">
      <Grid x:Name="StatusRow">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="Status" Foreground="{DynamicResource Faint}" FontSize="12" TextTrimming="CharacterEllipsis" Background="Transparent" ToolTipService.InitialShowDelay="250" VerticalAlignment="Center"/>
        <!-- shown with a reading problem: straight to the page that fixes it -->
        <TextBlock x:Name="FixText" Grid.Column="1" FontSize="12" Margin="12,0,0,0" Visibility="Collapsed" VerticalAlignment="Center"><Hyperlink x:Name="FixLink" Style="{StaticResource LinkStyle}">Game reading options</Hyperlink></TextBlock>
        <!-- the last minute of what was read and counted, saved on this PC for a bug report (2026-10-23) -->
        <TextBlock x:Name="MiscountText" Grid.Column="2" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center"
                   ToolTip="Saves what the tracker read and counted in the last minute to a folder on this PC, for a bug report. Nothing is sent."><Hyperlink x:Name="MiscountLink" Style="{StaticResource LinkStyle}">Report a miscount</Hyperlink></TextBlock>
      </Grid>
      </Border>
      </Border>

    <!-- the right column (Full view, or Crafting and Events): the tables, scrolling once they'd run past the screen; the bar
         sits in the window's right padding, so the cards keep their width -->
    <ScrollViewer x:Name="LowerScroll" Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="16,0,-20,0" Focusable="False" Visibility="Collapsed">
      <StackPanel Width="662" HorizontalAlignment="Left">

      <Border x:Name="TablesCard" Background="{DynamicResource Card}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1,0,1,0">
        <StackPanel x:Name="TableStack">
          <!-- idle time and skipped reward lines; each shown only once there is something to say -->
          <TextBlock x:Name="Summary" Foreground="{DynamicResource Faint}" FontSize="12" Margin="20,12,20,0" TextWrapping="Wrap" Visibility="Collapsed"/>
          <!-- how the count holds up against what the game itself counts (Steven, 2026-10-22: an accuracy meter) -->
          <TextBlock x:Name="AccuracyLine" Foreground="{DynamicResource Faint}" FontSize="12" Margin="20,8,20,0" TextWrapping="Wrap" Visibility="Collapsed"
                     ToolTip="Checks against the game's own numbers. Kinah counter: how often the Kinah counter at the top-left rose by exactly what was counted. Quest kills: in the minutes a quest's kill counter moved, its count beside the tracker's. Loot list: pickups the chat read missed and the list beside your character caught."/>
          <!-- with nothing counted yet, one line instead of empty sections; each section appears with its first row -->
          <TextBlock x:Name="TablesEmpty" Style="{StaticResource BodyStyle}" FontSize="12.5" Foreground="{DynamicResource Faint}" Margin="20,16,20,14" TextWrapping="Wrap"
                     Text="Loot shows here as it comes in: drops from kills, gathering, Kinah by enemy and Soul Crystals."/>
          <!-- loot from other zones for the sections empty here, in one line; All zones counts them together -->
          <TextBlock x:Name="OtherZones" Foreground="{DynamicResource Muted}" FontSize="12.5" Margin="20,14,20,4" TextWrapping="Wrap" Visibility="Collapsed" Background="Transparent"
                     ToolTip="The tables show this zone only, and start over when you change zone. Turn on All zones (the … button) to count every zone together."/>

          <!-- Drops from kills: open by default; one aligned table, the crafting materials under their own sub-line -->
          <Border x:Name="DropsSection" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
            <StackPanel>
              <Grid x:Name="DropsHead" Height="48" Background="Transparent" Cursor="Hand">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Path x:Name="DropsChev" Style="{StaticResource SecChev}" Margin="20,0,10,0"/>
                <TextBlock x:Name="DropsTitle" Grid.Column="1" Style="{StaticResource SecTitle}" Text="DROPS FROM KILLS"/>
                <TextBlock x:Name="DropsNote" Grid.Column="2" Style="{StaticResource SecNote}"/>
              </Grid>
              <StackPanel x:Name="DropsOpenBody" Margin="20,0,20,16">
                <Grid Height="24">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/><ColumnDefinition Width="76"/><ColumnDefinition Width="64"/><ColumnDefinition Width="84"/></Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="2" Style="{StaticResource FTh}" Text="Qty"/>
                  <TextBlock x:Name="PctHeader" Grid.Column="3" Style="{StaticResource FTh}" Text="Odds" Background="Transparent" Cursor="Hand"/>
                  <TextBlock Grid.Column="4" Style="{StaticResource FTh}" Text="An hour"/>
                  <TextBlock Grid.Column="5" Style="{StaticResource FTh}" Text="Value" ToolTip="Quantity times the lowest Market price on your server, before the Market's fee and tax. Bound copies can't be sold and have no value here."/>
                </Grid>
                <Grid MinHeight="40">
                  <ScrollViewer x:Name="DropsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                      <ItemsControl x:Name="Rows" ItemTemplate="{StaticResource FarmRowTemplate}"/>
                      <Grid x:Name="MatHead" Height="34" Visibility="Collapsed">
                        <TextBlock x:Name="MatTitle" Text="CRAFTING MATERIALS" Foreground="{DynamicResource Faint}" FontSize="11" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                      </Grid>
                      <ItemsControl x:Name="MatRows" ItemTemplate="{StaticResource FarmRowTemplate}"/>
                    </StackPanel>
                  </ScrollViewer>
                  <TextBlock x:Name="TableEmpty" Style="{StaticResource BodyStyle}" FontSize="12.5" Foreground="{DynamicResource Faint}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" MaxWidth="420"
                             Text="Drops show here as they're read, with the odds and how many come an hour."/>
                </Grid>
                <!-- the top rows only, until "show all" is pressed -->
                <TextBlock x:Name="DropsMore" FontSize="12" Margin="0,8,0,0" Visibility="Collapsed"><Hyperlink x:Name="DropsMoreLink" Style="{StaticResource LinkStyle}"><Run x:Name="DropsMoreRun" Text="Show all"/></Hyperlink></TextBlock>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Also this session: one chip each for Gathered, a gathering skill, Soul Crystals and Kinah by enemy; a chip opens its own small table in place -->
          <Border x:Name="ExtrasSection" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Visibility="Collapsed">
            <StackPanel>
              <Grid x:Name="ExtrasHead" Height="48" Background="Transparent" Cursor="Hand">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Path x:Name="ExtrasChev" Style="{StaticResource SecChev}" Margin="20,0,10,0"/>
                <TextBlock Grid.Column="1" Style="{StaticResource SecTitle}" Text="ALSO THIS SESSION"/>
              </Grid>
              <StackPanel x:Name="ExtrasBody" Margin="20,0,20,16">
                <WrapPanel x:Name="ExtraChips"/>
                <!-- the open chip's table, in place, under a gold rule on its left -->
                <Border x:Name="InPlace" BorderBrush="#80F8D598" BorderThickness="2,0,0,0" Padding="12,0,0,0" Margin="0,4,0,0" Visibility="Collapsed">
                  <StackPanel>
                    <Grid x:Name="InPlaceHead" Height="24">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="72"/><ColumnDefinition Width="80"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                      <TextBlock x:Name="InPlaceH1" Grid.Column="2" Style="{StaticResource FTh}"/>
                      <TextBlock x:Name="InPlaceH2" Grid.Column="3" Style="{StaticResource FTh}"/>
                      <TextBlock x:Name="InPlaceH3" Grid.Column="4" Style="{StaticResource FTh}"/>
                    </Grid>
                    <TextBlock x:Name="InPlaceLead" FontSize="12" Foreground="{DynamicResource Faint}" Margin="0,4,0,4" TextWrapping="Wrap" Visibility="Collapsed"/>
                    <ItemsControl x:Name="GatherRows" ItemTemplate="{StaticResource SmallRowTemplate}"/>
                    <ItemsControl x:Name="MobRows" ItemTemplate="{StaticResource SmallRowTemplate}"/>
                    <ItemsControl x:Name="PetRows" ItemTemplate="{StaticResource SmallRowTemplate}"/>
                    <StackPanel x:Name="SkillLines"/>
                    <TextBlock x:Name="InPlaceNote" FontSize="12" Foreground="{DynamicResource Faint}" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                    <TextBlock x:Name="InPlaceMore" FontSize="12" Margin="0,8,0,0" Visibility="Collapsed"><Hyperlink x:Name="InPlaceMoreLink" Style="{StaticResource LinkStyle}"><Run x:Name="InPlaceMoreRun" Text="Show all"/></Hyperlink></TextBlock>
                    <!-- the enemy pictures are MetaBot.GG's copies of the game portraits; its terms ask for a link back -->
                    <TextBlock x:Name="MobCredit" FontSize="11" Foreground="{DynamicResource Faint}" Margin="0,6,0,0" Visibility="Collapsed">
                      <Run Text="Enemy pictures from "/><Hyperlink x:Name="MobCreditLink" Style="{StaticResource LinkStyle}">MetaBot.GG</Hyperlink>
                    </TextBlock>
                  </StackPanel>
                </Border>
              </StackPanel>
            </StackPanel>
          </Border>

          <TextBlock x:Name="TableNote" Style="{StaticResource BodyStyle}" Foreground="{DynamicResource Faint}" FontSize="11.5" Margin="20,0,20,12" TextWrapping="Wrap" Visibility="Collapsed"/>
        </StackPanel>
      </Border>
      <!-- Expeditions and events: their own part of the window, never on the Farming page (Steven, 2026-10-22). One card per
           place (Ui/MainWindow.RunsCard.cs, the approved mock of 2026-10-24): its runs and what they paid; the runs stay until cleared. -->
      <Border x:Name="EventsCard" Margin="0,16,0,0" Visibility="Collapsed">
        <StackPanel>
          <Grid Margin="2,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock FontFamily="{DynamicResource DisplayFont}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" VerticalAlignment="Center" Text="Expeditions and events"/>
            <TextBlock x:Name="InstWhat" Grid.Column="1" Foreground="{DynamicResource Faint}" FontSize="12" VerticalAlignment="Center" Margin="10,2,0,0" TextTrimming="CharacterEllipsis"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
              <!-- this session's runs by default, or with the ones kept on this PC from earlier (Steven, 2026-10-22); a switch
                   and a button, not small links (Steven, 2026-10-23: "more prevalent") -->
              <Border x:Name="InstScope" Padding="3" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource LineStrong}" Background="#08FFFFFF" VerticalAlignment="Center" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                  <Button x:Name="InstSessionBtn" Style="{StaticResource SegOn}" Content="This session" Height="26" FontSize="12.5" Padding="10,0" ToolTip="Only the runs since the tracker started"/>
                  <Button x:Name="InstEarlierBtn" Style="{StaticResource SegOff}" Content="Earlier" Height="26" FontSize="12.5" Padding="10,0" Margin="2,0,0,0" ToolTip="Every run kept on this PC, earlier ones too"/>
                </StackPanel>
              </Border>
              <Button x:Name="InstClearBtn" Content="Clear" Height="32" FontSize="12.5" Padding="14,0" Margin="10,0,0,0" VerticalAlignment="Center" ToolTip="Clear the runs shown here"/>
            </StackPanel>
          </Grid>
          <!-- the live card: the last run steps and reward lines beside the rate across runs (Ui/MainWindow.Live.cs) -->
          <StackPanel x:Name="EventsLiveHost"/>
          <StackPanel x:Name="InstHost"/>
          <Border x:Name="InstEmpty" Style="{StaticResource CardStyle}" Padding="20,22,20,22">
            <TextBlock Style="{StaticResource BodyStyle}" FontSize="12.5" Foreground="{DynamicResource Faint}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="440"
                       Text="Run an expedition or join an event. Each one shows here with how long it took and what it paid."/>
          </Border>
        </StackPanel>
      </Border>

      <!-- Crafting (direction C, 2026-10-24): the last five crafts beside the session's profit, then This session (every recipe
           crafted since the tracker started: tries, worked, spent, sells for, profit) and Best crafts today. Crafted items never
           count as drops, and crafting is never farming time. -->
      <Border x:Name="CraftCard" Margin="0,16,0,0" BorderThickness="1" CornerRadius="6,6,0,0" BorderBrush="{DynamicResource LineStrong}" Background="{DynamicResource Card}" Visibility="Collapsed">
        <StackPanel>
          <Grid Margin="20,16,20,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border Width="40" Height="40" CornerRadius="7" BorderThickness="1" BorderBrush="{DynamicResource Gold}" VerticalAlignment="Center">
              <Border.Background>
                <RadialGradientBrush Center="0.5,0.38" GradientOrigin="0.5,0.38" RadiusX="0.75" RadiusY="0.75"><GradientStop Color="#4DF8D598" Offset="0"/><GradientStop Color="{DynamicResource SlotColor}" Offset="1"/></RadialGradientBrush>
              </Border.Background>
              <!-- an anvil, drawn -->
              <Viewbox Width="22" Height="22">
                <Canvas Width="24" Height="24">
                  <Path Stroke="{DynamicResource Muted}" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                        Data="M3,7 H15 C15,10 17,11 21,11 V13 C17,13 15,14 14,16 H9 C8,14 6,12.5 3,12 Z M8,16 L6.5,20 H16.5 L15,16"/>
                </Canvas>
              </Viewbox>
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
              <TextBlock FontFamily="{DynamicResource DisplayFont}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Gold}" Text="Crafting"/>
              <TextBlock FontSize="12.5" Foreground="{DynamicResource Muted}" Margin="0,2,0,0" Text="Since the tracker started"/>
            </StackPanel>
            <TextBlock x:Name="CraftResetText" Grid.Column="2" FontSize="12" VerticalAlignment="Top"><Hyperlink x:Name="CraftResetLink" Style="{StaticResource LinkStyle}">Start over</Hyperlink></TextBlock>
          </Grid>
          <Grid Margin="20,16,20,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
            <StackPanel>
              <Border CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource Line}" Background="{DynamicResource Slot}" Padding="0,4" ClipToBounds="True">
                <Grid>
                  <StackPanel x:Name="CraftFeedHost"/>
                  <TextBlock x:Name="CraftEmpty" Style="{StaticResource BodyStyle}" FontSize="12.5" Foreground="{DynamicResource Faint}" Margin="12,10,12,10" TextWrapping="Wrap"
                             Text="Craft something in the game. Each craft shows here as the crafting panel finishes it."/>
                </Grid>
              </Border>
              <TextBlock x:Name="CraftHint" FontSize="11.5" Foreground="{DynamicResource Faint}" Margin="0,8,0,0" Background="Transparent" Cursor="Hand" HorizontalAlignment="Left"
                         Text="A craft wrong or missing? Tap it." ToolTip="Tap a wrong craft to report it, or here for one that never showed. The report is saved on this PC."/>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock x:Name="CraftProfit" FontFamily="{DynamicResource DisplayFont}" FontSize="34" FontWeight="Light" Foreground="{DynamicResource Ink}" Text=" "/>
              <TextBlock x:Name="CraftProfitNote" FontSize="12.5" Foreground="{DynamicResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap" Text="profit this session"/>
              <TextBlock x:Name="CraftWhat" FontSize="12.5" Foreground="{DynamicResource Muted}" Margin="0,12,0,0" LineHeight="21" TextWrapping="Wrap"/>
              <StackPanel x:Name="CraftHealth" Orientation="Horizontal" Margin="0,12,0,0">
                <Path Width="13" Height="13" Stretch="Uniform" Stroke="{DynamicResource Gold}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M3.5,8.5 L6.5,11.5 L12.5,4.5" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="CraftHealthText" FontSize="12" Foreground="{DynamicResource Faint}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="180"/>
              </StackPanel>
            </StackPanel>
          </Grid>

          <!-- This session: every recipe crafted, in the drops table's grammar; a row opens its recipe card -->
          <Border x:Name="CraftHead" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
            <StackPanel>
              <Grid x:Name="CraftSessionHead" Height="48" Background="Transparent" Cursor="Hand">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Path x:Name="CraftSessionChev" Style="{StaticResource SecChev}" Margin="20,0,10,0"/>
                <TextBlock Grid.Column="1" Style="{StaticResource SecTitle}" Text="THIS SESSION"/>
                <TextBlock x:Name="CraftSpentNote" Grid.Column="2" Style="{StaticResource SecNote}"/>
                <TextBlock x:Name="CraftSpent" Grid.Column="3" Style="{StaticResource SecSum}" FontSize="14" Margin="12,0,20,0"/>
              </Grid>
              <StackPanel x:Name="CraftBody" Margin="20,0,20,16">
                <Grid Height="24">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/><ColumnDefinition Width="58"/><ColumnDefinition Width="64"/><ColumnDefinition Width="72"/><ColumnDefinition Width="72"/></Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="2" Style="{StaticResource FTh}" Text="Tries"/>
                  <TextBlock Grid.Column="3" Style="{StaticResource FTh}" Text="Worked"/>
                  <TextBlock Grid.Column="4" Style="{StaticResource FTh}" Text="Spent" ToolTip="Every try's materials at the lowest Market prices on your server. A failed try uses them too."/>
                  <TextBlock Grid.Column="5" Style="{StaticResource FTh}" Text="Sells for" ToolTip="What came out, at the lowest Market price, after the Market's fee and tax."/>
                  <TextBlock Grid.Column="6" Style="{StaticResource FTh}" Text="Profit" ToolTip="What came out, after the Market's cut, minus the cost of every try."/>
                </Grid>
                <ScrollViewer x:Name="CraftScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <ItemsControl x:Name="CraftRows" ItemTemplate="{StaticResource CraftRowTemplate}"/>
                </ScrollViewer>
                <TextBlock x:Name="CraftMadeNote" FontSize="12" Foreground="{DynamicResource Faint}" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- the server's most profitable recipes today (kinahledger.com /crafts), folded to the top three (Steven, 2026-10-24) -->
          <Border x:Name="BestCraftsCard" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Visibility="Collapsed">
            <StackPanel>
              <Grid x:Name="BestHead" Height="48" Background="Transparent" Cursor="Hand">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Path x:Name="BestChev" Style="{StaticResource SecChev}" Margin="20,0,10,0"/>
                <TextBlock Grid.Column="1" Style="{StaticResource SecTitle}" Text="BEST CRAFTS TODAY"/>
                <TextBlock x:Name="BestNote" Grid.Column="2" Style="{StaticResource SecNote}"/>
              </Grid>
              <StackPanel x:Name="BestCraftsHost" Margin="20,0,20,16"/>
            </StackPanel>
          </Border>

          <!-- the recipes come from MetaBot.GG, whose terms ask for a link to the page they came from -->
          <TextBlock x:Name="CraftCredit" Foreground="{DynamicResource Faint}" FontSize="11.5" Margin="20,0,20,12" TextWrapping="Wrap">
            <Run x:Name="CraftNote" Text="Lowest Market price on your server"/><Run Text="  ·  recipes from "/><Hyperlink x:Name="CraftCreditLink" Style="{StaticResource LinkStyle}">MetaBot.GG</Hyperlink>
          </TextBlock>
        </StackPanel>
      </Border>
      </StackPanel>
    </ScrollViewer>

    </Grid>

    </Grid>
  </Border>
</Window>
