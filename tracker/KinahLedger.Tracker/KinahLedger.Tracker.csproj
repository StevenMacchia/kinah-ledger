<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- a window app: double-click opens the tracker. Command-line modes still work (they attach to the terminal). -->
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 1903+ target gives access to the built-in text recognition (Windows.Media.Ocr) -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <!-- WPF draws the window; Windows Forms is kept only for the tray icon and screen capture types -->
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <StartupObject>KinahLedger.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- the K tile, built by tools/brand/make-icons.js: the exe's icon in Explorer, and embedded below for the window and tray -->
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- full globalization: WPF text input asks for the keyboard's culture (1033), which invariant mode refuses -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <AssemblyName>KinahLedger</AssemblyName>
    <RootNamespace>KinahLedger</RootNamespace>
    <Version>0.8.30</Version>
    <AssemblyTitle>Kinah Ledger</AssemblyTitle>
    <Product>Kinah Ledger</Product>
    <Company>Kinah Ledger</Company>
    <Description>Unofficial Aion 2 farming tracker: Kinah and loot per hour, read from the game's chat.</Description>
    <!-- Properties shows the plain version, not "<version>+<commit hash>" -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Copyright>© 2026 Kinah Ledger authors · MIT License · kinahledger.com</Copyright>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <!-- one downloadable exe with the runtime inside: nothing for players to install -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <!-- the two UI frameworks share many type names; each file imports what it needs instead -->
    <Using Remove="System.Windows" />
    <Using Remove="System.Windows.Controls" />
    <Using Remove="System.Windows.Data" />
    <Using Remove="System.Windows.Documents" />
    <Using Remove="System.Windows.Input" />
    <Using Remove="System.Windows.Media" />
    <Using Remove="System.Windows.Media.Imaging" />
    <Using Remove="System.Windows.Navigation" />
    <Using Remove="System.Windows.Shapes" />
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!-- no capture driver and no network library: the tracker only reads the screen. Velopack installs updates; ONNX Runtime runs the name decoder -->

  <ItemGroup>
    <!-- the window and tray take their sizes from this copy of the exe's icon (Ui/Native.cs) -->
    <EmbeddedResource Include="app.ico" LogicalName="app.ico" />
    <None Update="settings.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- the 46 gathering materials' icon file names (8 KB), so their icons work before any item list is downloaded -->
    <EmbeddedResource Include="..\..\data\gathering-items.json" LogicalName="gathering-items.json" />
    <!-- the game's item list (the crawler's output, 6,324 items): the whitelist for drops, so a misread name can never become one -->
    <EmbeddedResource Include="..\..\data\tw-items.json" LogicalName="tw-items.json" />
    <!-- zone and area names as the minimap prints them: the whitelist for zones -->
    <EmbeddedResource Include="..\..\data\zones.txt" LogicalName="zones.txt" />
    <!-- dungeons, trials, arenas and event areas, with the kind a run spent in one is filed under -->
    <EmbeddedResource Include="..\..\data\instances.txt" LogicalName="instances.txt" />
    <!-- enemy names as the target bar prints them: the whitelist for Kinah by enemy -->
    <EmbeddedResource Include="..\..\data\mobs.txt" LogicalName="mobs.txt" Condition="Exists('..\..\data\mobs.txt')" />
    <!-- crafting recipes from MetaBot.GG: materials per try, for the cost and profit of a craft -->
    <EmbeddedResource Include="..\..\data\recipes.json" LogicalName="recipes.json" Condition="Exists('..\..\data\recipes.json')" />
    <!-- each enemy picture link (MetaBot.GG copies of the game portraits), for the rows of Kinah by enemy -->
    <EmbeddedResource Include="..\..\data\mob-images.json" LogicalName="mob-images.json" Condition="Exists('..\..\data\mob-images.json')" />
    <!-- each enemy's loot table (MetaBot.GG): odds per kill of an enemy that can drop the item -->
    <EmbeddedResource Include="..\..\data\loot-tables.json" LogicalName="loot-tables.json" Condition="Exists('..\..\data\loot-tables.json')" />
    <EmbeddedResource Include="..\..\data\skins.json" LogicalName="skins.json" Condition="Exists('..\..\data\skins.json')" />
    <EmbeddedResource Include="..\..\data\icon-index.bin" LogicalName="icon-index.bin" Condition="Exists('..\..\data\icon-index.bin')" />
    <EmbeddedResource Include="..\..\data\extra-items.json" LogicalName="extra-items.json" Condition="Exists('..\..\data\extra-items.json')" />
    <!-- crowd-learned misread fixes (kinahledger.com/v1/aliases.json via tools/data/aliases.js), updated daily like the lists above -->
    <EmbeddedResource Include="..\..\data\aliases.json" LogicalName="aliases.json" Condition="Exists('..\..\data\aliases.json')" />
    <!-- what NPCs charge for the "(Bound)" vendor materials recipes use, so a recipe gets a full cost with nothing typed -->
    <EmbeddedResource Include="..\..\data\vendor-prices.json" LogicalName="vendor-prices.json" Condition="Exists('..\..\data\vendor-prices.json')" />
    <!-- the name decoder's model files by URL and SHA-256 (Ocr/NameDecoder.cs); the files are fetched by tools/data/models.js, never built in -->
    <EmbeddedResource Include="..\..\data\models.json" LogicalName="models.json" />
    <!-- anchor templates for the layout (Ocr/Anchors.cs): NAME.png with NAME.json; the folder may be empty -->
    <EmbeddedResource Include="..\..\data\anchors\*.png;..\..\data\anchors\*.json" LogicalName="anchors/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.161" />
    <!-- the item-name decoder's recogniser (Ocr/NameDecoder.cs), CPU only; the model itself is not shipped: tools/data/models.js -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
  </ItemGroup>

</Project>
